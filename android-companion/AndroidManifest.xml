<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thorium.preview"
    android:versionCode="85"
    android:versionName="3.2.11">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 10+ otherwise blocks a foreground service from restoring the
         secondary-display player after another lower-screen task covers it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="Lucent"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreviewActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:taskAffinity="com.thorium.preview.preview"
            android:exported="false" />

        <!-- Lucent's own content-URI trampoline for scoped-storage external
             emulators. Non-exported so only Lucent's own uid (Pegasus's
             in-process am start) can reach it; it carries no launcher/home
             category and is not an emulator. -->
        <activity
            android:name=".RomLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- Lucent's in-app browser is a lower-display companion window on the
             Thor. Its own taskAffinity keeps it in a separate task so it
             stacks above the resident preview surface instead of replacing it
             (and so the launch display id is honoured), singleTask reuses the
             one window, and excludeFromRecents stops it appearing as a second
             Lucent entry. Non-exported with no launcher category: only
             Lucent's own /browser/open opens it. -->
        <activity
            android:name=".BrowserActivity"
            android:configChanges="density|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="com.thorium.preview.browser"
            android:exported="false" />

        <service
            android:name=".PreviewService"
            android:exported="false" />

        <provider
            android:name=".UpdateFileProvider"
            android:authorities="com.thorium.preview.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".RomFileProvider"
            android:authorities="com.thorium.preview.roms"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
