@@ -0,0 +1,74 @@
+#pragma once
+// EmuFusion Widescreen Hack: per-game state set by the recipe through core options.
+// emufusion_ws_width  total picture width in pixels (0 = original 256)
+// emufusion_ws_scene  when to widen: OR of AND terms, "7E0100=14,7E0D9B!=1|bgmode=7"
+//                     (a term may mask, 7E0100/F0=10); empty = bsnes-hd's own wsMode
+// emufusion_ws_hud    moves a HUD out to the new edges: "layer:y0-y1:x0-x1:dir[:t0-t1];..."
+//                     layer bg1..bg4 or obj, dir -1 left or +1 right, t0-t1 sprite tiles
+// emufusion_ws_bounds the world's limits, "7E00E2:7E0604,7E0606+100": the camera's left edge,
+//                     then the left and right world edges, 16-bit RAM values with a hex offset;
+//                     wide areas outside them are black, as they would be on any fixed screen
+// emufusion_ws_map    the game keeps its whole map in RAM: draw wide areas straight from it, so
+//                     they are right everywhere, in every direction, from the first frame.
+//                     Names a decoder written for that game's engine, "ff6"
+// emufusion_ws_strict layers whose wide areas show only tiles written for that world
+//                     position, "bg1,bg2": no stale or wrapped tilemap, never-loaded VRAM;
+//                     with "center", a tile loaded during forced blank counts only near the
+//                     original screen, for games that keep other data beside the tilemap
+// emufusion_ws_unmask "on": the game masks its first and last eight columns to hide scrolling; in a wide
+//                     scene that would be a band between the old picture and the new columns
+// emufusion_ws_gate   "scroll", for games nobody has played through: the wide areas stay closed
+//                     until the scene has scrolled far enough to fill them, and close again on
+//                     a cut or a blank screen, so titles and menus keep their bars
+namespace EfWide {
+  enum : int { MaxRules = 48, MaxTerms = 48 };
+  struct Rule { int layer, y0, y1, x0, x1, dir, tile0, tile1; };
+  struct Term { int group, kind; unsigned addr, mask, value; bool negate; };
+
+  extern int ext;          // pixels added per side, -1 = bsnes-hd's own setting
+  extern Rule rules[MaxRules];
+  extern int ruleCount;
+  extern Term terms[MaxTerms];
+  extern int termCount;
+  extern bool sceneWide;
+  extern bool scrollGate;
+  extern bool edgeUnmask;
+  extern const unsigned char *wram;
+  extern int strictLayers;  // bit per BG layer
+  enum : unsigned short { TagNever = 0xffff, TagBlank = 0xfffe };
+  extern unsigned short tags[0x10000];
+  extern bool blankPending;
+  extern bool blankCenterOnly;
+  extern bool centerOnly;  // the next sweep trusts only cells on the original screen
+
+  void setWidth(const char *value);
+  void setGate(const char *value);
+  void gateFrame(const unsigned *scroll, const bool *enabled, bool blank);
+  void setScene(const char *value);
+  void setHud(const char *value);
+  // The cartridge's battery RAM and the console's work RAM, for the host's saves and tools.
+  void *saveRamData();
+  unsigned long saveRamSize();
+  void *systemRamData();
+  void setStrict(const char *value);
+  void setMap(const char *value);
+  // The tilemap word for this cell of a layer, or -1 when this game has no decoder for it.
+  // tileX, tileY: 8x8 cells from the top-left cell the screen shows, may be negative.
+  enum : int { MapNothing = -2 };
+  int mapCell(int layer, int cellX, int cellY);
+  // A reader placing cells from the picture's scroll, and checked against the tile map as it draws.
+  bool mapSelfChecks();
+  int mapCellAt(unsigned hscroll, unsigned vscroll, int x, int y, bool checked);
+  void mapCheck(bool same);
+  extern int mapGame;
+  extern bool sideBackdropBlack;
+  void setBand(const char *value);
+  bool bandRow(int row);
+  void setBounds(const char *value);
+  bool outside(int x);
+  extern bool bounded;
+  void forgetTags();
+  void evaluate(int bgMode, bool mode7);
+  bool anyRule(int layer, int y);
+  int moved(int layer, int y, int x, int tile, int amount);
+}
