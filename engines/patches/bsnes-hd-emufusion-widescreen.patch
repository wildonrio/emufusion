+  static int mapCellCT(int layer, int cellX, int cellY) {
+    if(layer > 1 || !wram) return -1;
+    auto word = [](unsigned address) { return wram[address] | wram[address + 1] << 8; };
+    int tileX = ((word(0x20 + layer * 2) >> 4) + (cellX >> 1) + 96) % 96;
+    int tileY = ((word(0x26 + layer * 2) >> 4) + (cellY >> 1) + 64) % 64;
+    unsigned id = wram[0x4000 + layer * 0x1800 + tileY * 96 + tileX];
+    return word(0x3000 + layer * 0x800 + id * 8 + ((cellX & 1) ? 2 : 0) + ((cellY & 1) ? 4 : 0));
