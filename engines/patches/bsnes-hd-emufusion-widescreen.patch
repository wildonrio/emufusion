diff --git a/bsnes/sfc/ppu-fast/efwide.cpp b/bsnes/sfc/ppu-fast/efwide.cpp
new file mode 100644
index 0000000..e60042f
--- /dev/null
+++ b/bsnes/sfc/ppu-fast/efwide.cpp
@@ -0,0 +1,116 @@
+#include <emulator/efwide.hpp>
+#include <cstdlib>
+#include <cstring>
+
+namespace EfWide {
+  int ext = -1;
+  Rule rules[MaxRules];
+  int ruleCount = 0;
+  Term terms[MaxTerms];
+  int termCount = 0;
+  bool sceneWide = true;
+  const unsigned char *wram = nullptr;
+
+  void setWidth(const char *value) {
+    if(!value || !*value) { ext = -1; return; }
+    int width = atoi(value);
+    ext = width <= 256 ? 0 : (width - 256) / 2;
+  }
+
+  // Parses one "ADDR[/MASK]=VV", "ADDR[/MASK]!=VV", "bgmode=N" or "bgmode!=N" term.
+  static bool parseTerm(const char *text, Term &term) {
+    const char *equals = strchr(text, '=');
+    if(!equals || equals == text) return false;
+    term.negate = equals[-1] == '!';
+    term.mask = 0xff;
+    if(!strncmp(text, "bgmode", 6)) {
+      term.kind = 1;
+      term.addr = 0;
+    } else {
+      char *end = nullptr;
+      term.kind = 0;
+      term.addr = (unsigned)strtoul(text, &end, 16) & 0x1ffff;
+      if(*end == '/') term.mask = (unsigned)strtoul(end + 1, nullptr, 16);
+    }
+    term.value = (unsigned)strtoul(equals + 1, nullptr, term.kind ? 10 : 16);
+    return true;
+  }
+
+  void setScene(const char *value) {
+    termCount = 0;
+    sceneWide = true;
+    if(!value) return;
+    int group = 0;
+    const char *cursor = value;
+    while(*cursor && termCount < MaxTerms) {
+      char text[32] = {};
+      size_t length = strcspn(cursor, ",|");
+      if(length && length < sizeof(text)) {
+        memcpy(text, cursor, length);
+        Term term = {};
+        if(parseTerm(text, term)) {
+          term.group = group;
+          terms[termCount++] = term;
+        }
+      }
+      if(cursor[length] == '|') group++;
+      cursor += length + (cursor[length] ? 1 : 0);
+    }
+  }
+
+  void setHud(const char *value) {
+    ruleCount = 0;
+    if(!value) return;
+    const char *cursor = value;
+    while(*cursor && ruleCount < MaxRules) {
+      char text[48] = {};
+      size_t length = strcspn(cursor, ";");
+      if(length && length < sizeof(text)) {
+        memcpy(text, cursor, length);
+        Rule rule = {};
+        char layer[8] = {};
+        int dir = 0;
+        rule.tile0 = 0;
+        rule.tile1 = 0x1ff;
+        int fields = sscanf(text, "%7[a-z0-9]:%d-%d:%d-%d:%d:%x-%x", layer, &rule.y0, &rule.y1,
+                            &rule.x0, &rule.x1, &dir, &rule.tile0, &rule.tile1);
+        rule.layer = !strcmp(layer, "obj") ? 4 : (layer[0] == 'b' && layer[1] == 'g' ? layer[2] - '1' : -1);
+        rule.dir = dir;
+        if(fields >= 6 && rule.layer >= 0 && rule.layer <= 4 && dir) rules[ruleCount++] = rule;
+      }
+      cursor += length + (cursor[length] ? 1 : 0);
+    }
+  }
+
+  void evaluate(int bgMode, bool mode7) {
+    if(!termCount || !wram) { sceneWide = true; return; }
+    bool any = false;
+    int index = 0;
+    while(index < termCount && !any) {
+      int group = terms[index].group;
+      bool all = true;
+      for(; index < termCount && terms[index].group == group; index++) {
+        const Term &term = terms[index];
+        unsigned actual = term.kind ? (unsigned)bgMode : (wram[term.addr] & term.mask);
+        all = all && ((actual == term.value) != term.negate);
+      }
+      any = all;
+    }
+    sceneWide = any;
+  }
+
+  bool anyRule(int layer, int y) {
+    for(int i = 0; i < ruleCount; i++)
+      if(rules[i].layer == layer && y >= rules[i].y0 && y <= rules[i].y1) return true;
+    return false;
+  }
+
+  int moved(int layer, int y, int x, int tile, int amount) {
+    for(int i = 0; i < ruleCount; i++) {
+      const Rule &rule = rules[i];
+      if(rule.layer == layer && y >= rule.y0 && y <= rule.y1 && x >= rule.x0 && x <= rule.x1 &&
+         tile >= rule.tile0 && tile <= rule.tile1) return x + rule.dir * amount;
+    }
+    return x;
+  }
+}
