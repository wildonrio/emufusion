+auto PPU::Line::getTileAddress(PPU::IO::Background& self, uint hoffset, uint voffset) -> uint {
+  uint tileX = hoffset >> 3 + self.tileSize;
+  uint tileY = voffset >> 3 + self.tileSize;
+  uint offset = (tileY & 0x1f) << 5 | (tileX & 0x1f);
+  if(tileX & 0x20 && self.screenSize & 1) offset += 32 << 5;
+  if(tileY & 0x20 && self.screenSize & 2) offset += 32 << 5 + (self.screenSize & 1);
+  return ppu.vramExt(self.screenAddress + offset);
+}
