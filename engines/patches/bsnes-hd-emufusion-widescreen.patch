diff --git a/bsnes/sfc/ppu-fast/efwide.cpp b/bsnes/sfc/ppu-fast/efwide.cpp
new file mode 100644
index 0000000..e79e6ff
--- /dev/null
+++ b/bsnes/sfc/ppu-fast/efwide.cpp
@@ -0,0 +1,434 @@
+#include <emulator/efwide.hpp>
+#include <cstdlib>
+#include <cstring>
+
+namespace EfWide {
+  int ext = -1;
+  Rule rules[MaxRules];
+  int ruleCount = 0;
+  Term terms[MaxTerms];
+  int termCount = 0;
+  bool sceneWide = true;
+  const unsigned char *wram = nullptr;
+  int strictLayers = 0;
+  unsigned short tags[0x10000];
+  bool blankPending = false;
+  bool centerOnly = false;
+  bool blankCenterOnly = false;
+  bool bounded = false;
+  static unsigned boundsCamera, boundsLeft, boundsRight;
+  static bool boundsFixed = false;
+  static int offsetLeft, offsetRight;
+  static int camera, edgeLeft, edgeRight;
+  static bool tagsReady = false;
+
+  static SuperFamicom::Memory *saveMemory() {
+    using namespace SuperFamicom;
+    if(cartridge.has.SA1 && sa1.bwram.size()) return &sa1.bwram;
+    if(cartridge.has.SuperFX && superfx.ram.size()) return &superfx.ram;
+    if(cartridge.has.SPC7110 && spc7110.ram.size()) return &spc7110.ram;
+    if(cartridge.has.OBC1 && obc1.ram.size()) return &obc1.ram;
+    if(cartridge.has.HitachiDSP && hitachidsp.ram.size()) return &hitachidsp.ram;
+    return cartridge.ram.size() ? &cartridge.ram : nullptr;
+  }
+
+  void *saveRamData() {
+    auto *memory = saveMemory();
+    return memory ? memory->data() : nullptr;
+  }
+
+  unsigned long saveRamSize() {
+    auto *memory = saveMemory();
+    return memory ? memory->size() : 0;
+  }
+
+  void *systemRamData() { return SuperFamicom::cpu.wram; }
+
+  bool scrollGate = false;
+  bool edgeUnmask = false;
+  bool sideBackdropBlack = false;
+  static int gateTravel = 0, gateBlanked = 0;
+  static unsigned gateLast[4];
+
+  void setGate(const char *value) {
+    scrollGate = value && !strcmp(value, "scroll");
+    gateTravel = 0;
+  }
+
+  void gateFrame(const unsigned *scroll, const bool *enabled, bool blank) {
+    int moved = 0;
+    bool cut = false;
+    for(int layer = 0; layer < 4; layer++) {
+      // The scroll is ten bits: a step across its wrap is still a small one.
+      int step = (int)((scroll[layer] - gateLast[layer] + 512) & 1023) - 512;
+      gateLast[layer] = scroll[layer];
+      if(!enabled[layer]) continue;
+      if(step < 0) step = -step;
+      // A camera that jumps has cut to another scene; one that scrolls moves a few pixels.
+      if(step > 24) cut = true;
+      if(step > moved) moved = step;
+    }
+    gateBlanked = blank ? gateBlanked + 1 : 0;
+    gateTravel = cut || gateBlanked > 2 ? 0 : gateTravel + moved;
+    if(gateTravel < ext + 16) sceneWide = false;
+  }
+
+  void setWidth(const char *value) {
+    if(!value || !*value) { ext = -1; return; }
+    int width = atoi(value);
+    ext = width <= 256 ? 0 : (width - 256) / 2;
+  }
+
+  // Parses one "ADDR[/MASK]=VV", "ADDR[/MASK]!=VV", "bgmode=N" or "bgmode!=N" term.
+  static bool parseTerm(const char *text, Term &term) {
+    const char *equals = strchr(text, '=');
+    if(!equals || equals == text) return false;
+    term.negate = equals[-1] == '!';
+    term.mask = 0xff;
+    if(!strncmp(text, "bgmode", 6)) {
+      term.kind = 1;
+      term.addr = 0;
+    } else {
+      char *end = nullptr;
+      term.kind = 0;
+      term.addr = (unsigned)strtoul(text, &end, 16) & 0x1ffff;
+      if(*end == '/') term.mask = (unsigned)strtoul(end + 1, nullptr, 16);
+    }
+    term.value = (unsigned)strtoul(equals + 1, nullptr, term.kind ? 10 : 16);
+    return true;
+  }
+
+  void setScene(const char *value) {
+    termCount = 0;
+    sceneWide = true;
+    if(!value) return;
+    int group = 0;
+    const char *cursor = value;
+    while(*cursor && termCount < MaxTerms) {
+      char text[32] = {};
+      size_t length = strcspn(cursor, ",|");
+      if(length && length < sizeof(text)) {
+        memcpy(text, cursor, length);
+        Term term = {};
+        if(parseTerm(text, term)) {
+          term.group = group;
+          terms[termCount++] = term;
+        }
+      }
+      if(cursor[length] == '|') group++;
+      cursor += length + (cursor[length] ? 1 : 0);
+    }
+  }
+
+  void setHud(const char *value) {
+    ruleCount = 0;
+    if(!value) return;
+    const char *cursor = value;
+    while(*cursor && ruleCount < MaxRules) {
+      char text[48] = {};
+      size_t length = strcspn(cursor, ";");
+      if(length && length < sizeof(text)) {
+        memcpy(text, cursor, length);
+        Rule rule = {};
+        char layer[8] = {};
+        int dir = 0;
+        rule.tile0 = 0;
+        rule.tile1 = 0x1ff;
+        int fields = sscanf(text, "%7[a-z0-9]:%d-%d:%d-%d:%d:%x-%x", layer, &rule.y0, &rule.y1,
+                            &rule.x0, &rule.x1, &dir, &rule.tile0, &rule.tile1);
+        rule.layer = !strcmp(layer, "obj") ? 4 : (layer[0] == 'b' && layer[1] == 'g' ? layer[2] - '1' : -1);
+        rule.dir = dir;
+        if(fields >= 6 && rule.layer >= 0 && rule.layer <= 4 && dir) rules[ruleCount++] = rule;
+      }
+      cursor += length + (cursor[length] ? 1 : 0);
+    }
+  }
+
+  int mapGame = 0;
+  enum { MapNone = 0, MapFF6 = 1, MapLttP = 2, MapSMW = 3, MapCT = 4, MapYI = 5, MapDKC = 6, MapDKC2 = 7 };
+
+  void setMap(const char *value) {
+    mapGame = !value ? MapNone : !strcmp(value, "ff6") ? MapFF6 : !strcmp(value, "lttp") ? MapLttP : !strcmp(value, "smw") ? MapSMW : !strcmp(value, "ct") ? MapCT : !strcmp(value, "yi") ? MapYI : !strcmp(value, "dkc") ? MapDKC : !strcmp(value, "dkc2") ? MapDKC2 : MapNone;
+  }
+
+  // Super Mario World, horizontal levels: layer 1 is 16x16 tiles, their numbers at 7E:C800 (low)
+  // and 7F:C800 (high), 16 wide by 27 tall per screen. $0FBE gives each number's four 8x8 words in
+  // bank 0D. $1A/$1C are the camera, $5D the number of screens, bit 0 of $5B a vertical level.
+  static int mapCellSMW(int layer, int cellX, int cellY) {
+    if(layer != 0 || !wram || (wram[0x5B] & 1)) return -1;
+    auto word = [](unsigned address) { return wram[address] | wram[address + 1] << 8; };
+    int tileX = (word(0x1A) >> 4) + (cellX >> 1);
+    int tileY = (word(0x1C) >> 4) + (cellY >> 1);
+    int screens = wram[0x5D];
+    if(tileX < 0 || (tileX >> 4) >= screens || tileY < 0 || tileY >= 27) return MapNothing;
+    unsigned index = (tileX >> 4) * 0x1B0 + tileY * 16 + (tileX & 15);
+    unsigned number = wram[0xC800 + index] | wram[0x1C800 + index] << 8;
+    unsigned pointer = word(0x0FBE + (number & 0x3FF) * 2);
+    auto &rom = SuperFamicom::cartridge.rom;
+    unsigned entry = (0x0D << 15 | (pointer & 0x7FFF)) + ((cellX & 1) ? 4 : 0) + ((cellY & 1) ? 2 : 0);
+    if(entry + 1 >= rom.size()) return MapNothing;
+    return rom.data()[entry] | rom.data()[entry + 1] << 8;
+  }
+
+  // Donkey Kong Country's near layer is 32x32 blocks of 4x4 8x8 words. The picture's own scroll places a
+  // cell: the game's camera, which runs a frame ahead of it, only supplies the bits the scroll lacks.
+  static int mapChecked = 0, mapMissed = 0;
+  static bool mapTrusted = false;
+  static int dkc2Layout = 0;
+
+  static int nearCamera(int scroll, int camera, int period) {
+    return scroll + ((camera + period / 2 - scroll) & ~(period - 1));
+  }
+
+  static unsigned dkWord(unsigned bank, unsigned address) {
+    address &= 0xFFFF;
+    if(bank == 0x7E || bank == 0x7F) {
+      unsigned page = (bank & 1) << 16;
+      return wram[page + address] | wram[page + ((address + 1) & 0xFFFF)] << 8;
+    }
+    auto &rom = SuperFamicom::cartridge.rom;
+    unsigned at = (bank & 0x3F) << 16 | address;
+    if(at + 1 >= rom.size()) return 0;
+    return rom.data()[at] | rom.data()[at + 1] << 8;
+  }
+
+  // A map number's bits 14 and 15 flip its whole block; its 16 words run in rows of 4.
+  static int dkCell(unsigned bank, unsigned mapAddress, unsigned table, int tileX, int tileY) {
+    unsigned number = dkWord(bank, mapAddress);
+    int inX = tileX & 3, inY = tileY & 3;
+    if(number & 0x4000) inX = 3 - inX;
+    if(number & 0x8000) inY = 3 - inY;
+    return dkWord(bank, table + (number & 0x3FFF) * 32 + inY * 8 + inX * 2) ^ (number & 0xC000);
+  }
+
+  // 81:8706: 16 numbers a column at [$D3], the blocks at $1B11 in the same bank. $088B/$0895 are the camera,
+  // which 80:9C9D keeps from $1B23 to $1B25.
+  static int dkcCell(unsigned hscroll, unsigned vscroll, int x, int y) {
+    auto word = [](unsigned address) { return wram[address] | wram[address + 1] << 8; };
+    int worldX = nearCamera(hscroll & 1023, word(0x88B), 1024) + x;
+    int worldY = nearCamera(vscroll & 255, word(0x895), 256) + y;
+    if(worldX < word(0x1B23) || worldX >= word(0x1B25) + 0x100) return MapNothing;
+    int tileX = worldX >> 3, tileY = worldY >> 3;
+    return dkCell(wram[0xD5], word(0xD3) + (tileX >> 2) * 32 + ((tileY >> 2) & 15) * 2, word(0x1B11), tileX, tileY);
+  }
+
+  // B5:ACA0 and B5:B100: the map at [$98] and the blocks at $17B4 in the same bank, in work RAM. A level is
+  // 16 numbers a column, or for one that climbs, 16 numbers a row. $17BA/$17C0 are the camera plus 256;
+  // B5:EEB8 keeps the first from 256 to $0AFC.
+  static int dkc2Cell(unsigned hscroll, unsigned vscroll, int x, int y) {
+    auto word = [](unsigned address) { return wram[address] | wram[address + 1] << 8; };
+    int worldX = nearCamera(hscroll & 1023, word(0x17BA), 1024) - 0x100 + x;
+    int worldY = nearCamera(vscroll & 255, word(0x17C0), 256) - 0x100 + y;
+    if(worldX < 0 || worldX >= word(0xAFC) || worldY < 0) return MapNothing;
+    int tileX = worldX >> 3, tileY = worldY >> 3;
+    unsigned offset = dkc2Layout ? (tileX >> 2) * 2 + (tileY >> 2) * 32 : (tileX >> 2) * 32 + ((tileY >> 2) & 15) * 2;
+    return dkCell(wram[0x9A], word(0x98) + offset, word(0x17B4), tileX, tileY);
+  }
+
+  bool mapSelfChecks() { return mapGame == MapDKC || mapGame == MapDKC2; }
+
+  int mapCellAt(unsigned hscroll, unsigned vscroll, int x, int y, bool checked) {
+    if(!wram || (checked && !mapTrusted)) return -1;
+    return mapGame == MapDKC ? dkcCell(hscroll, vscroll, x, y) : dkc2Cell(hscroll, vscroll, x, y);
+  }
+
+  void mapCheck(bool same) {
+    __atomic_add_fetch(&mapChecked, 1, __ATOMIC_RELAXED);
+    if(!same) __atomic_add_fetch(&mapMissed, 1, __ATOMIC_RELAXED);
+  }
+
+  // Yoshi's Island's levels: layer 1 is 16x16 tiles, their numbers at 7F:8000, 256 to a screen in rows of
+  // 16. 7E:0CE1 gives each level position (16 wide, 8 tall) its screen. Each number's four 8x8 words are in
+  // the Super FX ROM: the table at file offset C32A4 has an offset per high byte into the entries at C33F2.
+  // $39/$3B are the camera.
+  static int mapCellYI(int layer, int cellX, int cellY) {
+    if(layer != 0 || !wram) return -1;
+    auto word = [](unsigned address) { return wram[address] | wram[address + 1] << 8; };
+    auto &rom = SuperFamicom::superfx.rom;
+    if(rom.size() < 0xD8000) return -1;
+    int tileX = (word(0x39) >> 4) + (cellX >> 1);
+    int tileY = (word(0x3B) >> 4) + (cellY >> 1);
+    if(tileX < 0 || tileX >= 256 || tileY < 0 || tileY >= 128) return MapNothing;
+    int position = (tileY >> 4) << 4 | tileX >> 4;
+    unsigned screen = wram[0x0CE1 + position];
+    // A position the level does not use reads 0, like its first screen, which screen 1 follows.
+    if(!screen && (position >= 0x7F || wram[0x0CE1 + position + 1] != 1)) return MapNothing;
+    unsigned number = word(0x18000 + screen * 0x200 + ((tileY & 15) * 16 + (tileX & 15)) * 2);
+    auto *data = rom.data();
+    unsigned table = 0xC32A4 + (number >> 8) * 2;
+    unsigned entry = 0xC33F2 + (data[table] | data[table + 1] << 8) + (number & 0xFF) * 8 + ((cellX & 1) ? 2 : 0) + ((cellY & 1) ? 4 : 0);
+    if(entry + 1 >= rom.size()) return MapNothing;
+    return data[entry] | data[entry + 1] << 8;
+  }
+
+  // Chrono Trigger's world map (C2:0776): 96x64 tile ids at 7E:4000 and 7E:5800, each with four
