+	// EmuFusion Widescreen Hack: the filtered picture with the new columns either side of it.
+	PPU* efPpu = _console->GetPpu();
+	if(efPpu && efPpu->EfExt() && frameInfo.Width == 256 && frameInfo.Height <= 240) {
+		static uint32_t wide[(256 + 2 * PPU::EfMaxExt) * 240];
+		int ext = efPpu->EfExt();
+		int width = 256 + 2 * ext;
+		int top = 240 - frameInfo.Height > 0 ? _console->GetSettings()->GetOverscanDimensions().Top : 0;
+		uint32_t* palette = _console->GetSettings()->GetRgbPalette();
+		for(uint32_t y = 0; y < frameInfo.Height; y++) {
+			uint32_t* out = wide + y * width;
+			const uint16_t* left = efPpu->EfLeft(y + top);
+			const uint16_t* right = efPpu->EfRight(y + top);
+			for(int i = 0; i < ext; i++) {
+				out[i] = palette[left[i] & 0x1FF];
+				out[ext + 256 + i] = palette[right[i] & 0x1FF];
+			}
+			memcpy(out + ext, outputBuffer + y * 256, 256 * sizeof(uint32_t));
+			if(efPpu->EfFillClip(y + top)) {
+				for(int i = 0; i < 8; i++) out[ext + i] = palette[left[ext + i] & 0x1FF];
+			}
+		}
+		outputBuffer = wide;
+		frameInfo.Width = width;
+	}
