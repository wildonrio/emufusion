+// Super Mario Bros. 3 keeps its whole level in cartridge RAM: 16 columns and 27 rows of 16-pixel
+// blocks per screen. Each tileset's bank starts with four lists mapping a block to its top left,
+// bottom left, top right and bottom right tiles; a block's palette is its top two bits.
+bool PPU::EfSmb3Tile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	BaseMapper *mapper = _console->GetMapper();
+	const uint8_t *prg = mapper->EfPrg();
+	const uint8_t *wram = mapper->GetWorkRam();
+	if(!_efMapSearched) {
+		// The tileset-to-bank table, wherever this revision of the game keeps it.
+		static const uint8_t needle[] = { 0x0F, 0x15, 0x10, 0x11, 0x13, 0x12, 0x12, 0x12, 0x14, 0x17 };
+		_efMapSearched = true;
+		uint32_t size = mapper->EfPrgSize();
+		for(uint32_t i = 1; prg && i + sizeof(needle) < size; i++) {
+			if(!memcmp(prg + i, needle, sizeof(needle))) {
+				_efTilesetBanks = prg + i - 1;
+				break;
+			}
+		}
+	}
+	if(!_efTilesetBanks || !wram) return false;
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	uint8_t tileset = ram[0x70A];
+	// Nothing lies left of the level's start, and no one can go there: its first column carries on.
+	if(worldX < 0) worldX &= 15;
+	if(worldY < 0 || (worldX >> 8) >= 15 || (worldY >> 4) >= 27 || tileset >= 19) return false;
+	uint8_t block = wram[(worldX >> 8) * 0x1B0 + (worldY >> 4) * 16 + ((worldX >> 4) & 15)];
+	uint32_t list = ((worldY >> 3) & 1) | (((worldX >> 3) & 1) << 1);
+	tile = prg[(uint32_t)_efTilesetBanks[tileset] * 0x2000 + list * 0x100 + block];
+	palette = block >> 6;
+	return true;
+}
+
+// Mega Man 3 and 4 build each stage from its ROM bank: a list of screens by page, 8x8 32-pixel blocks per
+// screen, four 16-pixel blocks in each, then four tile lists and a palette list. Rooms are runs of
+// pages; a run's far side is another room, usually above or below, so its edge carries on instead.
+// Each list is at an offset into the bank; the game keeps which way a room change went in zero page.
+bool PPU::EfMm3Tile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	const uint8_t *prg = _console->GetMapper()->EfPrg();
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	bool four = _efMap == EfMap::Mm4;
+	uint32_t bank = (four ? ram[0x22] | 0x20 : ram[0x22]) * 0x2000;
+	uint32_t screens = four ? 0x1500 : 0xA00, rooms = four ? 0x1530 : 0xA40, layouts = four ? 0x900 : 0xF00;
+	uint32_t blocks = four ? 0x500 : 0x1700, tiles = four ? 0 : 0x1B00, palettes = four ? 0x400 : 0x1F00;
+	uint8_t forward = ram[four ? 0x2F : 0x2E];
+	if(!prg || bank + 0x2000 > _console->GetMapper()->EfPrgSize()) return false;
+	// Between rooms the picture slides over two pages: the one above, then the one below it.
+	if(_efMapRise) {
+		int fresh = ram[0xF9], old = fresh + (forward == 1 ? -1 : 1);
+		bool down = ram[0x23] & 4;
+		int here = (worldY < 240) == down ? old : fresh;
+		if(worldY >= 240) worldY -= 240;
+		worldX += (here - fresh) * 256;
+	} else if(ram[0xFA]) {
+		// The game has already begun a room change that this picture does not show yet.
+		worldX += (forward == 1 ? -256 : 256);
+	}
+	int page = worldX >> 8;
+	if(page < 0) page = 0;
+	int first = 0, last = 0;
+	for(int i = 0; i < 32; i++) {
+		last = first + (prg[bank + rooms + i] & 0x1F);
+		if(page <= last) break;
+		first = last + 1;
+	}
+	if(page > last) return false;
+	int x = worldX & 255;
+	if(worldX < first * 256) { page = first; x = worldX & 15; }
+	else if(worldX >= (last + 1) * 256) { page = last; x = 240 + (worldX & 15); }
+	uint8_t screen = prg[bank + screens + page];
+	uint8_t big = prg[bank + layouts + screen * 0x40 + (worldY >> 5) * 8 + (x >> 5)];
+	uint8_t block = prg[bank + blocks + big * 4 + ((worldY >> 4) & 1) * 2 + ((x >> 4) & 1)];
+	tile = prg[bank + tiles + (((worldY >> 3) & 1) * 2 + ((x >> 3) & 1)) * 0x100 + block];
+	palette = prg[bank + palettes + block] & 3;
+	return true;
+}
+
+// Kirby's Adventure unpacks each room into battery RAM: a list of pages, each 12 rows of 16 blocks,
+// and four tile lists plus a palette list by block. Past the room's sides its edge carries on.
+bool PPU::EfKirbyTile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	const uint8_t *ram = _console->GetMapper()->EfSaveRam();
+	if(!ram || worldY < 0) return false;
+	int width = ram[0x7EE], height = ram[0x7EF];
+	if(!width || !height) return false;
+	int high = worldY / 192, low = worldY % 192;
+	if(high >= height) { high = height - 1; low = 176 + (low & 15); }
+	int x = worldX & 255, across = worldX >> 8;
+	if(worldX < 0) { across = 0; x = worldX & 15; }
+	else if(across >= width) { across = width - 1; x = 240 + (worldX & 15); }
+	int page = ram[0x7F6 + ram[0x76D + high] + across];
+	uint8_t block = ram[0x8C8 + page * 0xC0 + (low >> 4) * 16 + (x >> 4)];
+	tile = ram[0x1A00 + ((low & 8) ? 0x200 : 0) + ((x & 8) ? 0x100 : 0) + block];
+	palette = ram[0x1E00 + block] & 3;
+	return true;
+}
+
+// Ninja Gaiden II lays a stage out as six 32-pixel blocks per column in ROM, and keeps a running
+// pointer to the column it will load next. Blocks hold four 16-pixel blocks, those four tiles.
+bool PPU::EfNg2Tile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	const uint8_t *prg = _console->GetMapper()->EfPrg();
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	if(!prg || worldY < 0 || worldY >= 192) return false;
+	int column = _efMapColumnsAt + ((worldX >> 5) - (ram[0x3A] >> 5)) * 6;
+	if(column < 0x8000 || column >= 0xC000) return false;
+	uint8_t big = prg[column - 0x8000 + (worldY >> 5)];
+	int table = ram[0x69] | ram[0x6A] << 8;
+	int quad = ((worldY >> 4) & 1) * 2 + ((worldX >> 4) & 1);
+	uint8_t block = prg[table - 0x4000 + big * 4 + quad];
+	tile = prg[(ram[0x6B] | ram[0x6C] << 8) - 0x4000 + block * 4 + ((worldY >> 3) & 1) * 2 + ((worldX >> 3) & 1)];
+	palette = (prg[(ram[0x6D] | ram[0x6E] << 8) - 0x4000 + big] >> (quad * 2)) & 3;
+	return true;
+}
+
+// Bionic Commando: a list of screens per area, each 8x8 32-pixel blocks, in ROM banks the game names
+// in zero page. A block holds a tile group for each quarter and its colour byte.
+bool PPU::EfBionicTile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	const uint8_t *prg = _console->GetMapper()->EfPrg();
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	if(!prg || worldY < 0 || worldY >= 240) return false;
+	auto at = [&](uint32_t bank, uint32_t address) { return prg[bank * 0x4000 + ((address - 0x8000) & 0x3FFF)]; };
+	// The game's right-hand column loader says which screen in the list lies where.
+	if(worldX < 0) worldX &= 15;
+	int page = ((_efMapColumnsAt + 4) >> 3) + (worldX >> 8);
+	uint8_t screen = at(2, (ram[0xF0] | ram[0xF1] << 8) + page);
+	uint32_t table = (ram[0xF2] | ram[0xF3] << 8) + screen * 2;
+	uint8_t low = at(0, table), high = at(0, table + 1);
+	uint32_t layout = low | (high & 0xBF) << 8;
+	uint8_t big = at((high >> 6) & 1, layout + (worldY >> 5) * 8 + ((worldX >> 5) & 7));
+	uint32_t info = (ram[0xF4] | ram[0xF5] << 8) + big * 7;
+	uint8_t group = at(ram[0xF6], info + ((worldX >> 4) & 1) * 2 + ((worldY >> 4) & 1));
+	tile = group + ((worldX >> 3) & 1) * 2 + ((worldY >> 3) & 1);
+	palette = (at(ram[0xF6], info + 4) >> ((((worldY >> 4) & 1) * 2 + ((worldX >> 4) & 1)) * 2)) & 3;
+	return true;
+}
+
+// The Legend of Zelda's overworld: a list in battery RAM gives each of 128 screens a layout in ROM bank 5,
+// 16 columns picked from lists of 11 squares of 16 pixels. A square's top bit starts a column, its next bit
+// repeats the square. Secrets already found change a few squares. The screen beside this one is real level.
+void PPU::EfZeldaDecode(int slot, int room, bool found)
+{
+	BaseMapper *mapper = _console->GetMapper();
+	const uint8_t *prg = mapper->EfPrg(), *cart = mapper->EfSaveRam();
+	auto rom = [&](int cpu) { return prg[0x14000 + ((cpu - 0x8000) & 0x3FFF)]; };
+	int layout = (rom(0x9F9C) | rom(0x9F9D) << 8) + (cart[0x9FE + room] & 0x7F) * 16;
+	for(int col = 0; col < 16; col++) {
+		uint8_t pick = rom(layout + col);
+		int at = cart[0x827 + (pick >> 4) * 2] | cart[0x828 + (pick >> 4) * 2] << 8;
+		int count = pick & 15;
+		for(int guard = 0; guard < 0x800; guard++, at++) {
+			if((rom(at) & 0x80) && --count < 0) break;
+		}
+		bool repeated = false;
+		for(int row = 0; row < 11; row++) {
+			uint8_t value = rom(at);
+			int square = value & 0x3F;
+			uint8_t first = rom(0xA97C + square);
+			if(found) {
+				if(first == 0xE7 || first == 0xEA) { square = 0x10; first = 0x70; }
+				else if(first == 0xE6) square = 0x0C;
+			}
+			if(first >= 0xE5 && first <= 0xEA) first = rom(0xA976 + 5 - (0xEA - first));
+			for(int i = 0; i < 4; i++) {
+				_efZeldaTiles[slot][(col * 2 + (i >> 1)) * 22 + row * 2 + (i & 1)] = square >= 0x10 ? first + i : rom(0xA9B4 + square * 4 + i);
+			}
+			if(value & 0x40) {
+				repeated = !repeated;
+				if(repeated) continue;
+			}
+			at++;
+		}
+	}
+	_efZeldaPalettes[slot][0] = cart[0x87E + room] & 3;
+	_efZeldaPalettes[slot][1] = cart[0x8FE + room] & 3;
+	_efZeldaRooms[slot] = room;
+	_efZeldaFound[slot] = found;
+}
+
+bool PPU::EfZeldaTile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	BaseMapper *mapper = _console->GetMapper();
+	const uint8_t *prg = mapper->EfPrg(), *cart = mapper->EfSaveRam();
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	int row = worldY - 64, across = worldX >> 8;
+	// Dungeons and caves have no screen beside them to show.
+	if(!prg || !cart || mapper->EfPrgSize() < 0x18000 || ram[0x10] || _efZeldaShown < 0) return false;
+	if(worldX < 0 || across > 15 || row < 0 || row >= 176) return false;
+	int room = (_efZeldaShown & 0x70) | across, slot = room % 3;
+	int flags = cart[0xBAF] | cart[0xBB0] << 8;
+	bool found = (flags < 0x800 ? ram[(flags + room) & 0x7FF] : cart[(flags + room) & 0x1FFF]) & 0x80;
+	if(_efZeldaRooms[slot] != room || _efZeldaFound[slot] != found) EfZeldaDecode(slot, room, found);
+	int x = (worldX & 255) >> 3, y = row >> 3;
+	tile = _efZeldaTiles[slot][x * 22 + y];
+	// The screen's outer ring and its inside each have their own palette.
+	palette = _efZeldaPalettes[slot][x >= 4 && x < 28 && y >= 4 && y < 18];
+	return true;
+}
+
+// The game names the next screen well before the picture moves, so the picture says which one is showing.
+void PPU::EfZeldaPick()
+{
+	uint8_t here = _console->GetMemoryManager()->GetInternalRAM()[0xEB];
+	BaseMapper *mapper = _console->GetMapper();
+	int page = (_efLineV >> 10) & 1, was = _efZeldaShown;
+	int tries[5] = { here, here - 1, here + 1, here - 16, here + 16 };
+	for(int room : tries) {
+		if(room < 0 || room > 127) continue;
+		_efZeldaShown = room;
+		int hits = 0, total = 0;
+		for(int y = 8; y < 30; y += 3) {
+			for(int x = 4; x < 28; x += 3) {
+				uint8_t tile = 0, palette = 0;
+				total++;
+				if(EfZeldaTile((room & 15) * 256 + x * 8, y * 8, tile, palette) && tile == mapper->DebugReadVRAM(0x2000 | page << 10 | y << 5 | x)) hits++;
+			}
+		}
+		if(hits * 10 >= total * 8) {
+			_efMapMatched = _efMapChecked;
+			return;
+		}
+	}
+	_efZeldaShown = was;
+}
+
+bool PPU::EfMapTile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	switch(_efMap) {
+		case EfMap::Smb3: return EfSmb3Tile(worldX, worldY, tile, palette);
+		case EfMap::Mm3:
+		case EfMap::Mm4: return EfMm3Tile(worldX, worldY, tile, palette);
+		case EfMap::Ng2: return EfNg2Tile(worldX, worldY, tile, palette);
+		case EfMap::Bionic: return EfBionicTile(worldX, worldY, tile, palette);
+		case EfMap::Zelda: return EfZeldaTile(worldX, worldY, tile, palette);
+		default: return EfKirbyTile(worldX, worldY, tile, palette);
+	}
+}
+
+// Where the game says the next picture is, read as it finishes its frame: it may use these bytes
+// for other sums while the picture is being drawn.
+void PPU::EfLatchCamera()
+{
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	switch(_efMap) {
+		case EfMap::Smb3:
+			_efMapCameraX = ram[0xFD] | ram[0x12] << 8;
+			_efMapCameraY = ram[0x543] | ram[0x542] << 8;
+			break;
+		case EfMap::Bionic:
+			_efMapCameraX = ram[0xB7] | ram[0xB8] << 8;
+			_efMapCameraY = ram[0xBA];
+			_efMapColumnsAt = ram[0x98] * 8 + ram[0x99] - (_efMapCameraX >> 5) - 8;
+			break;
+		case EfMap::Kirby:
+			_efMapCameraX = ram[0xDD] | ram[0xDE] << 8;
+			_efMapCameraY = ram[0xE0] + ram[0xE1] * 192;
+			break;
+		default:
+			_efMapCameraX = ram[0xFC] | ram[0xF9] << 8;
+			_efMapCameraY = 0;
+			break;
+	}
+}
+
+void PPU::EfMapCamera(int &cameraX, int &cameraY)
+{
+	if(_efMap == EfMap::Zelda) {
+		// Screens slide past one another: the scroll runs one way or the other, then rests at zero on the next.
+		int scroll = (((_efLineV & 0x1F) - 2) * 8 + _efLineFineX) & 255;
+		if(!scroll && _efZeldaSlide) { _efZeldaShown += _efZeldaSlide; _efZeldaSlide = 0; }
+		else if(scroll && !_efZeldaSlide) _efZeldaSlide = scroll < 128 ? 1 : -1;
+		cameraX = (_efZeldaShown & 15) * 256 + (_efZeldaSlide < 0 ? scroll - 256 : scroll);
+		cameraY = 0;
+		return;
+	}
+	cameraX = _efMapCameraX;
+	cameraY = _efMapCameraY;
+	if(_efMap == EfMap::Mm3 || _efMap == EfMap::Mm4) {
+		_efMapRise = cameraY = ((((_efLineV >> 5) & 0x1F) * 8 + ((_efLineV >> 12) & 7) - _scanline) % 240 + 240) % 240;
+	}
+	if(_efMap == EfMap::Ng2) {
+		// Its scroll changes after the status panel, mid-frame, so it is read as the line starts.
+		// Only the distance from the camera matters: the pointer says where this column is.
+		uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+		cameraX = ram[0x3A];
+		cameraY = ((_efLineV >> 5) & 0x1F) * 8 + ((_efLineV >> 12) & 7) - _scanline;
+		_efMapColumnsAt = (ram[0x86] | ram[0x87] << 8) + ((ram[0x3D] & 0x80) ? 7 : -9) * 6;
+	}
+	// A game that runs late has not moved the picture yet. The scroll registers say where this line is.
+	int shown = (((_efLineV & 0x1F) - 2) * 8 + _efLineFineX) & 255;
+	cameraX += ((shown - cameraX + 128) & 255) - 128;
+}
+
+// Menus, title screens and the like are not on the game's map: the reader would invent a picture
+// beside them. So it draws only while its idea of the middle of the screen is what is really there.
+void PPU::EfCheckMap()
+{
+	int line = _scanline;
+	int step = (_efLineTo - _efLineFrom) / 4, nth = line - _efLineFrom - step / 2;
+	if(nth < 0 || nth % step) return;
+	nth /= step;
+	if(!nth) _efMapChecked = _efMapMatched = 0;
+	int cameraX, cameraY;
+	EfMapCamera(cameraX, cameraY);
+	BaseMapper *mapper = _console->GetMapper();
+	uint16_t v = _efLineV;
+	int startColumn = (v & 0x1F) + ((v >> 10) & 1) * 32 - 2;
+	for(int x = 64; x < 192; x += 16) {
+		int col = (((startColumn + ((x + _efLineFineX) >> 3)) % 64) + 64) % 64;
+		int cell = (((v >> 11) & 1) << 11) | (((col >> 5) & 1) << 10) | (((v >> 5) & 0x1F) << 5) | (col & 0x1F);
+		uint8_t tile = 0, palette = 0;
+		_efMapChecked++;
+		if(EfMapTile(cameraX + x, cameraY + line, tile, palette) && tile == mapper->DebugReadVRAM(0x2000 | cell)) _efMapMatched++;
+	}
+	if(nth == 3) {
+		// Only a picture at rest: the inventory slides down over a map that is still in video memory.
+		int rest = ((((v >> 5) & 0x1F) * 8 + ((v >> 12) & 7) - line) % 240 + 240) % 240;
+		if(_efMap == EfMap::Zelda && !_efZeldaSlide && (rest <= 2 || rest >= 238) && _efMapMatched * 10 < _efMapChecked * 7) EfZeldaPick();
+		// One odd frame is not a menu: a door opening, or a room change about to show.
+		_efMapMisses = _efMapMatched * 10 >= _efMapChecked * 7 ? 0 : _efMapMisses + 1;
+		if(!_efMapMisses) _efMapMatches = true;
+		else if(_efMapMisses >= 3) _efMapMatches = false;
+	}
+}
+
+bool PPU::EfDrawLineMap(int line)
+{
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	// Tileset 0 is the world map and title.
+	if(_efMap == EfMap::Smb3 && ram[0x70A] == 0) return false;
+	BaseMapper *mapper = _console->GetMapper();
+	EfCheckMap();
+	// Side-scrolling levels use a one-screen map ring; a vertical level, the other kind, lays
+	// its map out differently and has no more columns to show.
+	if((_efMap == EfMap::Smb3 && mapper->EfColumns() != 32) || !_efMapMatches) {
+		for(int i = 0; i < _efExt; i++) _efLeft[line][i] = _efRight[line][i] = (uint16_t)0x0F;
+		return true;
+	}
+	bool clip = !_flags.BackgroundMask;
+	_efFillClip[line] = clip;
+	int cameraX, cameraY;
+	EfMapCamera(cameraX, cameraY);
+	for(int side = 0; side < 2; side++) {
+		uint16_t *out = side ? _efRight[line] : _efLeft[line];
+		int lastCell = 0x7FFFFFFF;
+		uint8_t low = 0, high = 0, palette = 0;
+		bool known = false;
+		int count = _efExt + (!side && clip ? 8 : 0);
+		for(int i = 0; i < count; i++) {
+			int x = side ? 256 + i : i - _efExt;
+			int worldX = cameraX + x, worldY = cameraY + line;
+			int cell = worldX >> 3;
+			if(cell != lastCell) {
+				lastCell = cell;
+				uint8_t tile = 0;
+				known = EfMapTile(worldX, worldY, tile, palette);
+				uint16_t pattern = _flags.BackgroundPatternAddr + tile * 16 + (worldY & 7);
+				low = known ? mapper->DebugReadVRAM(pattern) : 0;
+				high = known ? mapper->DebugReadVRAM(pattern + 8) : 0;
+			}
+			int bit = 7 - (worldX & 7);
+			int color = ((low >> bit) & 1) | (((high >> bit) & 1) << 1);
+			out[i] = ((color ? _paletteRAM[(palette << 2) | color] : _paletteRAM[0]) & _paletteRamMask) | _intensifyColorBits;
+		}
+	}
+	return true;
+}
+
+// The line is finished: draw the columns beside it from the same nametables and CHR banks.
+void PPU::EfDrawLine()
+{
+	int line = _scanline;
+	if(line < 0 || line >= 240) return;
+	uint16_t backdrop = (_paletteRAM[0] & _paletteRamMask) | _intensifyColorBits;
+	_efFillClip[line] = false;
+	bool clip = IsRenderingEnabled() && !_flags.BackgroundMask;
+	if(_efHudEdge && IsRenderingEnabled() && (line < _efLineFrom || line >= _efLineTo) && (_efMap == EfMap::None || _efMapMatches)) {
+		// A status panel keeps its place in the middle, its own border carrying on to the sides.
+		uint16_t left = _currentOutputBuffer[line << 8 | (clip ? 8 : 0)], right = _currentOutputBuffer[line << 8 | 255];
+		for(int i = 0; i < _efExt; i++) { _efLeft[line][i] = left; _efRight[line][i] = right; }
+		if(clip) {
+			for(int i = 0; i < 8; i++) _efLeft[line][_efExt + i] = left;
+			_efFillClip[line] = true;
+		}
+		return;
+	}
+	if(!IsRenderingEnabled() || line < _efLineFrom || line >= _efLineTo) {
+		uint16_t fill = line < _efLineFrom || line >= _efLineTo ? (uint16_t)0x0F : backdrop;
+		for(int i = 0; i < _efExt; i++) _efLeft[line][i] = _efRight[line][i] = fill;
+		if(clip) {
+			for(int i = 0; i < 8; i++) _efLeft[line][_efExt + i] = fill;
+			_efFillClip[line] = true;
+		}
+		return;
+	}
+	if(_efMap != EfMap::None && EfDrawLineMap(line)) return;
+	BaseMapper *mapper = _console->GetMapper();
+	int columns = mapper->EfColumns();
+	// A map only one screen wide has nothing more to show: new columns would repeat the far
+	// side of the screen, so this scene stays at the game's own width. For a game nobody has
+	// played through, a scene that has not scrolled is likely a menu and its map holds anything;
+	// and until the scene has scrolled past the new columns, the ones behind it are the last scene's.
+	if(columns <= 32 || (_efScrollGate && _efSceneTravel < _efExt + 16)) {
+		for(int i = 0; i < _efExt; i++) _efLeft[line][i] = _efRight[line][i] = (uint16_t)0x0F;
+		return;
+	}
+	_efFillClip[line] = clip;
+	uint16_t v = _efLineV;
+	int startColumn = (v & 0x1F) + ((v >> 10) & 1) * 32 - 2;
+	int fineY = (v >> 12) & 7;
+	int coarseY = (v >> 5) & 0x1F;
+	int ntY = (v >> 11) & 1;
+	for(int side = 0; side < 2; side++) {
+		uint16_t *out = side ? _efRight[line] : _efLeft[line];
+		int lastColumn = 0x7FFFFFFF;
+		uint8_t low = 0, high = 0, palette = 0;
+		bool hidden = false;
+		int count = _efExt + (!side && clip ? 8 : 0);
+		for(int i = 0; i < count; i++) {
+			int x = side ? 256 + i : i - _efExt;
+			int px = x + _efLineFineX;
+			int column = startColumn + (px >> 3);
+			if(column != lastColumn) {
+				lastColumn = column;
+				int col = ((column % 64) + 64) % 64;
+				int ntX = (col >> 5) & 1;
+				int cell = (ntY << 11) | (ntX << 10) | (coarseY << 5) | (col & 0x1F);
+				hidden = false;
+				if(_efStrict) {
+					int colInMap = ((column % columns) + columns) % columns;
+					uint16_t want = EfWorldFor(colInMap, columns);
+					int distance = (x - 128) < 0 ? 128 - x : x - 128;
+					hidden = _efTags[cell] != want || distance >= columns * 4;
+				}
+				uint16_t ntAddr = 0x2000 | cell;
+				uint8_t tile = mapper->DebugReadVRAM(ntAddr);
+				uint8_t attr = mapper->DebugReadVRAM(0x23C0 | (ntY << 11) | (ntX << 10) | ((coarseY >> 2) << 3) | ((col & 0x1F) >> 2));
+				palette = (attr >> (((coarseY & 2) << 1) | ((col & 0x1F) & 2))) & 3;
+				uint16_t pattern = _flags.BackgroundPatternAddr + tile * 16 + fineY;
+				low = mapper->DebugReadVRAM(pattern);
+				high = mapper->DebugReadVRAM(pattern + 8);
+			}
+			int bit = 7 - (px & 7);
+			int color = hidden ? 0 : ((low >> bit) & 1) | (((high >> bit) & 1) << 1);
+			out[i] = ((color ? _paletteRAM[(palette << 2) | color] : _paletteRAM[0]) & _paletteRamMask) | _intensifyColorBits;
+		}
+	}
+}
