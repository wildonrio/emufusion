+void PPU::EfConfigure(int ext, int lineFrom, int lineTo, bool strict)
+{
+	_efExt = ext > EfMaxExt ? EfMaxExt : (ext < 0 ? 0 : ext);
+	_efLineFrom = lineFrom;
+	_efLineTo = lineTo;
+	_efStrict = strict;
+	memset(_efLeft, 0, sizeof(_efLeft));
+	memset(_efRight, 0, sizeof(_efRight));
+}
+
+// The world column a nametable column now stands for: the one nearest the middle of the screen.
+uint16_t PPU::EfWorldFor(int col, int columns)
+{
+	int center = (_efWorldX + 128) >> 3;
+	int delta = (((col - center + columns / 2) % columns + columns) % columns) - columns / 2;
+	return (uint16_t)((center + delta) & 0x7FFF);
+}
+
+void PPU::EfTagWrite(uint16_t addr)
+{
+	if(addr < 0x2000 || addr >= 0x3000) return;
+	int cell = addr & 0xFFF;
+	if((cell & 0x3FF) >= 0x3C0) return;
+	if(_scanline >= 240 && IsRenderingEnabled() == false) {
+		_efBlankWrites[cell] = true;
+		_efBlankPending = true;
+		return;
+	}
+	if(!IsRenderingEnabled()) {
+		_efBlankWrites[cell] = true;
+		_efBlankPending = true;
+		return;
+	}
+	int col = (cell & 0x1F) + ((cell >> 10) & 1) * 32;
+	int columns = _console->GetMapper()->EfColumns();
+	_efBlankWrites[cell] = false;
+	_efTags[cell] = EfWorldFor(col % columns, columns);
+}
+
+void PPU::EfSweepBlank()
+{
+	_efBlankPending = false;
+	int columns = _console->GetMapper()->EfColumns();
+	for(int cell = 0; cell < 0x1000; cell++) {
+		if(!_efBlankWrites[cell]) continue;
+		_efBlankWrites[cell] = false;
+		int col = (cell & 0x1F) + ((cell >> 10) & 1) * 32;
+		_efTags[cell] = EfWorldFor(col % columns, columns);
+	}
+}
+
+// Super Mario Bros. 3 keeps its whole level in cartridge RAM: 16 columns and 27 rows of 16-pixel
+// blocks per screen. Each tileset's bank starts with four lists mapping a block to its top left,
+// bottom left, top right and bottom right tiles; a block's palette is its top two bits.
+bool PPU::EfSmb3Tile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	BaseMapper *mapper = _console->GetMapper();
+	const uint8_t *prg = mapper->EfPrg();
+	const uint8_t *wram = mapper->GetWorkRam();
+	if(!_efMapSearched) {
+		// The tileset-to-bank table, wherever this revision of the game keeps it.
+		static const uint8_t needle[] = { 0x0F, 0x15, 0x10, 0x11, 0x13, 0x12, 0x12, 0x12, 0x14, 0x17 };
+		_efMapSearched = true;
+		uint32_t size = mapper->EfPrgSize();
+		for(uint32_t i = 1; prg && i + sizeof(needle) < size; i++) {
+			if(!memcmp(prg + i, needle, sizeof(needle))) {
+				_efTilesetBanks = prg + i - 1;
+				break;
+			}
+		}
+	}
+	if(!_efTilesetBanks || !wram) return false;
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	uint8_t tileset = ram[0x70A];
+	// Nothing lies left of the level's start, and no one can go there: its first column carries on.
+	if(worldX < 0) worldX &= 15;
+	if(worldY < 0 || (worldX >> 8) >= 15 || (worldY >> 4) >= 27 || tileset >= 19) return false;
+	uint8_t block = wram[(worldX >> 8) * 0x1B0 + (worldY >> 4) * 16 + ((worldX >> 4) & 15)];
+	uint32_t list = ((worldY >> 3) & 1) | (((worldX >> 3) & 1) << 1);
+	tile = prg[(uint32_t)_efTilesetBanks[tileset] * 0x2000 + list * 0x100 + block];
+	palette = block >> 6;
+	return true;
+}
+
+// Mega Man 3 builds each stage from its ROM bank: a list of screens by page, 8x8 32-pixel blocks per
+// screen, four 16-pixel blocks in each, then four tile lists and a palette list. Rooms are runs of
+// pages; a run's far side is another room, usually above or below, so its edge carries on instead.
+bool PPU::EfMm3Tile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	const uint8_t *prg = _console->GetMapper()->EfPrg();
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	uint32_t bank = ram[0x22] * 0x2000;
+	if(!prg || bank + 0x2000 > _console->GetMapper()->EfPrgSize()) return false;
+	// Between rooms the picture slides over two pages: the one above, then the one below it.
+	if(_efMapRise) {
+		int fresh = ram[0xF9], old = fresh + (ram[0x2E] == 1 ? -1 : 1);
+		bool down = ram[0x23] & 4;
+		int here = (worldY < 240) == down ? old : fresh;
+		if(worldY >= 240) worldY -= 240;
+		worldX += (here - fresh) * 256;
+	} else if(ram[0xFA]) {
+		// The game has already begun a room change that this picture does not show yet.
+		worldX += (ram[0x2E] == 1 ? -256 : 256);
+	}
+	int page = worldX >> 8;
+	if(page < 0) page = 0;
+	int first = 0, last = 0;
+	for(int i = 0; i < 32; i++) {
+		last = first + (prg[bank + 0xA40 + i] & 0x1F);
+		if(page <= last) break;
+		first = last + 1;
+	}
+	if(page > last) return false;
+	int x = worldX & 255;
+	if(worldX < first * 256) { page = first; x = worldX & 15; }
+	else if(worldX >= (last + 1) * 256) { page = last; x = 240 + (worldX & 15); }
+	uint8_t screen = prg[bank + 0xA00 + page];
+	uint8_t big = prg[bank + 0xF00 + screen * 0x40 + (worldY >> 5) * 8 + (x >> 5)];
+	uint8_t block = prg[bank + 0x1700 + big * 4 + ((worldY >> 4) & 1) * 2 + ((x >> 4) & 1)];
+	tile = prg[bank + 0x1B00 + (((worldY >> 3) & 1) * 2 + ((x >> 3) & 1)) * 0x100 + block];
+	palette = prg[bank + 0x1F00 + block] & 3;
+	return true;
+}
+
+// Kirby's Adventure unpacks each room into battery RAM: a list of pages, each 12 rows of 16 blocks,
+// and four tile lists plus a palette list by block. Past the room's sides its edge carries on.
+bool PPU::EfKirbyTile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	const uint8_t *ram = _console->GetMapper()->EfSaveRam();
+	if(!ram || worldY < 0) return false;
+	int width = ram[0x7EE], height = ram[0x7EF];
+	if(!width || !height) return false;
+	int high = worldY / 192, low = worldY % 192;
+	if(high >= height) { high = height - 1; low = 176 + (low & 15); }
+	int x = worldX & 255, across = worldX >> 8;
+	if(worldX < 0) { across = 0; x = worldX & 15; }
+	else if(across >= width) { across = width - 1; x = 240 + (worldX & 15); }
+	int page = ram[0x7F6 + ram[0x76D + high] + across];
+	uint8_t block = ram[0x8C8 + page * 0xC0 + (low >> 4) * 16 + (x >> 4)];
+	tile = ram[0x1A00 + ((low & 8) ? 0x200 : 0) + ((x & 8) ? 0x100 : 0) + block];
+	palette = ram[0x1E00 + block] & 3;
+	return true;
+}
+
+bool PPU::EfMapTile(int worldX, int worldY, uint8_t &tile, uint8_t &palette)
+{
+	switch(_efMap) {
+		case EfMap::Smb3: return EfSmb3Tile(worldX, worldY, tile, palette);
+		case EfMap::Mm3: return EfMm3Tile(worldX, worldY, tile, palette);
+		default: return EfKirbyTile(worldX, worldY, tile, palette);
+	}
+}
+
+// Where the game says the next picture is, read as it finishes its frame: it may use these bytes
+// for other sums while the picture is being drawn.
+void PPU::EfLatchCamera()
+{
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	switch(_efMap) {
+		case EfMap::Smb3:
+			_efMapCameraX = ram[0xFD] | ram[0x12] << 8;
+			_efMapCameraY = ram[0x543] | ram[0x542] << 8;
+			break;
+		case EfMap::Kirby:
+			_efMapCameraX = ram[0xDD] | ram[0xDE] << 8;
+			_efMapCameraY = ram[0xE0] + ram[0xE1] * 192;
+			break;
+		default:
+			_efMapCameraX = ram[0xFC] | ram[0xF9] << 8;
+			_efMapCameraY = 0;
+			break;
+	}
+}
+
+void PPU::EfMapCamera(int &cameraX, int &cameraY)
+{
+	cameraX = _efMapCameraX;
+	cameraY = _efMapCameraY;
+	if(_efMap == EfMap::Mm3) {
+		_efMapRise = cameraY = ((((_efLineV >> 5) & 0x1F) * 8 + ((_efLineV >> 12) & 7) - _scanline) % 240 + 240) % 240;
+	}
+	// A game that runs late has not moved the picture yet. The scroll registers say where this line is.
+	int shown = (((_efLineV & 0x1F) - 2) * 8 + _efLineFineX) & 255;
+	cameraX += ((shown - cameraX + 128) & 255) - 128;
+}
+
+// Menus, title screens and the like are not on the game's map: the reader would invent a picture
+// beside them. So it draws only while its idea of the middle of the screen is what is really there.
+void PPU::EfCheckMap()
+{
+	int line = _scanline;
+	int step = (_efLineTo - _efLineFrom) / 4, nth = line - _efLineFrom - step / 2;
+	if(nth < 0 || nth % step) return;
+	nth /= step;
+	if(!nth) _efMapChecked = _efMapMatched = 0;
+	int cameraX, cameraY;
+	EfMapCamera(cameraX, cameraY);
+	BaseMapper *mapper = _console->GetMapper();
+	uint16_t v = _efLineV;
+	int startColumn = (v & 0x1F) + ((v >> 10) & 1) * 32 - 2;
+	for(int x = 64; x < 192; x += 16) {
+		int col = (((startColumn + ((x + _efLineFineX) >> 3)) % 64) + 64) % 64;
+		int cell = (((v >> 11) & 1) << 11) | (((col >> 5) & 1) << 10) | (((v >> 5) & 0x1F) << 5) | (col & 0x1F);
+		uint8_t tile = 0, palette = 0;
+		_efMapChecked++;
+		if(EfMapTile(cameraX + x, cameraY + line, tile, palette) && tile == mapper->DebugReadVRAM(0x2000 | cell)) _efMapMatched++;
+	}
+	if(nth == 3) {
+		// One odd frame is not a menu: a door opening, or a room change about to show.
+		_efMapMisses = _efMapMatched * 10 >= _efMapChecked * 7 ? 0 : _efMapMisses + 1;
+		if(!_efMapMisses) _efMapMatches = true;
+		else if(_efMapMisses >= 3) _efMapMatches = false;
+	}
+}
+
+bool PPU::EfDrawLineMap(int line)
+{
+	uint8_t *ram = _console->GetMemoryManager()->GetInternalRAM();
+	// Tileset 0 is the world map and title.
+	if(_efMap == EfMap::Smb3 && ram[0x70A] == 0) return false;
+	BaseMapper *mapper = _console->GetMapper();
+	EfCheckMap();
+	// Side-scrolling levels use a one-screen map ring; a vertical level, the other kind, lays
+	// its map out differently and has no more columns to show.
+	if((_efMap == EfMap::Smb3 && mapper->EfColumns() != 32) || !_efMapMatches) {
+		for(int i = 0; i < _efExt; i++) _efLeft[line][i] = _efRight[line][i] = (uint16_t)0x0F;
+		return true;
+	}
+	bool clip = !_flags.BackgroundMask;
+	_efFillClip[line] = clip;
+	int cameraX, cameraY;
+	EfMapCamera(cameraX, cameraY);
+	for(int side = 0; side < 2; side++) {
+		uint16_t *out = side ? _efRight[line] : _efLeft[line];
+		int lastCell = 0x7FFFFFFF;
+		uint8_t low = 0, high = 0, palette = 0;
+		bool known = false;
+		int count = _efExt + (!side && clip ? 8 : 0);
+		for(int i = 0; i < count; i++) {
+			int x = side ? 256 + i : i - _efExt;
+			int worldX = cameraX + x, worldY = cameraY + line;
+			int cell = worldX >> 3;
+			if(cell != lastCell) {
+				lastCell = cell;
+				uint8_t tile = 0;
+				known = EfMapTile(worldX, worldY, tile, palette);
+				uint16_t pattern = _flags.BackgroundPatternAddr + tile * 16 + (worldY & 7);
+				low = known ? mapper->DebugReadVRAM(pattern) : 0;
+				high = known ? mapper->DebugReadVRAM(pattern + 8) : 0;
+			}
+			int bit = 7 - (worldX & 7);
+			int color = ((low >> bit) & 1) | (((high >> bit) & 1) << 1);
+			out[i] = ((color ? _paletteRAM[(palette << 2) | color] : _paletteRAM[0]) & _paletteRamMask) | _intensifyColorBits;
+		}
+	}
+	return true;
+}
+
+// The line is finished: draw the columns beside it from the same nametables and CHR banks.
+void PPU::EfDrawLine()
+{
+	int line = _scanline;
+	if(line < 0 || line >= 240) return;
+	uint16_t backdrop = (_paletteRAM[0] & _paletteRamMask) | _intensifyColorBits;
+	_efFillClip[line] = false;
+	bool clip = IsRenderingEnabled() && !_flags.BackgroundMask;
+	if(_efHudEdge && IsRenderingEnabled() && (line < _efLineFrom || line >= _efLineTo) && (_efMap == EfMap::None || _efMapMatches)) {
+		// A status panel keeps its place in the middle, its own border carrying on to the sides.
+		uint16_t left = _currentOutputBuffer[line << 8 | (clip ? 8 : 0)], right = _currentOutputBuffer[line << 8 | 255];
+		for(int i = 0; i < _efExt; i++) { _efLeft[line][i] = left; _efRight[line][i] = right; }
+		if(clip) {
+			for(int i = 0; i < 8; i++) _efLeft[line][_efExt + i] = left;
+			_efFillClip[line] = true;
+		}
+		return;
+	}
+	if(!IsRenderingEnabled() || line < _efLineFrom || line >= _efLineTo) {
+		uint16_t fill = line < _efLineFrom || line >= _efLineTo ? (uint16_t)0x0F : backdrop;
+		for(int i = 0; i < _efExt; i++) _efLeft[line][i] = _efRight[line][i] = fill;
+		if(clip) {
+			for(int i = 0; i < 8; i++) _efLeft[line][_efExt + i] = fill;
+			_efFillClip[line] = true;
+		}
+		return;
+	}
+	if(_efMap != EfMap::None && EfDrawLineMap(line)) return;
+	BaseMapper *mapper = _console->GetMapper();
+	int columns = mapper->EfColumns();
+	// A map only one screen wide has nothing more to show: new columns would repeat the far
+	// side of the screen, so this scene stays at the game's own width.
+	if(columns <= 32) {
+		for(int i = 0; i < _efExt; i++) _efLeft[line][i] = _efRight[line][i] = (uint16_t)0x0F;
+		return;
+	}
+	_efFillClip[line] = clip;
+	uint16_t v = _efLineV;
+	int startColumn = (v & 0x1F) + ((v >> 10) & 1) * 32 - 2;
+	int fineY = (v >> 12) & 7;
+	int coarseY = (v >> 5) & 0x1F;
+	int ntY = (v >> 11) & 1;
+	for(int side = 0; side < 2; side++) {
+		uint16_t *out = side ? _efRight[line] : _efLeft[line];
+		int lastColumn = 0x7FFFFFFF;
+		uint8_t low = 0, high = 0, palette = 0;
+		bool hidden = false;
+		int count = _efExt + (!side && clip ? 8 : 0);
+		for(int i = 0; i < count; i++) {
+			int x = side ? 256 + i : i - _efExt;
+			int px = x + _efLineFineX;
+			int column = startColumn + (px >> 3);
+			if(column != lastColumn) {
+				lastColumn = column;
+				int col = ((column % 64) + 64) % 64;
+				int ntX = (col >> 5) & 1;
+				int cell = (ntY << 11) | (ntX << 10) | (coarseY << 5) | (col & 0x1F);
+				hidden = false;
+				if(_efStrict) {
+					int colInMap = ((column % columns) + columns) % columns;
+					uint16_t want = EfWorldFor(colInMap, columns);
+					int distance = (x - 128) < 0 ? 128 - x : x - 128;
+					hidden = _efTags[cell] != want || distance >= columns * 4;
+				}
+				uint16_t ntAddr = 0x2000 | cell;
+				uint8_t tile = mapper->DebugReadVRAM(ntAddr);
+				uint8_t attr = mapper->DebugReadVRAM(0x23C0 | (ntY << 11) | (ntX << 10) | ((coarseY >> 2) << 3) | ((col & 0x1F) >> 2));
+				palette = (attr >> (((coarseY & 2) << 1) | ((col & 0x1F) & 2))) & 3;
+				uint16_t pattern = _flags.BackgroundPatternAddr + tile * 16 + fineY;
+				low = mapper->DebugReadVRAM(pattern);
+				high = mapper->DebugReadVRAM(pattern + 8);
+			}
+			int bit = 7 - (px & 7);
+			int color = hidden ? 0 : ((low >> bit) & 1) | (((high >> bit) & 1) << 1);
+			out[i] = ((color ? _paletteRAM[(palette << 2) | color] : _paletteRAM[0]) & _paletteRamMask) | _intensifyColorBits;
+		}
+	}
+}
