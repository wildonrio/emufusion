+			_efLineV = _state.VideoRamAddr;
+			_efLineFineX = _state.XScroll;
+			if(_scanline == 120) {
+				int cam = (((_efLineV & 0x1F) + ((_efLineV >> 10) & 1) * 32 - 2) * 8 + _efLineFineX) & 511;
+				int delta = ((cam - _efCam + 256) & 511) - 256;
+				_efCam = cam;
+				_efWorldX += delta;
+			}
+			if(_scanline == 0 && _efBlankPending && IsRenderingEnabled()) EfSweepBlank();
+		} else if(_cycle == 256) {
+			EfDrawLine();
+		}
+	}
 	if(_cycle <= 256) {
 		LoadTileInfo();
 
@@ -1166,6 +1519,7 @@ void PPU::SendFrame()
 
