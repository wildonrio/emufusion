 	};
 	static_assert(sizeof(MixControl) == 0xE, "sizeof(MixControl)");
 
+	// Guest memory is big-endian; MixControl above is host-side mixer state.
+	// A raw copy turns e.g. pan 0x0051 into 0x5100 on ARM64 and indexes far
+	// outside the 128-entry pan tables (Barbie Dreamhouse Party).
+	struct GuestMixControl
+	{
+		sint16be aux[AX_AUX_BUS_COUNT];
+		sint16be pan;
+		sint16be span;
+		sint16be fader;
+		sint16be lfe;
+
+		MixControl ToHost() const
+		{
+			MixControl result{};
+			for (size_t i = 0; i < AX_AUX_BUS_COUNT; ++i)
+				result.aux[i] = aux[i];
+			result.pan = pan;
+			result.span = span;
+			result.fader = fader;
+			result.lfe = lfe;
+			return result;
+		}
+	};
+	static_assert(sizeof(GuestMixControl) == 0xE, "sizeof(GuestMixControl)");
+
 	using MixMode = uint32_t;
 
