+// EmuFusion (2026-10-23): the in-process frame generator presents from a
+// high-priority GLES context on the same GPU. Cemu saturates the Thor's GPU,
+// and the generator's short per-output work queued behind it, finishing after
+// the compositor's latch, so its queue ran a scan deeper (Super Mario 3D World
+// 26.5 ms to the first generated image against ~20 ms in lighter engines).
+// Cemu's queue asks for low global priority (no privilege needed) so that work
+// runs first; with nothing else on the GPU the priority changes nothing.
+// QA: setprop debug.emufusion.engine_queue_priority default keeps the default.
+static bool EmuFusionLowQueuePriorityRequested()
+{
+#if BOOST_PLAT_ANDROID
+	char value[PROP_VALUE_MAX] = {};
+	if (__system_property_get("debug.emufusion.engine_queue_priority", value) > 0 &&
+		strcmp(value, "default") == 0)
+		return false;
 #endif
+	return true;
+}
 
