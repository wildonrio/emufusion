+++ b/mupen64plus-core/src/device/r4300/new_dynarec/host_memory.h
@@ -0,0 +1,33 @@
+#ifndef M64P_NEW_DYNAREC_HOST_MEMORY_H
+#define M64P_NEW_DYNAREC_HOST_MEMORY_H
+
+#if defined(__ANDROID__)
+#include <stdint.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+/* extra_memory is aligned to a guest-era 4 KiB boundary, not necessarily
+ * an Android host page. Keep its address/layout unchanged (assembly uses
+ * those offsets), but cover whole host pages when changing permissions. */
+static int protect_jit_cache(void *address, size_t length, int protection)
+{
+    const long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) return -1;
+    const uintptr_t start = (uintptr_t)address;
+    const uintptr_t aligned = start - start % (uintptr_t)page_size;
+    const size_t prefix = (size_t)(start - aligned);
+    if (length > SIZE_MAX - prefix) return -1;
+    size_t span = prefix + length;
+    const size_t tail = span % (size_t)page_size;
+    if (tail != 0) {
+        const size_t padding = (size_t)page_size - tail;
+        if (span > SIZE_MAX - padding) return -1;
+        span += padding;
+    }
+    return mprotect((void *)aligned, span, protection);
+}
+#else
+#define protect_jit_cache mprotect
+#endif
+
+#endif
