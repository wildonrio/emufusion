@@ -100,6 +101,13 @@ void CEeExecutor::RemoveExceptionHandler()
 
 #if defined(_WIN32)
 	RemoveVectoredExceptionHandler(m_handler);
+#elif defined(__unix__) || defined(__ANDROID__)
+	if(m_hasPreviousSigSegvAction)
+	{
