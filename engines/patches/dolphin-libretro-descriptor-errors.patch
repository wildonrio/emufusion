+VkDescriptorSet CommandBufferManager::AllocateDescriptorSet(VkDescriptorSetLayout set_layout)
+{
+  FrameResources& resources = GetCurrentFrameResources();
+  bool created_pool = false;
+  for (;;)
+  {
+    if (resources.current_descriptor_pool_index >= resources.descriptor_pools.size())
+    {
+      // A fresh pool that cannot satisfy one set must not recurse forever.
+      if (created_pool)
+        return VK_NULL_HANDLE;
+      VkDescriptorPool pool = CreateDescriptorPool(DESCRIPTOR_SETS_PER_POOL);
+      if (pool == VK_NULL_HANDLE)
+        return VK_NULL_HANDLE;
+      resources.descriptor_pools.push_back(pool);
+      m_descriptor_set_count += DESCRIPTOR_SETS_PER_POOL;
+      created_pool = true;
+    }
+
+    VkDescriptorSet descriptor_set = VK_NULL_HANDLE;
+    VkDescriptorSetAllocateInfo allocate_info = {
+        VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO, nullptr,
+        resources.descriptor_pools[resources.current_descriptor_pool_index], 1, &set_layout};
+    VkResult res =
+        vkAllocateDescriptorSets(g_vulkan_context->GetDevice(), &allocate_info, &descriptor_set);
+    // The result, not an output handle, determines whether allocation succeeded.
+    // Some Android drivers write a non-null handle even on pool exhaustion.
+    if (res == VK_SUCCESS)
+      return descriptor_set;
+    if (res != VK_ERROR_OUT_OF_POOL_MEMORY && res != VK_ERROR_FRAGMENTED_POOL)
+    {
+      LOG_VULKAN_ERROR(res, "vkAllocateDescriptorSets failed: ");
+      return VK_NULL_HANDLE;
+    }
+    ++resources.current_descriptor_pool_index;
+  }
+}
