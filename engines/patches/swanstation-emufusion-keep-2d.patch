+bool GPU_HW::EmufusionNote2D(int32_t span)
+{
+  if (!m_emufusion_keep_2d)
+    return false;
+
+  m_emufusion_other_draws++;
+  if (!m_emufusion_scene_3d)
+    return false;
+
+  // A smaller drawing area is a texture being drawn. A fade or backdrop covers the picture as it is.
+  const int32_t area = static_cast<int32_t>(m_drawing_area.right) - static_cast<int32_t>(m_drawing_area.left) + 1;
+  if (area + 16 < static_cast<int32_t>(m_crtc_state.display_vram_width) || span * 10 >= area * 9)
+    return false;
+
+  // The draw lands away from its own coordinates, which is all the caller tells the dirty rectangle.
+  m_vram_dirty_rect.Include(m_drawing_area.left, m_drawing_area.right + 1u, m_drawing_area.top, m_drawing_area.bottom + 1u);
+  return true;
+}
+
+void GPU_HW::EmufusionNoteBlit(uint32_t width, uint32_t height)
+{
+  if (!m_emufusion_keep_2d)
+    return;
+
+  // Movies and menus reach the screen this way. Textures loading in a 3D scene do not end the scene.
+  m_emufusion_blit_area += width * height;
+  if (m_emufusion_blit_area * 2 >= m_crtc_state.display_vram_width * m_crtc_state.display_vram_height)
+    m_emufusion_other_draws++;
+}
+
+void GPU_HW::EmufusionEndFrame()
+{
+  const float aspect = g_settings.GetDisplayAspectRatioValue();
+  m_emufusion_keep_2d =
+    g_settings.gpu_emufusion_keep_2d && g_settings.gpu_widescreen_hack && g_settings.gpu_pgxp_enable && aspect > 4.0f / 3.0f;
+  if (!m_emufusion_keep_2d)
+  {
+    m_host_display->SetEmufusionPictureWidth(1.0f);
+    return;
+  }
+
+  m_emufusion_scale = (4.0f / 3.0f) / aspect;
+  if (m_emufusion_3d_draws >= EMUFUSION_3D_DRAWS)
+  {
+    m_emufusion_frames_without_3d = 0;
+  }
+  else if (m_emufusion_other_draws > 0 && ++m_emufusion_frames_without_3d >= EMUFUSION_FRAMES_TO_2D)
+  {
+    // Only what was drawn counts: a picture left up while the game loads is still the same scene.
+    m_emufusion_scene_3d = false;
+  }
+  m_emufusion_3d_draws = 0;
+  m_emufusion_other_draws = 0;
+  m_emufusion_blit_area = 0;
+
+  // A movie is 24-bit whatever state the scene before it left.
+  const bool whole_picture_wide = m_emufusion_scene_3d && !m_GPUSTAT.display_area_color_depth_24;
+  m_host_display->SetEmufusionPictureWidth(whole_picture_wide ? 1.0f : m_emufusion_scale);
+}
+
+void GPU_HW::UpdateDisplay()
+{
+  EmufusionEndFrame();
+}
