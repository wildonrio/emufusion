+int OpenFDFileContent(const char*) { return -1; }
+bool CreateDirectoryViaJava(const char*) { return false; }
+bool CreateFileViaJava(const char*) { return false; }
+}
+
+namespace Native
+{
+void onPadRumble(int, int, int) {}
+}
+
+namespace Common
+{
+bool PlaySoundAsync(const char*) { return false; }
+}
