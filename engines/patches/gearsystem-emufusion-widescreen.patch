+// emufusion_ws_scene: when to widen, OR of AND terms of RAM tests, "C200=0C,C201!=1|C300/F0=10".
+struct EfTerm { int group; unsigned addr, mask, value; bool negate; };
+static EfTerm ef_terms[32];
+static int ef_term_count = 0;
+
+static void ef_set_scene(const char* value)
+{
+    ef_term_count = 0;
+    if (!value) return;
+    int group = 0;
+    const char* cursor = value;
+    while (*cursor && ef_term_count < 32)
+    {
+        char text[32] = {0};
+        size_t length = strcspn(cursor, ",|");
+        if (length && length < sizeof(text))
+        {
+            memcpy(text, cursor, length);
+            const char* equals = strchr(text, '=');
+            if (equals && equals != text)
+            {
+                EfTerm& term = ef_terms[ef_term_count++];
+                char* end;
+                term.group = group;
+                term.negate = equals[-1] == '!';
+                term.addr = strtoul(text, &end, 16);
+                term.mask = *end == '/' ? strtoul(end + 1, NULL, 16) : 0xFF;
+                term.value = strtoul(equals + 1, NULL, 16);
+            }
+        }
+        if (cursor[length] == '|') group++;
+        cursor += length + (cursor[length] ? 1 : 0);
+    }
+}
+
+// emufusion_ws_hud: "obj:y0-y1:x0-x1:dir[:t0-t1];..." in VDP coordinates, tiles in hex.
+static void ef_set_hud(GearsystemCore* core, const char* value)
+{
+    Video::WideHudRule rules[16];
+    int count = 0;
+    const char* cursor = value ? value : "";
+    while (*cursor && count < 16)
+    {
+        Video::WideHudRule rule = {0, 0, 0, 0, 0, 0, 255};
+        size_t length = strcspn(cursor, ";");
+        char text[48] = {0};
+        if (length < sizeof(text))
+        {
+            memcpy(text, cursor, length);
+            int fields = sscanf(text, "obj:%d-%d:%d-%d:%d:%x-%x", &rule.y0, &rule.y1, &rule.x0, &rule.x1,
+                                &rule.dir, &rule.t0, &rule.t1);
+            if (fields == 5 || fields == 7)
+                rules[count++] = rule;
+        }
+        cursor += length + (cursor[length] ? 1 : 0);
+    }
+    core->GetVideo()->SetWideHud(rules, count);
+}
+
+// emufusion_ws_gate=scroll, for games nobody has played through: the sides stay black until the scene
+// has scrolled far enough to have filled them, and close when the screen is rebuilt.
+static bool ef_scroll_gate = false;
+static int ef_scene_travel = 0;
+static int ef_frames_display_off = 0;
+static u8 ef_last_scroll = 0;
+
+static bool ef_gate_open(GearsystemCore* core)
+{
+    if (!ef_scroll_gate) return true;
+    const u8* registers = core->GetVideo()->GetRegisters();
+    int step = (s8)(registers[8] - ef_last_scroll);
+    ef_last_scroll = registers[8];
+    // A game may blank the screen for a moment each frame to reach the VDP faster.
+    ef_frames_display_off = (registers[1] & 0x40) ? 0 : ef_frames_display_off + 1;
+    // A scroll that jumps has cut to another scene; one that scrolls moves a few pixels.
+    if (step < -24 || step > 24 || ef_frames_display_off > 2)
+        ef_scene_travel = 0;
+    else
+        ef_scene_travel += step < 0 ? -step : step;
+    return ef_scene_travel >= ef_wide_ext + 16;
+}
+
+static bool ef_scene_wide(GearsystemCore* core)
+{
+    if (!ef_term_count) return true;
+    u8* ram = core->GetMemory()->GetMemoryMap();
+    for (int index = 0; index < ef_term_count;)
+    {
+        int group = ef_terms[index].group;
+        bool all = true;
+        for (; index < ef_term_count && ef_terms[index].group == group; index++)
+        {
+            const EfTerm& term = ef_terms[index];
+            unsigned actual = ram[term.addr & 0xFFFF] & term.mask;
+            all = all && ((actual == term.value) != term.negate);
+        }
+        if (all) return true;
+    }
+    return false;
+}
 static int current_screen_height = 0;
 static float current_aspect_ratio = 0;
 
