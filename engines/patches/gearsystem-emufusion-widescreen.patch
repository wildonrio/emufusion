+// emufusion_ws_patch: "ADDR:OLD>NEW;..." in hex, ROM file offsets: small changes to a game's own map
+// loaders, so they draw as far as the wide picture. Every OLD is checked first and a ROM that differs
+// stays narrow. They stay on while narrow: the old screen is unchanged, and video memory is then
+// already right whenever the picture goes wide.
+static char ef_patch_text[1024];
+static bool ef_patch_refused = false;
+static bool ef_xram_wanted = false;
+extern u8* g_efXram;
+extern int g_efFreeCount;
+extern u16 g_efFree[8][2];
+static u8 ef_xram[256];
+
+static int ef_hex_byte(const char* text)
+{
+    int value = 0;
+    for (int i = 0; i < 2; i++)
+    {
+        char c = text[i];
+        int digit = c >= '0' && c <= '9' ? c - '0' : c >= 'A' && c <= 'F' ? c - 'A' + 10 : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+        if (digit < 0)
+            return -1;
+        value = value * 16 + digit;
+    }
+    return value;
+}
+
+static bool ef_patch_walk(u8* rom, int size, bool write)
+{
+    const char* p = ef_patch_text;
+    while (*p)
+    {
+        char* end;
+        unsigned long addr = strtoul(p, &end, 16);
+        if (end == p || *end != ':')
+            return false;
+        const char* before = end + 1;
+        const char* sep = strchr(before, '>');
+        if (!sep || (sep - before) % 2)
+            return false;
+        int count = (int)(sep - before) / 2;
+        const char* after = sep + 1;
+        if ((int)strlen(after) < count * 2 || (long)addr + count > size)
+            return false;
+        for (int i = 0; i < count; i++)
+        {
+            int old_byte = ef_hex_byte(before + i * 2), new_byte = ef_hex_byte(after + i * 2);
+            if (old_byte < 0 || new_byte < 0 || (rom[addr + i] != old_byte && rom[addr + i] != new_byte))
+                return false;
+        }
+        if (write)
+            for (int i = 0; i < count; i++)
+            {
+                rom[addr + i] = (u8)ef_hex_byte(after + i * 2);
+                // The console's fixed first 1 KB is fetched from the memory map, not the ROM.
+                if (addr + i < 0x400)
+                    core->GetMemory()->Load((u16)(addr + i), rom[addr + i]);
+            }
+        p = after + count * 2;
+        if (*p == ';')
+            p++;
+        else if (*p)
+            return false;
+    }
+    return true;
+}
+
+static void ef_patches_apply(void)
+{
+    u8* rom = core->GetCartridge()->GetROM();
+    int size = core->GetCartridge()->GetROMSize();
+    if (!ef_patch_text[0] || !rom || size <= 0)
+        return;
+    ef_patch_refused = !ef_patch_walk(rom, size, false);
+    if (ef_patch_refused)
+    {
+        core->GetVideo()->SetWideExt(0);
+        ef_wide_ext = 0;
+        g_efXram = NULL;
+        g_efFreeCount = 0;
+        return;
+    }
+    ef_patch_walk(rom, size, true);
+    g_efXram = ef_xram_wanted ? ef_xram : NULL;
+}
