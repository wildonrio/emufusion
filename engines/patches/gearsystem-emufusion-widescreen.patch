+// EmuFusion Widescreen Hack: the Game Gear VDP already draws 256 columns; show more of them.
+void Video::SetWideExt(int ext)
+{
+    if (ext < 0) ext = 0;
+    // The map ring is exactly 256 wide, so a scrolled picture wider than 248 shows one column at
+    // both ends and one copy is wrong. 248 columns never do.
+    if (ext > GS_RESOLUTION_GG_X_OFFSET - 4) ext = GS_RESOLUTION_GG_X_OFFSET - 4;
+    m_iWideExt = ext;
+    if (m_bGameGear && !m_bGameGearSMSMode)
+        m_iScreenWidth = GS_RESOLUTION_GG_WIDTH + 2 * m_iWideExt;
+}
+
+void Video::SetWideBand(int first, int last)
+{
+    m_iWideBandFirst = first;
+    m_iWideBandLast = last;
+}
+
+// Columns the console never showed, closed on this line: a narrow scene, a status panel the map
+// does not extend, and the column the game masks, mirrored so the picture stays centred.
+bool Video::WideColumnClosed(int line, int x)
+{
+    if (x >= GS_RESOLUTION_GG_X_OFFSET && x < GS_RESOLUTION_GG_X_OFFSET + GS_RESOLUTION_GG_WIDTH)
+        return false;
+    return !m_bWideScene || (line >= m_iWideBandFirst && line <= m_iWideBandLast) ||
+        (IsSetBit(m_VdpRegister[0], 5) && (x < 8 || x >= 248));
+}
+
+void Video::SetWideHud(const WideHudRule* rules, int count)
+{
+    m_iWideHudCount = count < 16 ? count : 16;
+    for (int i = 0; i < m_iWideHudCount; i++)
+        m_WideHud[i] = rules[i];
+}
