 {
     struct retro_variable var = {0};
 
+    // EmuFusion Widescreen Hack: target picture aspect x 1000, 0 = the original screen.
+    var.key = "emufusion_ws_bounds";
+    var.value = NULL;
+    ef_set_bounds(environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) ? var.value : NULL);
+    if (!ef_bounds_camera) core->GetVideo()->SetWideWorld(0, 1000);
+
+    var.key = "emufusion_ws_scene";
+    var.value = NULL;
+    ef_set_scene(environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) ? var.value : NULL);
+
+    var.key = "emufusion_ws_gate";
+    var.value = NULL;
+    ef_scroll_gate = environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value && !strcmp(var.value, "scroll");
+    ef_scene_travel = 0;
+
+    var.key = "emufusion_ws_hud";
+    var.value = NULL;
+    ef_set_hud(core, environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) ? var.value : NULL);
+
+    // emufusion_ws_band: "y0-y1" in VDP lines, where the new columns stay black beside a status panel.
+    var.key = "emufusion_ws_band";
+    var.value = NULL;
+    {
+        int first = 1000, last = -1;
+        if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value && sscanf(var.value, "%d-%d", &first, &last) != 2)
+        {
+            first = 1000;
+            last = -1;
+        }
+        core->GetVideo()->SetWideBand(first, last);
+    }
+
+    var.key = "emufusion_ws_aspect";
+    var.value = NULL;
+    {
+        int milli = environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value ? atoi(var.value) : 0;
+        int ext = milli > 1000 ? (milli * GS_RESOLUTION_GG_HEIGHT / 1000 - GS_RESOLUTION_GG_WIDTH) / 2 : 0;
+        // emufusion_ws_maxext: new columns a side, where a game's map only reaches so far.
+        var.key = "emufusion_ws_maxext";
+        var.value = NULL;
+        if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value && atoi(var.value) > 0 && ext > atoi(var.value))
+            ext = atoi(var.value);
+        core->GetVideo()->SetWideExt(ext);
+        ef_wide_ext = core->GetVideo()->GetWideExt();
+    }
+
+    // emufusion_ws_freepc: "A-B;C-D" in hex, processor addresses: lengthened loaders take no console time.
+    var.key = "emufusion_ws_freepc";
+    var.value = NULL;
+    g_efFreeCount = 0;
+    {
+        const char* cursor = environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value ? var.value : "";
+        while (*cursor && g_efFreeCount < 8)
+        {
+            unsigned first, last;
+            if (sscanf(cursor, "%x-%x", &first, &last) != 2)
+                break;
+            g_efFree[g_efFreeCount][0] = (u16)first;
+            g_efFree[g_efFreeCount][1] = (u16)last;
+            g_efFreeCount++;
+            cursor = strchr(cursor, ';');
+            cursor = cursor ? cursor + 1 : "";
+        }
+    }
+
+    // emufusion_ws_xram: "1" gives a lengthened loader 256 bytes of its own at E000.
+    var.key = "emufusion_ws_xram";
+    var.value = NULL;
+    ef_xram_wanted = environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value && atoi(var.value);
+
+    var.key = "emufusion_ws_patch";
+    var.value = NULL;
+    snprintf(ef_patch_text, sizeof(ef_patch_text), "%s", environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value ? var.value : "");
+    if (!ef_patch_text[0])
+        g_efXram = NULL;
+    ef_patches_apply();
+
     var.key = "gearsystem_up_down_allowed";
     var.value = NULL;
 
