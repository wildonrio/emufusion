diff --git a/ef_wide.h b/ef_wide.h
new file mode 100644
index 0000000..de05c00
--- /dev/null
+++ b/ef_wide.h
@@ -0,0 +1,32 @@
+#ifndef EF_WIDE_H_
+#define EF_WIDE_H_
+// EmuFusion Widescreen Hack. BlastEm's renderer still draws the original 320 or 256
+// columns exactly as before; ef_wide_line then draws the new columns beside them from
+// the same VDP state, once the line is finished. Options, set through libretro variables:
+// emufusion_ws_aspect  target picture aspect x 1000, 0 = original picture
+// emufusion_ws_strict  planes showing only tiles written for that world position, "a,b",
+//                      with "center" trusting a bulk load only on the original screen
+// emufusion_ws_scene   when to widen: OR of AND terms of RAM tests, "FFF600=0C,FFF601!=1|..."
+// emufusion_ws_hud     moves HUD sprites to the new edges: "obj:y0-y1:x0-x1:dir[:t0-t1];..."
+// emufusion_ws_gate    "scroll", for games nobody has played through: the new columns stay closed
+//                      until the scene has scrolled far enough to fill them, and close on a cut
+// emufusion_ws_band    "y0-y1": lines where the new columns stay black, beside a status bar
+#include <stdint.h>
+#define EF_WIDE_MAX_EXT 136
+#define EF_WIDE_FB_WIDTH (320 + 2 * EF_WIDE_MAX_EXT)
+extern uint32_t ef_wide_fb[EF_WIDE_FB_WIDTH * 294];
+void ef_wide_set_aspect(const char *value);
+void ef_wide_set_strict(const char *value);
+void ef_wide_set_scene(const char *value);
+void ef_wide_set_hud(const char *value);
+void ef_wide_set_gate(const char *value);
+void ef_wide_set_band(const char *value);
+void ef_wide_set_patch(const char *value);
+void ef_wide_set_world(const char *value);
+void ef_wide_set_camera(const char *value);
+void ef_wide_apply_patch(uint16_t *cart, uint32_t size);
+void ef_wide_set_ram(const uint8_t *work_ram);
+int ef_wide_on(void);
+int ef_wide_ext(int base_width);
+void ef_wide_forget_tags(void);
+#endif
diff --git a/ef_wide.inc b/ef_wide.inc
new file mode 100644
index 0000000..dd9cb00
--- /dev/null
+++ b/ef_wide.inc
@@ -0,0 +1,576 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+// Included at the end of vdp.c; uses its static helpers.
+#include "ef_wide.h"
+uint32_t ef_wide_fb[EF_WIDE_FB_WIDTH * 294];
+static int ef_milli;
+static const uint8_t *ef_ram;
+static uint8_t ef_scene_wide = 1;
+
+enum { EF_TAG_NEVER = 0xFFFF, EF_TAG_BLANK = 0xFFFE };
+static uint16_t ef_tags[0x8000];
+static uint8_t ef_tags_ready, ef_blank_pending, ef_center_only;
+static uint8_t ef_strict_a, ef_strict_b, ef_blank_center;
+
+#define EF_MAX_TERMS 32
+typedef struct { int group; uint32_t addr; uint32_t mask, value; uint8_t negate; } ef_term;
+static ef_term ef_terms[EF_MAX_TERMS];
+static int ef_term_count;
+
+#define EF_MAX_RULES 32
+typedef struct { int y0, y1, x0, x1, dir, t0, t1; } ef_rule;
+static ef_rule ef_rules[EF_MAX_RULES];
+static int ef_rule_count;
+
+void ef_wide_set_aspect(const char *value) { ef_milli = value ? atoi(value) : 0; }
+void ef_wide_set_ram(const uint8_t *work_ram) { ef_ram = work_ram; }
+int ef_wide_on(void) { return ef_milli > 1000; }
+
+// emufusion_ws_patch: "ADDR:OLD>NEW;..." in hex, ROM file offsets: small changes to a game's own map
+// loaders, so they draw as far as the wide picture. Every OLD is checked first and a ROM that differs
+// stays narrow. They stay on while narrow: the old screen is unchanged, and video memory is then
+// already right whenever the picture goes wide.
+static char ef_patch_text[1536];
+static uint8_t ef_patch_refused;
+
+void ef_wide_set_patch(const char *value)
+{
+	snprintf(ef_patch_text, sizeof(ef_patch_text), "%s", value ? value : "");
+	ef_patch_refused = 0;
+}
+
+static int ef_hex_byte(const char *text)
+{
+	int value = 0;
+	for (int i = 0; i < 2; i++) {
+		char c = text[i];
+		int digit = c >= '0' && c <= '9' ? c - '0' : c >= 'A' && c <= 'F' ? c - 'A' + 10 : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+		if (digit < 0) return -1;
+		value = value * 16 + digit;
+	}
+	return value;
+}
+
+static inline uint8_t ef_cart_read(const uint16_t *cart, uint32_t at)
+{
+	return at & 1 ? cart[at >> 1] & 0xFF : cart[at >> 1] >> 8;
+}
+
+static inline void ef_cart_write(uint16_t *cart, uint32_t at, uint8_t value)
+{
+	cart[at >> 1] = at & 1 ? (cart[at >> 1] & 0xFF00) | value : (cart[at >> 1] & 0x00FF) | value << 8;
+}
+
+static int ef_patch_walk(uint16_t *cart, uint32_t size, int write)
+{
+	const char *p = ef_patch_text;
+	while (*p) {
+		char *end;
+		unsigned long addr = strtoul(p, &end, 16);
+		if (end == p || *end != ':') return 0;
+		const char *before = end + 1, *sep = strchr(before, '>');
+		if (!sep || (sep - before) % 2) return 0;
+		int count = (int)(sep - before) / 2;
+		const char *after = sep + 1;
+		if ((int)strlen(after) < count * 2 || addr + count > size) return 0;
+		for (int i = 0; i < count; i++) {
+			int old_byte = ef_hex_byte(before + i * 2), new_byte = ef_hex_byte(after + i * 2);
+			uint8_t now = ef_cart_read(cart, addr + i);
+			if (old_byte < 0 || new_byte < 0 || (now != old_byte && now != new_byte)) return 0;
+		}
+		if (write) {
+			for (int i = 0; i < count; i++)
+				ef_cart_write(cart, addr + i, ef_hex_byte(after + i * 2));
+		}
+		p = after + count * 2;
+		if (*p == ';') p++;
+		else if (*p) return 0;
+	}
+	return 1;
+}
+
+void ef_wide_apply_patch(uint16_t *cart, uint32_t size)
+{
+	if (!ef_patch_text[0] || !cart || !size) return;
+	if (!ef_patch_walk(cart, size, 0)) {
+		ef_patch_refused = 1;
+		return;
+	}
+	ef_patch_walk(cart, size, 1);
+}
+
+// Picture stays 4:3 at the base width, so the same aspect gives the same world on both.
+int ef_wide_ext(int base_width)
+{
+	if (ef_patch_refused) return 0;
+	int width = (ef_milli * (base_width * 3 / 4) / 1000) & ~1;
+	int ext = (width - base_width) / 2;
+	if (ext < 0) ext = 0;
+	if (ext > EF_WIDE_MAX_EXT) ext = EF_WIDE_MAX_EXT;
+	return ext;
+}
+
+void ef_wide_set_strict(const char *value)
+{
+	ef_strict_a = 0;
+	ef_strict_b = 0;
+	ef_blank_center = 0;
+	if (value) {
+		char copy[64];
+		strncpy(copy, value, sizeof(copy) - 1);
+		copy[sizeof(copy) - 1] = 0;
+		for (char *part = strtok(copy, ","); part; part = strtok(NULL, ",")) {
+			if (!strcmp(part, "a")) ef_strict_a = 1;
+			else if (!strcmp(part, "b")) ef_strict_b = 1;
+			else if (!strcmp(part, "center")) ef_blank_center = 1;
+		}
+	}
+	if ((ef_strict_a || ef_strict_b) && !ef_tags_ready) {
+		for (int i = 0; i < 0x8000; i++) ef_tags[i] = EF_TAG_NEVER;
+		ef_tags_ready = 1;
+	}
+}
+
+void ef_wide_set_scene(const char *value)
+{
+	ef_term_count = 0;
+	ef_scene_wide = 1;
+	if (!value) return;
+	int group = 0;
+	const char *cursor = value;
+	while (*cursor && ef_term_count < EF_MAX_TERMS) {
+		char text[32] = {0};
+		size_t length = strcspn(cursor, ",|");
+		if (length && length < sizeof(text)) {
+			memcpy(text, cursor, length);
+			const char *equals = strchr(text, '=');
+			if (equals && equals != text) {
+				ef_term *term = ef_terms + ef_term_count++;
+				char *end;
+				term->group = group;
+				term->negate = equals[-1] == '!';
+				term->addr = strtoul(text, &end, 16);
+				term->mask = *end == '/' ? strtoul(end + 1, NULL, 16) : 0xFF;
+				term->value = strtoul(equals + 1, NULL, 16);
+			}
+		}
+		if (cursor[length] == '|') group++;
+		cursor += length + (cursor[length] ? 1 : 0);
+	}
+}
+
+void ef_wide_set_hud(const char *value)
+{
+	ef_rule_count = 0;
+	if (!value) return;
+	const char *cursor = value;
+	while (*cursor && ef_rule_count < EF_MAX_RULES) {
+		char text[48] = {0};
+		size_t length = strcspn(cursor, ";");
+		if (length && length < sizeof(text)) {
+			memcpy(text, cursor, length);
+			ef_rule rule = {0};
+			rule.t1 = 0x7FF;
+			int fields = sscanf(text, "obj:%d-%d:%d-%d:%d:%x-%x", &rule.y0, &rule.y1, &rule.x0, &rule.x1,
+				&rule.dir, &rule.t0, &rule.t1);
+			if (fields >= 5 && rule.dir) ef_rules[ef_rule_count++] = rule;
+		}
+		cursor += length + (cursor[length] ? 1 : 0);
+	}
+}
+
+static void ef_evaluate_scene(void)
+{
+	if (!ef_term_count || !ef_ram) {
+		ef_scene_wide = 1;
+		return;
+	}
+	uint8_t any = 0;
+	for (int index = 0; index < ef_term_count && !any;) {
+		int group = ef_terms[index].group;
+		uint8_t all = 1;
+		for (; index < ef_term_count && ef_terms[index].group == group; index++) {
+			ef_term *term = ef_terms + index;
+			// 68000 byte order on a little-endian host: work RAM is an array of words.
+			uint32_t actual = ef_ram[(term->addr & 0xFFFF) ^ 1] & term->mask;
+			all = all && ((actual == term->value) != term->negate);
+		}
+		any = all;
+	}
+	ef_scene_wide = any;
+}
+
+static inline uint16_t ef_word(vdp_context *c, uint32_t address)
+{
+	return c->vdpmem[address & 0xFFFF] << 8 | c->vdpmem[(address + 1) & 0xFFFF];
+}
+
+static uint16_t ef_hscroll(vdp_context *c, uint32_t line, uint32_t plane)
+{
+	uint32_t table = (c->regs[REG_HSCROLL] & 0x3F) << 10;
+	uint32_t mode = c->regs[REG_MODE_3] & 3;
+	uint32_t index = mode == 0 ? 0 : mode == 1 ? (line & 7) : mode == 2 ? (line & ~7u) : line;
+	return ef_word(c, table + index * 4 + plane * 2) & 0x3FF;
+}
+
+static uint32_t ef_plane_base(vdp_context *c, uint32_t plane)
+{
+	return plane ? (c->regs[REG_SCROLL_B] & 0x7) << 13 : (c->regs[REG_SCROLL_A] & 0x38) << 10;
+}
+
+static uint32_t ef_plane_cols(vdp_context *c)
+{
+	static const uint8_t sizes[] = {32, 64, 32, 128};
+	return sizes[c->regs[REG_SCROLL] & 3];
+}
+
+static uint32_t ef_plane_rows(vdp_context *c)
+{
+	static const uint8_t sizes[] = {32, 64, 32, 128};
+	return sizes[c->regs[REG_SCROLL] >> 4 & 3];
+}
+
+static uint16_t ef_tag_for(vdp_context *c, uint32_t plane, uint32_t col, uint32_t row)
+{
+	uint32_t cols = ef_plane_cols(c), rows = ef_plane_rows(c);
+	int camera = (-(int)ef_hscroll(c, 100, plane)) & 0x3FF;
+	int center_x = (camera + 160) >> 3;
+	int center_y = ((c->vsram[plane] & 0x3FF) + 112) >> 3;
+	int world_x = center_x + ((((int)col - center_x + (int)cols / 2) & ((int)cols - 1)) - (int)cols / 2);
+	int world_y = center_y + ((((int)row - center_y + (int)rows / 2) & ((int)rows - 1)) - (int)rows / 2);
+	return (world_x & 0x7F) | (world_y & 0x7F) << 8;
+}
+
+// A tilemap word changed: note which world position it now shows.
+static void ef_tag_write(vdp_context *c, uint32_t address)
+{
+	uint32_t word = address >> 1 & 0x7FFF;
+	if (!(c->regs[REG_MODE_2] & BIT_DISP_EN)) {
+		ef_tags[word] = EF_TAG_BLANK;
+		ef_blank_pending = 1;
+		return;
+	}
+	uint32_t cols = ef_plane_cols(c), rows = ef_plane_rows(c);
+	for (uint32_t plane = 0; plane < 2; plane++) {
+		if (!(plane ? ef_strict_b : ef_strict_a)) continue;
+		uint32_t offset = ((address & ~1u) - ef_plane_base(c, plane)) & 0xFFFF;
+		if (offset >= (cols * rows * 2 > 0x2000 ? 0x2000 : cols * rows * 2)) continue;
+		ef_tags[word] = ef_tag_for(c, plane, (offset / 2) % cols, (offset / 2) / cols);
+		return;
+	}
+	ef_tags[word] = EF_TAG_NEVER;
+}
+
+// Cells loaded while the display was off take the scroll the picture first appears with.
+static void ef_sweep_blank(vdp_context *c)
+{
+	uint32_t cols = ef_plane_cols(c), rows = ef_plane_rows(c);
+	uint8_t center = ef_center_only || ef_blank_center;
+	for (uint32_t plane = 0; plane < 2; plane++) {
+		if (!(plane ? ef_strict_b : ef_strict_a)) continue;
+		uint32_t base = ef_plane_base(c, plane);
+		int camera = (-(int)ef_hscroll(c, 100, plane)) & 0x3FF;
+		for (uint32_t row = 0; row < rows; row++) {
+			for (uint32_t col = 0; col < cols; col++) {
+				uint32_t offset = (row * cols + col) * 2;
+				if (offset >= 0x2000) continue;
+				uint32_t word = (base + offset) >> 1 & 0x7FFF;
+				if (ef_tags[word] != EF_TAG_BLANK) continue;
+				ef_tags[word] = ef_tag_for(c, plane, col, row);
+				if (center) {
+					int distance = ((int)(col * 8) - camera - 160) & (int)(cols * 8 - 1);
+					if (distance >= (int)cols * 4) distance -= cols * 8;
+					if (distance < -160 || distance >= 160) ef_tags[word] = EF_TAG_NEVER;
+				}
+			}
+		}
+	}
+	ef_center_only = 0;
+	ef_blank_pending = 0;
+}
+
+void ef_wide_forget_tags(void)
+{
+	if (!ef_tags_ready) return;
+	for (int i = 0; i < 0x8000; i++) ef_tags[i] = EF_TAG_BLANK;
+	ef_blank_pending = 1;
+	ef_center_only = 1;
+}
+
+// The columns of each map plane that hold the game's world, when a plane is wider than its world:
+// PLANE:FIRST-LAST, or PLANE:FIRST-LAST/FIRST-LAST for the left and right new columns apart.
+// The first plane named holds the world: past its columns the new columns are black.
+static int ef_world_first[2][2], ef_world_last[2][2] = {{127, 127}, {127, 127}};
+static uint32_t ef_world_plane;
+
+void ef_wide_set_world(const char *value)
+{
+	for (int plane = 0; plane < 2; plane++) {
+		ef_world_first[plane][0] = ef_world_first[plane][1] = 0;
+		ef_world_last[plane][0] = ef_world_last[plane][1] = 127;
+	}
+	ef_world_plane = 0;
+	if (!value) return;
+	ef_world_plane = value[0] == 'B';
+	for (int plane = 0; plane < 2; plane++) {
+		const char *part = strstr(value, plane ? "B:" : "A:");
+		int first, last, first2, last2;
+		if (!part) continue;
+		int fields = sscanf(part + 2, "%d-%d/%d-%d", &first, &last, &first2, &last2);
+		if (fields < 2) continue;
+		ef_world_first[plane][0] = first;
+		ef_world_last[plane][0] = last;
+		ef_world_first[plane][1] = fields == 4 ? first2 : first;
+		ef_world_last[plane][1] = fields == 4 ? last2 : last;
+	}
+}
+
+static inline uint8_t ef_past_world(uint32_t plane, int x, uint32_t col)
+{
+	int side = x >= 0;
+	return (int)col < ef_world_first[plane][side] || (int)col > ef_world_last[plane][side];
+}
+
+// The camera's left limit on a plane's ten-bit scroll, and how far it can travel: PLANE:LOW+SPAN.
+// For a map streamed into a plane narrower than its world, where columns cannot tell the ends.
+static int ef_limit_span = -1, ef_limit_low;
+static uint32_t ef_limit_plane;
+
+void ef_wide_set_camera(const char *value)
+{
+	char plane;
+	ef_limit_span = -1;
+	if (value && sscanf(value, "%c:%d+%d", &plane, &ef_limit_low, &ef_limit_span) != 3) ef_limit_span = -1;
+	if (value) ef_limit_plane = value[0] == 'B';
+}
+
+static inline uint8_t ef_past_camera(int x, int base_width, uint16_t hscroll)
+{
+	if (ef_limit_span < 0) return 0;
+	int half = (1024 - ef_limit_span) / 2;
+	int travel = ((((-(int)hscroll - ef_limit_low) & 0x3FF) + half) & 0x3FF) - half;
+	return x + travel < 0 || x + travel >= ef_limit_span + base_width;
+}
+
+// One plane pixel at screen position x of this line, 0 when transparent, else the same
+// byte the renderer's scroll buffers hold: palette, colour and priority.
+static uint8_t ef_plane_pixel(vdp_context *c, uint32_t plane, int x, uint32_t line, uint16_t hscroll, uint16_t vscroll)
+{
+	uint32_t cols = ef_plane_cols(c);
+	uint32_t vmask = 0xFF | (c->regs[REG_SCROLL] & 0x30) << 4;
+	int world = x - (int)hscroll;
+	uint32_t col = (uint32_t)(world >> 3) & (cols - 1);
+	if (ef_past_world(plane, x, col)) return 0;
+	uint32_t y = (vscroll + line) & vmask;
+	uint32_t row = y >> 3;
+	uint32_t offset = (row * cols + col) * 2;
+	uint32_t address = (ef_plane_base(c, plane) + (offset & 0x1FFF)) & 0xFFFE;
+	if (plane ? ef_strict_b : ef_strict_a) {
+		// Current against the frame's camera, so per-line parallax scroll cannot fail it, and
+		// not a wrapped repeat of a map too narrow to reach this far.
+		int half_screen = (c->regs[REG_MODE_4] & BIT_H40 ? 320 : 256) / 2;
+		int from_center = x - half_screen;
+		if (from_center < 0) from_center = -from_center;
+		if (from_center >= (int)cols * 4) return 0;
+		if (ef_tags[address >> 1 & 0x7FFF] != ef_tag_for(c, plane, col, row)) return 0;
+	}
+	uint16_t entry = ef_word(c, address);
+	uint32_t fine_y = y & 7;
+	uint32_t fine_x = world & 7;
+	if (entry & MAP_BIT_V_FLIP) fine_y = 7 - fine_y;
+	if (entry & MAP_BIT_H_FLIP) fine_x = 7 - fine_x;
+	uint8_t byte = c->vdpmem[(((entry & 0x7FF) << 5) + fine_y * 4 + (fine_x >> 1)) & 0xFFFF];
+	uint8_t color = fine_x & 1 ? byte & 0xF : byte >> 4;
+	if (!color) return 0;
+	return color | (entry >> 9 & 0x70);
+}
+
+static int ef_moved_x(uint32_t line, int x, uint32_t tile, int amount)
+{
+	for (int i = 0; i < ef_rule_count; i++) {
+		ef_rule *rule = ef_rules + i;
+		if ((int)line >= rule->y0 && (int)line <= rule->y1 && x >= rule->x0 && x <= rule->x1 &&
+				(int)tile >= rule->t0 && (int)tile <= rule->t1) return x + rule->dir * amount;
+	}
+	return x;
+}
+
+// Sprites over the whole wide line, in table order: the first one drawn wins, as on the VDP.
+static void ef_sprites(vdp_context *c, uint32_t line, int ext, int base_width, uint8_t *wide, uint8_t *hud)
+{
+	uint32_t y_line = (line + 128) & 0x1FF;
+	uint32_t table = mode5_sat_address(c);
+	uint32_t limit = c->regs[REG_MODE_4] & BIT_H40 ? MAX_SPRITES_FRAME : MAX_SPRITES_FRAME_H32;
+	uint32_t index = 0;
+	uint8_t seen_any = 0;
+	for (uint32_t count = 0; count < limit; count++) {
+		uint32_t cache = index * 4;
+		uint32_t y = (c->sat_cache[cache] << 8 | c->sat_cache[cache + 1]) & 0x1FF;
+		uint8_t size = c->sat_cache[cache + 2];
+		uint32_t next = c->sat_cache[cache + 3] & 0x7F;
+		uint32_t height = ((size & 3) + 1) * 8;
+		uint32_t width = ((size >> 2 & 3) + 1) * 8;
+		if (y <= y_line && y_line < y + height) {
+			uint32_t att = table + index * 8 + 4;
+			uint16_t tileinfo = ef_word(c, att);
+			uint32_t x_pos = ef_word(c, att + 2) & 0x1FF;
+			if (!x_pos) {
+				if (seen_any) break;  // the VDP's sprite mask
+			} else {
+				seen_any = 1;
+				uint32_t tile = tileinfo & 0x7FF;
+				int x = (int)x_pos - 128;
+				int moved = ef_rule_count ? ef_moved_x(line, x, tile, ext) : x;
+				uint8_t *target = moved != x ? hud : wide;
+				uint8_t pal_priority = tileinfo >> 9 & 0x70;
+				uint32_t row = y_line - y;
+				if (tileinfo & MAP_BIT_V_FLIP) row = height - 1 - row;
+				for (uint32_t px = 0; px < width; px++) {
+					int sx = moved + (int)(tileinfo & MAP_BIT_H_FLIP ? width - 1 - px : px) + ext;
+					if (sx < 0 || sx >= base_width + 2 * ext) continue;
+					if (target == wide && sx >= ext && sx < ext + base_width) continue;  // the renderer drew those
+					if (target[sx] & 0xF) continue;
+					uint32_t cell = px / 8;
+					uint32_t address = ((tile + cell * (height / 8) + row / 8) << 5) + (row & 7) * 4 + (px & 7) / 2;
+					uint8_t byte = c->vdpmem[address & 0xFFFF];
+					uint8_t color = px & 1 ? byte & 0xF : byte >> 4;
+					if (color) target[sx] = color | pal_priority;
+				}
+			}
+		}
+		index = next;
+		if (!index || index >= limit) break;
+	}
+}
+
+// A sprite the rules move must not also appear where the game put it.
+static uint16_t ef_hide_moved_sprite(vdp_context *c, uint32_t line, uint16_t x_pos, uint16_t tileinfo)
+{
+	if (!ef_rule_count || !ef_wide_on() || !ef_scene_wide || !x_pos) return x_pos;
+	int x = (int)x_pos - 128;
+	if (ef_moved_x(line, x, tileinfo & 0x7FF, 1) != x) return 1;
+	return x_pos;
+}
+
+// The line just finished in the original columns: copy it and draw the new columns beside it.
+static uint8_t ef_scroll_gate;
+static int ef_gate_travel, ef_gate_blanked;
+static uint16_t ef_gate_last[2];
+
+void ef_wide_set_gate(const char *value)
+{
+	ef_scroll_gate = value && !strcmp(value, "scroll");
+	ef_gate_travel = 0;
+}
+
+static int ef_band_first = 1000, ef_band_last = -1;
+
+void ef_wide_set_band(const char *value)
+{
+	if (!value || sscanf(value, "%d-%d", &ef_band_first, &ef_band_last) != 2) {
+		ef_band_first = 1000;
+		ef_band_last = -1;
+	}
+}
+
+// Once a frame. The middle of the picture stands for the camera: a status bar at the top does not scroll.
+static void ef_gate_frame(vdp_context *c)
+{
+	int moved = 0;
+	uint8_t cut = 0;
+	for (uint32_t plane = 0; plane < 2; plane++) {
+		uint16_t now = ef_hscroll(c, 112, plane);
+		// The scroll is ten bits: a step across its wrap is still a small one.
+		int step = ((now - ef_gate_last[plane] + 512) & 1023) - 512;
+		ef_gate_last[plane] = now;
+		if (step < 0) step = -step;
+		// A camera that jumps has cut to another scene; one that scrolls moves a few pixels.
+		if (step > 24) cut = 1;
+		if (step > moved) moved = step;
+	}
+	ef_gate_blanked = c->regs[REG_MODE_2] & BIT_DISP_EN ? 0 : ef_gate_blanked + 1;
+	ef_gate_travel = cut || ef_gate_blanked > 2 ? 0 : ef_gate_travel + moved;
+}
+
+static void ef_wide_line(vdp_context *c, pixel_t *source)
+{
+	if (!ef_wide_on() || c->double_res || !(c->regs[REG_MODE_2] & BIT_MODE_5) || c->s32x_vid) return;
+	uint32_t row = (uint32_t)(((char *)source - (char *)c->fb) / c->output_pitch);
+	if (row >= 294) return;
+	uint32_t line = (c->vcounter - 1) & 0x1FF;
+	uint32_t active = line < c->inactive_start;
+	if (active && line == 0) {
+		ef_evaluate_scene();
+		// A map plane no wider than the picture has nothing more to show: new columns would
+		// only repeat the far side of the screen, so the game stays at its own width.
+		if (ef_plane_cols(c) * 8 <= (c->regs[REG_MODE_4] & BIT_H40 ? 320u : 256u)) ef_scene_wide = 0;
+		if (ef_scroll_gate) {
+			ef_gate_frame(c);
+			if (ef_gate_travel < ef_wide_ext(c->regs[REG_MODE_4] & BIT_H40 ? 320 : 256) + 16) ef_scene_wide = 0;
+		}
+		if (ef_blank_pending && (ef_strict_a || ef_strict_b) && (c->regs[REG_MODE_2] & BIT_DISP_EN))
+			ef_sweep_blank(c);
+	}
+	int base_width = c->regs[REG_MODE_4] & BIT_H40 ? 320 : 256;
+	int ext = ef_wide_ext(base_width);
+	pixel_t *out = ef_wide_fb + row * EF_WIDE_FB_WIDTH;
+	memcpy(out + ext, source + BORDER_LEFT, base_width * sizeof(pixel_t));
+	pixel_t back = active && ef_scene_wide ? c->colors[c->regs[REG_BG_COLOR] & 0x3F] : 0;
+	if ((int)line >= ef_band_first && (int)line <= ef_band_last) back = 0;
+	if (!active || !(c->regs[REG_MODE_2] & BIT_DISP_EN) || !ef_scene_wide || ((int)line >= ef_band_first && (int)line <= ef_band_last)) {
+		for (int i = 0; i < ext; i++) {
+			out[i] = back;
+			out[ext + base_width + i] = back;
+		}
+		return;
+	}
+	static uint8_t sprite_line[EF_WIDE_FB_WIDTH], hud_line[EF_WIDE_FB_WIDTH];
+	memset(sprite_line, 0, base_width + 2 * ext);
+	memset(hud_line, 0, base_width + 2 * ext);
+	ef_sprites(c, line, ext, base_width, sprite_line, hud_line);
+	uint16_t hs_a = ef_hscroll(c, line, 0), hs_b = ef_hscroll(c, line, 1);
+	uint8_t column_scroll = c->regs[REG_MODE_3] & BIT_VSCROLL;
+	uint32_t last_column = base_width == 320 ? 38 : 30;
+	uint8_t shadow_mode = c->regs[REG_MODE_4] & BIT_HILIGHT;
+	uint8_t bg_index = c->regs[REG_BG_COLOR] & 0x3F;
+	// The window plane replaces plane A: whole lines, or everything on one side.
+	uint32_t top = c->window_v_latch & WINDOW_DOWN ? (c->window_v_latch & 0x1F) * 8 : 0;
+	uint32_t bottom = c->window_v_latch & WINDOW_DOWN ? 512 : (c->window_v_latch & 0x1F) * 8;
+	uint8_t window_line = line >= top && line < bottom;
+	uint8_t window_left = window_line || (!(c->window_h_latch & WINDOW_RIGHT) && (c->window_h_latch & 0x1F));
+	uint8_t window_right = window_line || ((c->window_h_latch & WINDOW_RIGHT) != 0);
+	uint8_t debug;
+	for (int side = 0; side < 2; side++) {
+		uint32_t column = side ? last_column : 0;
+		uint16_t vs_a = (column_scroll ? c->vsram[column] : c->vsram[0]) & 0x3FF;
+		uint16_t vs_b = (column_scroll ? c->vsram[column + 1] : c->vsram[1]) & 0x3FF;
+		uint8_t no_a = side ? window_right : window_left;
+		for (int i = 0; i < ext; i++) {
+			int x = side ? base_width + i : i - ext;
+			int sx = x + ext;
+			if (ef_past_camera(x, base_width, ef_limit_plane ? hs_b : hs_a) ||
+					ef_past_world(ef_world_plane, x, (uint32_t)((x - (int)(ef_world_plane ? hs_b : hs_a)) >> 3) & (ef_plane_cols(c) - 1))) {
+				out[sx] = 0;
+				continue;
+			}
+			uint8_t a = no_a ? 0 : ef_plane_pixel(c, 0, x, line, hs_a, vs_a);
+			uint8_t b = ef_plane_pixel(c, 1, x, line, hs_b, vs_b);
+			uint8_t pixel;
+			if (shadow_mode) {
+				sh_pixel shaded = composite_highlight(c, &debug, sprite_line[sx], a, b, bg_index);
+				if (shaded.intensity == BUF_BIT_PRIORITY << 1) pixel = (shaded.index & 0x3F) + HIGHLIGHT_OFFSET;
+				else if (shaded.intensity) pixel = shaded.index & 0x3F;
+				else pixel = (shaded.index & 0x3F) + SHADOW_OFFSET;
+				out[sx] = c->colors[pixel];
+			} else {
+				pixel = composite_normal(c, &debug, sprite_line[sx], a, b, bg_index);
+				out[sx] = c->colors[pixel & 0x3F];
+			}
+		}
+	}
+	if (ef_rule_count) {
+		for (int sx = 0; sx < base_width + 2 * ext; sx++)
+			if (hud_line[sx] & 0xF) out[sx] = c->colors[hud_line[sx] & 0x3F];
+	}
+}
