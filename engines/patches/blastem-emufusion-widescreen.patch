+}
+
+// The recipe's options, at load and whenever the frontend says they changed.
+static void ef_read_options(void)
+{
+	static uint8_t loaded;
+	uint8_t updated = 0;
+	retro_environment(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated);
+	if (loaded && !updated) return;
+	loaded = 1;
+	ef_read_option("emufusion_ws_strict", ef_wide_set_strict);
+	ef_read_option("emufusion_ws_gate", ef_wide_set_gate);
+	ef_read_option("emufusion_ws_band", ef_wide_set_band);
+	ef_read_option("emufusion_ws_world", ef_wide_set_world);
+	ef_read_option("emufusion_ws_camera", ef_wide_set_camera);
+	ef_read_option("emufusion_ws_patch", ef_wide_set_patch);
+	if (stype == SYSTEM_GENESIS || stype == SYSTEM_SEGACD)
+		ef_wide_apply_patch(((genesis_context *)current_system)->cart, media.size);
+	ef_read_option("emufusion_ws_scene", ef_wide_set_scene);
+	ef_read_option("emufusion_ws_hud", ef_wide_set_hud);
+	ef_read_option("emufusion_ws_aspect", ef_wide_set_aspect);
+	if (stype == SYSTEM_GENESIS || stype == SYSTEM_SEGACD)
+		ef_wide_set_ram((const uint8_t *)((genesis_context *)current_system)->work_ram);
+}
+
+static int ef_interlaced(void)
+{
+	return (stype == SYSTEM_GENESIS || stype == SYSTEM_SEGACD) && ((genesis_context *)current_system)->vdp->double_res;
+}
