+// Play!'s standalone Android process owns SIGSEGV and uses it to invalidate
+// protected EE code pages.  An in-process libretro core shares Android's ART
+// signal chain with its Java host, where replacing SIGSEGV is not safe.  Play!
+// already supports this correctness-first invalidation mode on other ARM
+// targets; use it for EmuFusion's embedded Android route as well.
+#if defined(__ANDROID__) && defined(EMUFUSION_LIBRETRO)
+#define DISABLE_PROTECTION
+#endif
