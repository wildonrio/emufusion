diff --git a/git-version.cmake b/git-version.cmake
index f983a35..8277db0 100644
--- a/git-version.cmake
+++ b/git-version.cmake
@@ -1,9 +1,10 @@
 set(GIT_VERSION_FILE "${OUTPUT_DIR}/git-version.cpp")
-set(GIT_VERSION "unknown")
+# EmuFusion builds the SHA-256-pinned release archive without a .git directory.
+set(GIT_VERSION "v1.20.4-fa50bb1")
 set(GIT_VERSION_UPDATE "1")
 
-find_package(Git)
-if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git/")
+# Do not make the binary identity depend on a host Git installation.
+if(FALSE)
 	execute_process(COMMAND ${GIT_EXECUTABLE} describe --always
 		WORKING_DIRECTORY ${SOURCE_DIR}
 		RESULT_VARIABLE exit_code
@@ -11,5 +12,5 @@ if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git/")
 	endif()
 	string(STRIP ${GIT_VERSION} GIT_VERSION)
-else()
+elseif(GIT_VERSION STREQUAL "unknown")
 	message(WARNING "git not found, unable to include version.")
 endif()

diff --git a/libretro/LibretroGraphicsContext.cpp b/libretro/LibretroGraphicsContext.cpp
index 75334a7..a3d4852 100644
--- a/libretro/LibretroGraphicsContext.cpp
+++ b/libretro/LibretroGraphicsContext.cpp
@@ -17,6 +17,17 @@ extern "C" {
    retro_hw_get_proc_address_t libretro_get_proc_address;
 };
 
+/* EmuFusion creates its Android presentation framebuffer after libretro's
+ * hardware negotiation but before context_reset.  Export a narrow adapter so
+ * the pinned in-process host can supply that final framebuffer name at the
+ * lifecycle boundary instead of depending on PPSSPP's later emulation-thread
+ * callback timing.  This is intentionally not a general configuration API. */
+extern GLuint g_defaultFBO;
+extern "C" __attribute__((visibility("default")))
+void emufusion_set_frontend_framebuffer(unsigned framebuffer) {
+	g_defaultFBO = (GLuint)framebuffer;
+}
+
 void retro_set_video_refresh(retro_video_refresh_t cb) { LibretroGraphicsContext::video_cb = cb; }
 static void context_reset() { ((LibretroHWRenderContext *)Libretro::ctx)->ContextReset(); }
 static void context_destroy() { ((LibretroHWRenderContext *)Libretro::ctx)->ContextDestroy(); }
