+    void key_event(int key_code,bool pressed,int value){
+        // Init rebuilds the handlers under this same lock. Keep the published
+        // pad and its handler alive until the input write has finished.
+        std::lock_guard pad_lock(pad::g_pad_mutex);
+        auto* pad_thr = pad::get_current_handler(true);
+        if (!pad_thr) return;
+        auto& handlers = pad_thr->get_handlers();
+        const auto found = handlers.find(pad_handler::keyboard);
+        if (found == handlers.end()) return;
+        auto padh = std::dynamic_pointer_cast<AndroidVirtualPadHandler>(found->second);
+        if (!padh) return;
+
+        pthread_mutex_lock(&key_event_mutex);
+        // Non-allocating RAII; an exception must not strand the pad worker.
+        const std::unique_ptr<pthread_mutex_t, decltype(&pthread_mutex_unlock)>
+            unlock(&key_event_mutex, &pthread_mutex_unlock);
+        padh->Key(static_cast<u32>(key_code), static_cast<bool>(pressed),value);
+    }
