+pad_thread::pad_thread(void* curthread, void* curwindow, std::string_view title_id) : m_curthread(curthread), m_curwindow(curwindow)
+{
+    std::lock_guard lock(pad::g_pad_mutex);
+    pad::g_title_id = title_id;
+    pad::g_started = false;
+    pad::g_current = this;
+}
+
+pad_thread::~pad_thread()
+{
+    // Wait for in-flight input before members are destroyed. A retired pad
+    // must not unpublish a newer handler during an internal game restart.
+    std::lock_guard lock(pad::g_pad_mutex);
+    if (pad::g_current.observe() == this)
+        pad::g_current = nullptr;
+}
 
