+// EmuFusion (local, 2026-10-26): the host trims the VBlank clock to an exact
+// divisor of the measured panel (59.95 Hz on a 119.9 Hz panel), so a game's
+// frames stop slipping a scan against it every ~20 s. Zero keeps the
+// configured rate; the adapter bounds the trim to 0.75% of it.
+std::atomic<double> g_emufusion_vblank_hz{0.0};
+
+static u64 emufusion_vblank_period(u64 vblank_rate)
+{
+	const double hz = g_emufusion_vblank_hz.load(std::memory_order_relaxed);
+	if (hz > 0.0 && vblank_rate > 0)
+		return static_cast<u64>(1'000'000.0 * static_cast<double>(vblank_rate) / hz + 0.5);
+	return 1'000'000 + u64{g_cfg.video.vblank_ntsc.get()} * 1000;
+}
+
 LOG_CHANNEL(perf_log, "PERF");
 
