+// EmuFusion Widescreen Hack: target picture aspect x 1000, and when to widen: OR of AND terms of
+// memory tests, "2000100=01,2000101!=02|3000000/F0=10".
+#define EF_MAX_TERMS 32
+struct EfTerm { int group; uint32_t addr; uint8_t mask, value, negate; };
+static struct EfTerm efTerms[EF_MAX_TERMS];
+static int efTermCount;
+
+static void ef_set_scene(const char* value) {
+	efTermCount = 0;
+	if (!value) {
+		return;
+	}
+	int group = 0;
+	const char* cursor = value;
+	while (*cursor && efTermCount < EF_MAX_TERMS) {
+		char text[32] = {0};
+		size_t length = strcspn(cursor, ",|");
+		if (length && length < sizeof(text)) {
+			memcpy(text, cursor, length);
+			const char* equals = strchr(text, '=');
+			if (equals && equals != text) {
+				struct EfTerm* term = &efTerms[efTermCount++];
+				char* end;
+				term->group = group;
+				term->negate = equals[-1] == '!';
+				term->addr = strtoul(text, &end, 16);
+				term->mask = *end == '/' ? strtoul(end + 1, NULL, 16) : 0xFF;
+				term->value = strtoul(equals + 1, NULL, 16);
+			}
+		}
+		if (cursor[length] == '|') {
+			group++;
+		}
+		cursor += length + (cursor[length] ? 1 : 0);
+	}
+}
+
+static void ef_evaluate_scene(void) {
+	bool any = efTermCount == 0;
+	for (int index = 0; index < efTermCount && !any;) {
+		int group = efTerms[index].group;
+		bool all = true;
+		for (; index < efTermCount && efTerms[index].group == group; ++index) {
+			const struct EfTerm* term = &efTerms[index];
+			all = all && (((core->rawRead8(core, term->addr, -1) & term->mask) == term->value) != term->negate);
+		}
+		any = all;
+	}
+	ef_wide_set_scene_wide(any);
+}
+
+static void ef_read_options(void) {
+	struct retro_variable var = { .key = "emufusion_ws_scene", .value = NULL };
+	ef_set_scene(environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) ? var.value : NULL);
+	var.key = "emufusion_ws_aspect";
+	var.value = NULL;
+	int before = ef_wide_ext();
+	ef_wide_set_aspect(environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) ? var.value : NULL);
+	if (core && ef_wide_ext() != before) {
+		struct retro_system_av_info info;
+		retro_get_system_av_info(&info);
+		environCallback(RETRO_ENVIRONMENT_SET_GEOMETRY, &info.geometry);
+	}
+}
