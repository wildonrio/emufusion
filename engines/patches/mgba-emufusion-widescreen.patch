index 0000000..dfb4710
--- /dev/null
+++ b/src/gba/renderers/ef_wide.h
@@ -0,0 +1,20 @@
+#ifndef EF_WIDE_H_
+#define EF_WIDE_H_
+// EmuFusion Widescreen Hack. The renderer still draws the original 240 columns exactly as before;
+// ef_wide_line then draws the new columns beside them from the same state, once the line is done.
+#include <mgba-util/image.h>
+#include <stdbool.h>
+#include <stddef.h>
+#define EF_WIDE_MAX_EXT 64
+#define EF_WIDE_WIDTH (240 + 2 * EF_WIDE_MAX_EXT)
+void ef_wide_set_aspect(const char* value);
+void ef_wide_set_scene_wide(bool wide);
+void ef_wide_set_map(const char* value);
+void ef_wide_set_skip(const char* value);
+void ef_wide_set_gate(const char* value);
+void ef_wide_set_hud(const char* value);
+void ef_wide_set_memory(const void* wram, const void* iwram, const void* rom, size_t rom_size);
+int ef_wide_ext(void);
+int ef_wide_milli(void);
+const mColor* ef_wide_compose(const mColor* picture, int stride, int* width);
+#endif
diff --git a/src/gba/renderers/ef_wide.inc b/src/gba/renderers/ef_wide.inc
new file mode 100644
index 0000000..121b8e1
--- /dev/null
+++ b/src/gba/renderers/ef_wide.inc
@@ -0,0 +1,915 @@
+// Included at the end of video-software.c.
+static mColor ef_fb[EF_WIDE_WIDTH * GBA_VIDEO_VERTICAL_PIXELS];
+static int ef_ext, ef_milli;
+static bool ef_scene_wide = true;
+
+void ef_wide_set_aspect(const char* value) {
+	ef_milli = value ? atoi(value) : 0;
+	int ext = ef_milli > 1000 ? (ef_milli * GBA_VIDEO_VERTICAL_PIXELS / 1000 - GBA_VIDEO_HORIZONTAL_PIXELS) / 2 : 0;
+	ef_ext = ext < 0 ? 0 : ext > EF_WIDE_MAX_EXT ? EF_WIDE_MAX_EXT : ext;
+}
+
+void ef_wide_set_scene_wide(bool wide) { ef_scene_wide = wide; }
+
+// emufusion_ws_skip: layers left out of the new columns, as a bit mask. A status layer that never
+// scrolls holds the far side of the screen there, which reads as stray digits at the edges.
+static unsigned ef_skip_layers;
+void ef_wide_set_skip(const char* value) { ef_skip_layers = value ? strtoul(value, NULL, 16) : 0; }
+int ef_wide_ext(void) { return ef_ext; }
+int ef_wide_milli(void) { return ef_milli; }
+
+// emufusion_ws_hud=obj:-8-24:0-119:-1:050-0FF;bg2:0-15:120-239:1
+// Meters go out to the new corners. Each rule is a layer (obj or bgN), lines, columns, a direction
+// and optionally a range of tile numbers. Sprites match by their top left corner and bg rules by the
+// pixel. Matching sprites leave the original picture before it is drawn; a layer's pixels are covered
+// with what lies under them. Either way the moved meter is laid over the finished picture.
+#define EF_HUD_RULES 8
+#define EF_HUD_OBJ 4
+struct EfHudRule {
+	int layer, y0, y1, x0, x1, dir, t0, t1;
+};
+static struct EfHudRule ef_hud_rules[EF_HUD_RULES];
+static int ef_hud_count;
+static bool ef_hud_live;
+static int ef_hud_narrow_frames;
+static bool ef_hud_row[GBA_VIDEO_VERTICAL_PIXELS];
+static mColor ef_hud_pixel[EF_WIDE_WIDTH * GBA_VIDEO_VERTICAL_PIXELS];
+static uint8_t ef_hud_mask[EF_WIDE_WIDTH * GBA_VIDEO_VERTICAL_PIXELS];
+
+void ef_wide_set_hud(const char* value) {
+	ef_hud_count = 0;
+	while (value && *value && ef_hud_count < EF_HUD_RULES) {
+		struct EfHudRule rule = { .t0 = 0, .t1 = 0x3FF };
+		char layer[4] = {0};
+		int used = 0;
+		int got = sscanf(value, "%3[a-z0-9]:%d-%d:%d-%d:%d%n", layer, &rule.y0, &rule.y1, &rule.x0, &rule.x1, &rule.dir, &used);
+		if (got < 6) {
+			break;
+		}
+		value += used;
+		if (*value == ':') {
+			int more = 0;
+			sscanf(value, ":%x-%x%n", (unsigned*) &rule.t0, (unsigned*) &rule.t1, &more);
+			value += more;
+		}
+		rule.layer = !strcmp(layer, "obj") ? EF_HUD_OBJ : layer[0] == 'b' && layer[1] == 'g' ? layer[2] - '0' : -1;
+		if (rule.layer >= 0 && rule.layer <= EF_HUD_OBJ) {
+			ef_hud_rules[ef_hud_count++] = rule;
+		}
+		value = strchr(value, ';');
+		value = value ? value + 1 : NULL;
+	}
+}
+
+const mColor* ef_wide_compose(const mColor* picture, int stride, int* width) {
+	*width = GBA_VIDEO_HORIZONTAL_PIXELS + 2 * ef_ext;
+	for (int y = 0; y < GBA_VIDEO_VERTICAL_PIXELS; ++y) {
+		mColor* out = ef_fb + y * *width;
+		memcpy(out + ef_ext, picture + y * stride, GBA_VIDEO_HORIZONTAL_PIXELS * sizeof(mColor));
+		if (ef_hud_row[y]) {
+			const uint8_t* mask = ef_hud_mask + y * EF_WIDE_WIDTH;
+			const mColor* pixel = ef_hud_pixel + y * EF_WIDE_WIDTH;
+			for (int x = 0; x < *width; ++x) {
+				if (mask[x]) {
+					out[x] = pixel[x];
+				}
+			}
+		}
+	}
+	return ef_fb;
+}
+
+// emufusion_ws_map=grid:table=2020000,planes=2014000+201C000,cell=4,stride=200,cols=80,rows=80,mask=3FFF
+// A plane with its own table says so: planes=200B654:2012654+2025EB4:202CEB4. width= and height=
+// name where the game keeps the room's size in pixels; the cells past it are left over from before.
+// Or size=2001000: two bytes there give the map's columns and rows, and the rows sit one after another.
+// unit=2: a cell holds a byte offset in steps of that many bytes, not a block number (8).
+// add=6000: added to each table entry, for a game that moves its palettes when it copies them.
+// Many games keep the whole level in memory as a grid of block numbers, with a table of blocks of
+// four map entries, and copy only what is near the screen into the video map. The new columns read
+// the same grid. Each background finds its plane and place by comparing the grid with the video map
+// every frame, so a background that matches nothing, a menu say, draws nothing in the new columns.
+#define EF_GRID_SAMPLES 32
+#define EF_GRID_DRAWN 24
+#define EF_GRID_MISSES_TO_UNLOCK 3
+static const uint8_t* ef_wram;
+static const uint8_t* ef_iwram;
+static const uint8_t* ef_rom;
+static size_t ef_rom_size;
+static struct EfGrid {
+	bool on;
+	uint32_t table;
+	uint32_t planes[4];
+	uint32_t tables[4];
+	int plane_count, cell, stride, cols, rows, mask;
+	uint32_t width_at, height_at, size_at;
+	int room_cols, room_rows, unit;
+	uint16_t add;
+	int rooms;
+	bool edge;
+	// void=1: in the new columns, where no layer draws, black instead of the backdrop colour.
+	bool void_black;
+	unsigned ring;
+	int split, step;
+	uint32_t front[2];
+} ef_grid;
+struct EfGridPlace {
+	bool locked;
+	uint8_t misses;
+	int plane, x, y;
+};
+static struct EfGridPlace ef_grid_bg[4];
+
+void ef_wide_set_memory(const void* wram, const void* iwram, const void* rom, size_t rom_size) {
+	ef_wram = wram;
+	ef_iwram = iwram;
+	ef_rom = rom;
+	ef_rom_size = rom_size;
+}
+
+void ef_wide_set_map(const char* value) {
+	memset(&ef_grid, 0, sizeof(ef_grid));
+	memset(ef_grid_bg, 0, sizeof(ef_grid_bg));
+	if (!value || strncmp(value, "grid:", 5)) {
+		return;
+	}
+	ef_grid.cell = 2;
+	ef_grid.cols = ef_grid.rows = 128;
+	ef_grid.mask = 0xFFFF;
+	ef_grid.unit = 8;
+	ef_grid.step = 8;
+	for (const char* cursor = value + 5; *cursor;) {
+		char* end;
+		if (!strncmp(cursor, "table=", 6)) {
+			ef_grid.table = strtoul(cursor + 6, &end, 16);
+		} else if (!strncmp(cursor, "cell=", 5)) {
+			ef_grid.cell = strtoul(cursor + 5, &end, 16);
+		} else if (!strncmp(cursor, "stride=", 7)) {
+			ef_grid.stride = strtoul(cursor + 7, &end, 16);
+		} else if (!strncmp(cursor, "cols=", 5)) {
+			ef_grid.cols = strtoul(cursor + 5, &end, 16);
+		} else if (!strncmp(cursor, "rows=", 5)) {
+			ef_grid.rows = strtoul(cursor + 5, &end, 16);
+		} else if (!strncmp(cursor, "width=", 6)) {
+			ef_grid.width_at = strtoul(cursor + 6, &end, 16);
+		} else if (!strncmp(cursor, "height=", 7)) {
+			ef_grid.height_at = strtoul(cursor + 7, &end, 16);
+		} else if (!strncmp(cursor, "size=", 5)) {
+			ef_grid.size_at = strtoul(cursor + 5, &end, 16);
+		} else if (!strncmp(cursor, "unit=", 5)) {
+			ef_grid.unit = strtoul(cursor + 5, &end, 16);
+		} else if (!strncmp(cursor, "add=", 4)) {
+			ef_grid.add = strtoul(cursor + 4, &end, 16);
+		} else if (!strncmp(cursor, "mask=", 5)) {
+			ef_grid.mask = strtoul(cursor + 5, &end, 16);
+		} else if (!strncmp(cursor, "rooms=", 6)) {
+			ef_grid.rooms = strtoul(cursor + 6, &end, 16);
+		} else if (!strncmp(cursor, "edge=", 5)) {
+			ef_grid.edge = strtoul(cursor + 5, &end, 16) != 0;
+		} else if (!strncmp(cursor, "void=", 5)) {
+			ef_grid.void_black = strtoul(cursor + 5, &end, 16) != 0;
+		} else if (!strncmp(cursor, "ring=", 5)) {
+			ef_grid.ring = strtoul(cursor + 5, &end, 16);
+		} else if (!strncmp(cursor, "split=", 6)) {
+			ef_grid.split = strtoul(cursor + 6, &end, 16);
+		} else if (!strncmp(cursor, "step=", 5)) {
+			ef_grid.step = strtoul(cursor + 5, &end, 16);
+		} else if (!strncmp(cursor, "front=", 6)) {
+			ef_grid.front[0] = strtoul(cursor + 6, &end, 16);
+			ef_grid.front[1] = *end == '+' ? strtoul(end + 1, &end, 16) : 0;
+		} else if (!strncmp(cursor, "planes=", 7)) {
+			end = (char*) cursor + 6;
+			while (*end == '=' || *end == '+') {
+				uint32_t plane = strtoul(end + 1, &end, 16);
+				uint32_t table = *end == ':' ? strtoul(end + 1, &end, 16) : 0;
+				if (ef_grid.plane_count < 4) {
+					ef_grid.tables[ef_grid.plane_count] = table;
+					ef_grid.planes[ef_grid.plane_count++] = plane;
+				}
+			}
+		} else {
+			return;
+		}
+		cursor = *end == ',' ? end + 1 : end;
+		if (cursor == end && *end) {
+			return;
+		}
+	}
+	if (!ef_grid.stride) {
+		ef_grid.stride = ef_grid.cols * ef_grid.cell;
+	}
+	ef_grid.on = ef_grid.plane_count > 0;
+}
+
+static const uint8_t* ef_bus(uint32_t address, size_t bytes) {
+	size_t offset = address & 0xFFFFFF;
+	switch (address >> 24) {
+	case 2:
+		return ef_wram && offset + bytes <= 0x40000 ? ef_wram + offset : NULL;
+	case 3:
+		return ef_iwram && offset + bytes <= 0x8000 ? ef_iwram + offset : NULL;
+	case 8:
+		return ef_rom && offset + bytes <= ef_rom_size ? ef_rom + offset : NULL;
+	}
+	return NULL;
+}
+
+static uint32_t ef_read32(const uint8_t* at) {
+	return at[0] | at[1] << 8 | at[2] << 16 | (uint32_t) at[3] << 24;
+}
+
+// A room the cartridge lays out, in blocks of 4 by 4 tiles. The game keeps a record per layer with its
+// camera. Family 1 points to a room header naming the size in 256-pixel screens, and a block number's top
+// bits flip it; family 2 has size and pointers in the record itself.
+static bool ef_room_entry(int plane, int x, int y, uint16_t* entry) {
+	int cols, rows;
+	uint32_t grid, table;
+	if (ef_grid.rooms == 2) {
+		const uint8_t* record = ef_bus(ef_grid.planes[plane], 0x14);
+		if (!record) {
+			return false;
+		}
+		cols = record[0x10] | record[0x11] << 8;
+		rows = record[0x12] | record[0x13] << 8;
+		grid = ef_read32(record + 0xC);
+		table = ef_read32(record + 4);
+	} else {
+		const uint8_t* slot = ef_bus(ef_grid.planes[plane], 4);
+		const uint8_t* room = slot ? ef_bus(ef_read32(slot), 16) : NULL;
+		// Menus are records too, with no second table.
+		if (!room || !ef_read32(room + 8)) {
+			return false;
+		}
+		cols = room[0] * 8;
+		rows = room[1] * 8;
+		grid = ef_read32(room + 12);
+		table = room[2] & 2 ? ef_grid.tables[plane] : ef_read32(room + 4);
+	}
+	int blockX = x >> 5, blockY = y >> 5;
+	if (ef_grid.edge) {
+		blockX = blockX < 0 ? 0 : blockX >= cols ? cols - 1 : blockX;
+	}
+	if (blockX < 0 || blockY < 0 || blockX >= cols || blockY >= rows) {
+		return false;
+	}
+	const uint8_t* cell = ef_bus(grid + (blockY * cols + blockX) * 2, 2);
+	if (!cell) {
+		return false;
+	}
+	int value = cell[0] | cell[1] << 8;
+	int cornerX = (x >> 3) & 3, cornerY = (y >> 3) & 3;
+	int number = value;
+	if (ef_grid.rooms == 1) {
+		number = (value & 0x3FFF) - 1;
+		if (number < 0) {
+			*entry = 0;
+			return true;
+		}
+		cornerX = value & 0x4000 ? 3 - cornerX : cornerX;
+		cornerY = value & 0x8000 ? 3 - cornerY : cornerY;
+	}
+	const uint8_t* tile = ef_bus(table + (number * 16 + cornerY * 4 + cornerX) * 2, 2);
+	if (!tile) {
+		return false;
+	}
+	*entry = (tile[0] | tile[1] << 8) ^ (ef_grid.rooms == 1 ? (value & 0xC000) >> 4 : 0);
+	return true;
+}
+
+// The map entry the grid holds at pixel x, y of the world.
+static bool ef_grid_entry(int plane, int x, int y, uint16_t* entry) {
+	if (ef_grid.rooms) {
+		return ef_room_entry(plane, x, y, entry);
+	}
+	if (plane >= ef_grid.plane_count) {
+		// A background of just the tiles a list marks as in front of sprites, from either map, the first first.
+		*entry = 0;
+		for (int source = 0; source < 2 && !*entry; ++source) {
+			const uint8_t* cell = ef_bus(ef_grid.planes[source] + ((y >> 4) & (ef_grid.rows - 1)) * ef_grid.stride + ((x >> 4) & (ef_grid.cols - 1)), 1);
+			uint16_t tile;
+			if (!cell || !ef_grid_entry(source, x, y, &tile) || !(tile & 0x3FF)) {
+				continue;
+			}
+			const uint8_t* mark = ef_bus(ef_grid.front[source] + ((y >> 3) & 1) * 0x200 + ((x >> 3) & 1) * 0x100 + *cell, 1);
+			if (mark && *mark) {
+				*entry = tile;
+			}
+		}
+		return true;
+	}
+	int gridX = (x >> 4) & (ef_grid.cols - 1);
+	int gridY = (y >> 4) & (ef_grid.rows - 1);
+	if (gridX >= ef_grid.room_cols || gridY >= ef_grid.room_rows) {
+		return false;
+	}
+	const uint8_t* cell = ef_bus(ef_grid.planes[plane] + gridY * ef_grid.stride + gridX * ef_grid.cell, 2);
+	if (!cell) {
+		return false;
+	}
+	uint32_t number = (cell[0] | (ef_grid.cell > 1 ? cell[1] << 8 : 0)) & ef_grid.mask;
+	uint32_t table = ef_grid.tables[plane] ? ef_grid.tables[plane] : ef_grid.table;
+	// Corners side by side in one list, or a list per corner.
+	const uint8_t* block = ef_bus(ef_grid.split
+		? table + number * 2 + (((y >> 3) & 1) * 2 + ((x >> 3) & 1)) * ef_grid.split
+		: table + number * ef_grid.unit + ((y >> 3) & 1) * 4 + ((x >> 3) & 1) * 2, 2);
+	if (!block) {
+		return false;
+	}
+	*entry = (block[0] | block[1] << 8) + ef_grid.add;
+	return true;
+}
+
+static uint16_t ef_ring_entry(const struct GBAVideoSoftwareRenderer* r, const struct GBAVideoSoftwareBackground* bg, int x, int y) {
+	const uint8_t* vram = (const uint8_t*) r->d.vram;
+	int width = bg->size & 1 ? 512 : 256;
+	int height = bg->size & 2 ? 512 : 256;
+	int localX = x & (width - 1);
+	int localY = y & (height - 1);
+	uint32_t block = bg->screenBase;
+	if (localY >= 256) {
+		block += width == 512 ? 0x1000 : 0x800;
+	}
+	if (localX >= 256) {
+		block += 0x800;
+	}
+	uint32_t address = (block + ((localY >> 3) & 31) * 64 + ((localX >> 3) & 31) * 2) & 0x1FFFF;
+	return vram[address] | vram[address + 1] << 8;
+}
+
+static uint32_t ef_grid_tick;
+
+struct EfGridSample {
+	int x, y;
+	uint16_t entry;
+};
+
+struct EfGridSamples {
+	struct EfGridSample at[EF_GRID_SAMPLES];
+	int drawn, blank;
+};
+
+// Drawn tiles first, evenly from the whole picture: they are what tells one place from another,
+// and a layer of tree tops may have only a few among many empty cells.
+static void ef_grid_collect(const struct GBAVideoSoftwareRenderer* r, const struct GBAVideoSoftwareBackground* bg, struct EfGridSamples* out) {
+	int nonzero = 0;
+	for (int y = 0; y < 20; ++y) {
+		for (int x = 0; x < 30; ++x) {
+			nonzero += ef_ring_entry(r, bg, bg->x + x * 8, bg->y + y * 8) != 0;
+		}
+	}
+	int zero = 600 - nonzero;
+	int drawn_step = nonzero > EF_GRID_DRAWN ? nonzero / EF_GRID_DRAWN : 1;
+	int blank_step = zero > EF_GRID_SAMPLES - EF_GRID_DRAWN ? zero / (EF_GRID_SAMPLES - EF_GRID_DRAWN) : 1;
+	int seen_drawn = 0, seen_blank = 0;
+	out->drawn = out->blank = 0;
+	struct EfGridSample blank[EF_GRID_SAMPLES - EF_GRID_DRAWN];
+	for (int y = 0; y < 20; ++y) {
+		for (int x = 0; x < 30; ++x) {
+			struct EfGridSample sample = { bg->x + x * 8, bg->y + y * 8, 0 };
+			sample.entry = ef_ring_entry(r, bg, sample.x, sample.y);
+			if (sample.entry) {
+				if (!(seen_drawn++ % drawn_step) && out->drawn < EF_GRID_DRAWN) {
+					out->at[out->drawn++] = sample;
+				}
+			} else if (!(seen_blank++ % blank_step) && out->blank < EF_GRID_SAMPLES - EF_GRID_DRAWN) {
+				blank[out->blank++] = sample;
+			}
+		}
+	}
+	for (int s = 0; s < out->blank; ++s) {
+		out->at[out->drawn + s] = blank[s];
+	}
+}
+
+static bool ef_grid_fits(const struct EfGridSamples* samples, int plane, int offsetX, int offsetY, int drawn_share) {
+	int allowed = samples->drawn / drawn_share;
+	for (int s = 0; s < samples->drawn; ++s) {
+		const struct EfGridSample* sample = &samples->at[s];
+		uint16_t entry;
+		if ((!ef_grid_entry(plane, sample->x + offsetX, sample->y + offsetY, &entry) || entry != sample->entry) && --allowed < 0) {
+			return false;
+		}
+	}
+	allowed = samples->blank / 4;
+	for (int s = samples->drawn; s < samples->drawn + samples->blank; ++s) {
+		const struct EfGridSample* sample = &samples->at[s];
+		uint16_t entry;
+		// A cell past the room's edge is as empty as an empty one.
+		if (ef_grid_entry(plane, sample->x + offsetX, sample->y + offsetY, &entry) && entry && --allowed < 0) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void ef_grid_frame(const struct GBAVideoSoftwareRenderer* r) {
+	int mode = GBARegisterDISPCNTGetMode(r->dispcnt);
+	++ef_grid_tick;
+	const uint8_t* width = ef_grid.width_at ? ef_bus(ef_grid.width_at, 2) : NULL;
+	const uint8_t* height = ef_grid.height_at ? ef_bus(ef_grid.height_at, 2) : NULL;
+	ef_grid.room_cols = width ? (width[0] | width[1] << 8) >> 4 : ef_grid.cols;
+	ef_grid.room_rows = height ? (height[0] | height[1] << 8) >> 4 : ef_grid.rows;
+	const uint8_t* size = ef_grid.size_at ? ef_bus(ef_grid.size_at, 2) : NULL;
+	if (size) {
+		ef_grid.room_cols = size[0];
+		ef_grid.room_rows = size[1];
+		ef_grid.stride = size[0] * ef_grid.cell;
+	}
+	struct EfGridSamples samples[4];
+	for (int b = 0; b < 4; ++b) {
+		const struct GBAVideoSoftwareBackground* bg = &r->bg[b];
+		struct EfGridPlace* place = &ef_grid_bg[b];
+		samples[b].drawn = samples[b].blank = 0;
+		if (!bg->enabled || mode > 1 || (mode == 1 && b >= 2)) {
+			place->locked = false;
+			continue;
+		}
+		if (ef_grid.ring >> b & 1) {
+			place->locked = false;
+			continue;
+		}
+		ef_grid_collect(r, bg, &samples[b]);
+		if (place->locked && ef_grid_fits(&samples[b], place->plane, place->x, place->y, 4)) {
+			place->misses = 0;
+			continue;
+		}
+		int distinct = 0;
+		for (int s = 0; s < samples[b].drawn; ++s) {
+			bool seen = false;
+			for (int t = 0; t < s && !seen; ++t) {
+				seen = samples[b].at[t].entry == samples[b].at[s].entry;
+			}
+			distinct += !seen;
+		}
+		// The search is the costly part, so a background that has never matched looks less often.
+		bool found = false;
+		if (ef_grid.rooms) {
+			// The game's own camera says where the room is; the video scroll is the same but for its wrap.
+			for (int plane = 0; plane < ef_grid.plane_count && !found && samples[b].drawn >= 8; ++plane) {
+				const uint8_t* camera = ef_bus(ef_grid.planes[plane] + (ef_grid.rooms == 2 ? 0x18 : 4), 8);
+				if (!camera) {
+					continue;
+				}
+				int x = (((camera[2] | camera[3] << 8) - bg->x + 128) >> 8) * 256;
+				int y = (((camera[6] | camera[7] << 8) - bg->y + 128) >> 8) * 256;
+				if (ef_grid_fits(&samples[b], plane, x, y, 4)) {
+					place->locked = true;
+					place->misses = 0;
+					place->plane = plane;
+					place->x = x;
+					place->y = y;
+					found = true;
+				}
+			}
+		} else if (distinct >= 3 && samples[b].drawn >= 8 && (place->locked || !(ef_grid_tick & 7))) {
+			// The video scroll says little about the world position, so every place is tried, and
+			// the game may start a block on either of its two tile rows and columns.
+			for (int plane = 0; plane < ef_grid.plane_count + (ef_grid.front[0] != 0) && !found; ++plane) {
+				for (int y = 0; y < ef_grid.rows * 16 && !found; y += ef_grid.step) {
+					for (int x = 0; x < ef_grid.cols * 16 && !found; x += ef_grid.step) {
+						if (ef_grid_fits(&samples[b], plane, x, y, 8)) {
+							place->locked = true;
+							place->misses = 0;
+							place->plane = plane;
+							place->x = x;
+							place->y = y;
+							found = true;
+						}
+					}
+				}
+			}
+		}
+		if (!found && place->locked && ++place->misses >= EF_GRID_MISSES_TO_UNLOCK) {
+			place->locked = false;
+		}
+	}
+	// A layer with little or nothing drawn yet cannot be found alone. It usually moves with another
+	// on the plane that one is not using, and may be about to show tree tops in the new columns.
+	for (int b = 0; b < 4; ++b) {
+		struct EfGridPlace* place = &ef_grid_bg[b];
+		if (place->locked || !r->bg[b].enabled || mode > 1 || (mode == 1 && b >= 2) || samples[b].drawn >= 8) {
+			continue;
+		}
+		for (int peer = 0; peer < 4 && !place->locked; ++peer) {
+			const struct EfGridPlace* other = &ef_grid_bg[peer];
+			if (peer == b || !other->locked || r->bg[peer].x != r->bg[b].x || r->bg[peer].y != r->bg[b].y) {
+				continue;
+			}
+			for (int plane = 0; plane < ef_grid.plane_count && !place->locked; ++plane) {
+				if (plane != other->plane && ef_grid_fits(&samples[b], plane, other->x, other->y, 8)) {
+					place->locked = true;
+					place->misses = 0;
+					place->plane = plane;
+					place->x = other->x;
+					place->y = other->y;
+				}
+			}
+		}
+	}
+}
+
+// A text background's palette index at screen column x, 0 when transparent.
+static int ef_entry_pixel(const struct GBAVideoSoftwareRenderer* r, const struct GBAVideoSoftwareBackground* bg, uint16_t entry, int localX, int localY);
+
+static int ef_text_pixel(const struct GBAVideoSoftwareRenderer* r, const struct GBAVideoSoftwareBackground* bg, int x, int y) {
+	int localX = x + bg->x;
+	int localY = y + bg->y;
+	uint16_t entry;
+	if (ef_grid.on && !(ef_grid.ring >> bg->index & 1)) {
+		const struct EfGridPlace* place = &ef_grid_bg[bg->index];
+		if (!place->locked || !ef_grid_entry(place->plane, localX + place->x, localY + place->y, &entry)) {
+			return 0;
+		}
+	} else {
+		entry = ef_ring_entry(r, bg, localX, localY);
+	}
+	return ef_entry_pixel(r, bg, entry, localX, localY);
+}
+
+static int ef_entry_pixel(const struct GBAVideoSoftwareRenderer* r, const struct GBAVideoSoftwareBackground* bg, uint16_t entry, int localX, int localY) {
+	const uint8_t* vram = (const uint8_t*) r->d.vram;
+	localX &= 511;
+	localY &= 511;
+	int fineX = entry & 0x400 ? 7 - (localX & 7) : localX & 7;
+	int fineY = entry & 0x800 ? 7 - (localY & 7) : localY & 7;
+	if (bg->multipalette) {
+		return vram[(bg->charBase + (entry & 0x3FF) * 64 + fineY * 8 + fineX) & 0xFFFF];
+	}
+	uint8_t byte = vram[(bg->charBase + (entry & 0x3FF) * 32 + fineY * 4 + (fineX >> 1)) & 0xFFFF];
+	int color = fineX & 1 ? byte >> 4 : byte & 0xF;
+	return color ? color | (entry >> 12) << 4 : 0;
+}
+
+static int ef_affine_pixel(const struct GBAVideoSoftwareRenderer* r, const struct GBAVideoSoftwareBackground* bg, int x) {
+	const uint8_t* vram = (const uint8_t*) r->d.vram;
+	int size = 128 << bg->size;
+	int localX = (bg->sx + bg->dx * x) >> 8;
+	int localY = (bg->sy + bg->dy * x) >> 8;
+	if (bg->overflow) {
+		localX &= size - 1;
+		localY &= size - 1;
+	} else if (localX < 0 || localY < 0 || localX >= size || localY >= size) {
+		return 0;
+	}
+	uint8_t tile = vram[(bg->screenBase + (localY >> 3) * (size >> 3) + (localX >> 3)) & 0xFFFF];
+	return vram[(bg->charBase + tile * 64 + (localY & 7) * 8 + (localX & 7)) & 0xFFFF];
+}
+
+// Which way a moving meter's sprite goes, or 0 if it is not one.
+static int ef_hud_direction(const struct GBAObj* obj) {
+	if (GBAObjAttributesAIsTransformed(obj->a) || GBAObjAttributesAIsDisable(obj->a)) {
+		return 0;
+	}
+	int top = GBAObjAttributesAGetY(obj->a);
+	if (top >= GBA_VIDEO_VERTICAL_PIXELS) {
+		top -= 256;
+	}
+	int left = GBAObjAttributesBGetX(obj->b);
+	if (left >= 256) {
+		left -= 512;
+	}
+	int tile = GBAObjAttributesCGetTile(obj->c);
+	for (int i = 0; i < ef_hud_count; ++i) {
+		const struct EfHudRule* rule = &ef_hud_rules[i];
+		if (rule->layer == EF_HUD_OBJ && top >= rule->y0 && top <= rule->y1 && left >= rule->x0 && left <= rule->x1 && tile >= rule->t0 && tile <= rule->t1) {
+			return rule->dir;
+		}
+	}
+	return 0;
+}
+
+enum EfSpriteSet {
+	EF_SPRITES_SIDES,
+	EF_SPRITES_WHOLE,
+	EF_SPRITES_HUD
+};
+
+// Plain sprites over the wide line; x_pos is 9 bits, so they really do reach the new columns.
+static void ef_sprites(const struct GBAVideoSoftwareRenderer* r, int y, int16_t* colors, int8_t* priorities, int width, enum EfSpriteSet set) {
+	const uint8_t* vram = (const uint8_t*) r->d.vram;
+	bool oneDimensional = GBARegisterDISPCNTIsObjCharacterMapping(r->dispcnt);
+	for (int index = 127; index >= 0; --index) {
+		const struct GBAObj* obj = &r->d.oam->obj[index];
+		if (GBAObjAttributesAIsTransformed(obj->a) || GBAObjAttributesAIsDisable(obj->a)) {
+			continue;
+		}
+		int mode = GBAObjAttributesAGetMode(obj->a);
+		if (mode == OBJ_MODE_OBJWIN) {
+			continue;
+		}
+		int moved = ef_hud_live ? ef_hud_direction(obj) : 0;
+		if (set == EF_SPRITES_HUD ? !moved : moved) {
+			continue;
+		}
+		int shape = GBAObjAttributesAGetShape(obj->a) * 4 + GBAObjAttributesBGetSize(obj->b);
+		int sw = GBAVideoObjSizes[shape][0], sh = GBAVideoObjSizes[shape][1];
+		int top = GBAObjAttributesAGetY(obj->a);
+		if (top >= GBA_VIDEO_VERTICAL_PIXELS) {
+			top -= 256;
+		}
+		if (y < top || y >= top + sh) {
+			continue;
+		}
+		int left = GBAObjAttributesBGetX(obj->b);
+		if (left >= 256) {
+			left -= 512;
+		}
+		int row = GBAObjAttributesBIsVFlip(obj->b) ? sh - 1 - (y - top) : y - top;
+		bool color256 = GBAObjAttributesAIs256Color(obj->a);
+		int tile = GBAObjAttributesCGetTile(obj->c);
+		int palette = GBAObjAttributesCGetPalette(obj->c);
+		for (int px = 0; px < sw; ++px) {
+			int sx = left + (GBAObjAttributesBIsHFlip(obj->b) ? sw - 1 - px : px) + ef_ext + moved * ef_ext;
+			if (sx < 0 || sx >= width) {
+				continue;
+			}
+			if (set == EF_SPRITES_SIDES && sx >= ef_ext && sx < ef_ext + GBA_VIDEO_HORIZONTAL_PIXELS) {
+				continue;
+			}
+			int cellX = px >> 3, cellY = row >> 3, id;
+			if (color256) {
+				id = oneDimensional ? tile + (cellY * (sw >> 3) + cellX) * 2 : (tile & ~1) + cellY * 32 + cellX * 2;
+			} else {
+				id = oneDimensional ? tile + cellY * (sw >> 3) + cellX : tile + cellY * 32 + cellX;
+			}
+			int value;
+			if (color256) {
+				value = vram[0x10000 + ((id & 0x3FF) * 32 + (row & 7) * 8 + (px & 7))];
+			} else {
+				uint8_t byte = vram[0x10000 + ((id & 0x3FF) * 32 + (row & 7) * 4 + ((px & 7) >> 1))];
+				value = px & 1 ? byte >> 4 : byte & 0xF;
+				if (value) {
+					value |= palette << 4;
+				}
+			}
+			if (value) {
+				colors[sx] = value;
+				priorities[sx] = GBAObjAttributesCGetPriority(obj->c);
+			}
+		}
+	}
+}
+
+// emufusion_ws_gate=scroll, for games nobody has played through: the sides stay black until the
+// scene has scrolled far enough to have filled them, and close when the screen is rebuilt.
+static bool ef_scroll_gate;
+static int ef_scene_travel, ef_frames_blanked;
+static uint16_t ef_last_scroll[4];
+
+void ef_wide_set_gate(const char* value) {
+	ef_scroll_gate = value && !strcmp(value, "scroll");
+	ef_scene_travel = 0;
+}
+
+static void ef_gate_frame(const struct GBAVideoSoftwareRenderer* r) {
+	int moved = 0;
+	bool cut = false;
+	for (int b = 0; b < 4; ++b) {
+		const struct GBAVideoSoftwareBackground* bg = &r->bg[b];
+		// The scroll is nine bits: a step across its wrap is still a small one.
+		int step = ((bg->x - ef_last_scroll[b] + 256) & 511) - 256;
+		ef_last_scroll[b] = bg->x;
+		if (!bg->enabled) {
+			continue;
+		}
+		step = step < 0 ? -step : step;
+		// A camera that jumps has cut to another scene; one that scrolls moves a few pixels.
+		cut = cut || step > 24;
+		moved = step > moved ? step : moved;
+	}
+	ef_frames_blanked = GBARegisterDISPCNTIsForcedBlank(r->dispcnt) ? ef_frames_blanked + 1 : 0;
+	ef_scene_travel = cut || ef_frames_blanked > 2 ? 0 : ef_scene_travel + moved;
+}
+
+#define EF_LAYER_OBJ 4
+#define EF_LAYER_BACKDROP 5
+
+static bool ef_is_target(const struct GBAVideoSoftwareRenderer* r, int layer, bool first) {
+	if (layer == EF_LAYER_OBJ) {
+		return first ? r->target1Obj : r->target2Obj;
+	}
+	if (layer == EF_LAYER_BACKDROP) {
+		return first ? r->target1Bd : r->target2Bd;
+	}
+	return first ? r->bg[layer].target1 : r->bg[layer].target2;
+}
+
+// One pixel of the picture from its layers, in the way the original picture is drawn.
+static mColor ef_compose_pixel(const struct GBAVideoSoftwareRenderer* r, int x, int y, const int16_t* sprite_color, const int8_t* sprite_priority, unsigned skip) {
+	int mode = GBARegisterDISPCNTGetMode(r->dispcnt);
+	const mColor* palette = r->blendEffect == BLEND_BRIGHTEN || r->blendEffect == BLEND_DARKEN ? r->variantPalette : r->normalPalette;
+	int sx = x + ef_ext;
+	int index = 0;
+	bool sprite = sprite_color[sx] != 0;
+	if (sprite && ef_grid.on && !ef_grid.rooms) {
+		// Out on the black around a room a sprite is somewhere the game would not show it.
+		sprite = false;
+		for (int b = 0; b < 4 && !sprite; ++b) {
+			sprite = r->bg[b].enabled && ef_grid_bg[b].locked && ef_text_pixel(r, &r->bg[b], x, y);
+		}
+	}
+	// The two topmost layers here, the way the picture blends a see-through layer on the one below.
+	int under = 0, top_layer = EF_LAYER_BACKDROP, under_layer = EF_LAYER_BACKDROP;
+	bool found_under = false;
+	for (int priority = 0; priority < 4 && !found_under; ++priority) {
+		if (sprite && sprite_priority[sx] == priority) {
+			index = 256 + sprite_color[sx];
+			top_layer = EF_LAYER_OBJ;
+		}
+		for (int b = 0; b < 4 && !found_under; ++b) {
+			const struct GBAVideoSoftwareBackground* bg = &r->bg[b];
+			if (!bg->enabled || (int) bg->priority != priority || (skip >> b & 1)) {
+				continue;
+			}
+			int pixel = 0;
+			if (mode == 0 || (mode == 1 && b < 2)) {
+				pixel = ef_text_pixel(r, bg, x, y);
+			} else if ((mode == 1 && b == 2) || (mode == 2 && b >= 2)) {
+				pixel = ef_affine_pixel(r, bg, x);
+			}
+			if (!pixel) {
+				continue;
+			}
+			if (!index) {
+				index = pixel;
+				top_layer = b;
+			} else {
+				under = pixel;
+				under_layer = b;
+				found_under = true;
+			}
+		}
+	}
+	if (!index && ef_grid.void_black && (x < 0 || x >= GBA_VIDEO_HORIZONTAL_PIXELS)) {
+		return 0;
+	}
+	if (r->blendEffect == BLEND_ALPHA && ef_is_target(r, top_layer, true) && ef_is_target(r, under_layer, false)) {
+		return mColorMix5Bit(r->blda, palette[index], r->bldb, palette[under]);
+	}
+	return palette[index];
+}
+
+// Does this line show the new columns? With maps no wider than 256 they would only repeat the far
+// side of the screen.
+static bool ef_line_wide(const struct GBAVideoSoftwareRenderer* r) {
+	int mode = GBARegisterDISPCNTGetMode(r->dispcnt);
+	bool wider_map = ef_grid.on && (ef_grid_bg[0].locked || ef_grid_bg[1].locked || ef_grid_bg[2].locked || ef_grid_bg[3].locked);
+	for (int i = 0; i < 4; ++i) {
+		const struct GBAVideoSoftwareBackground* bg = &r->bg[i];
+		if (!ef_grid.on && bg->enabled && ((mode == 0 && (bg->size & 1)) || (mode == 1 && ((i < 2 && (bg->size & 1)) || i == 2)) || (mode == 2 && i >= 2))) {
+			wider_map = true;
+		}
+	}
+	return ef_scene_wide && mode <= 2 && wider_map && !GBARegisterDISPCNTIsForcedBlank(r->dispcnt) && !(ef_scroll_gate && ef_scene_travel < ef_ext + 16);
+}
+
+// Before each frame. A wide scene can drop out for a frame or two while a reader finds its place, and a
+// meter should not jump for that. Changing over redraws every line, since lines are only redrawn when dirty.
+static void ef_hud_frame(struct GBAVideoSoftwareRenderer* r) {
+	if (!ef_hud_count) {
+		return;
+	}
+	bool wide = ef_ext && ef_line_wide(r);
+	ef_hud_narrow_frames = wide ? 0 : ef_hud_narrow_frames + 1;
+	bool live = wide || (ef_hud_live && ef_hud_narrow_frames <= 8);
+	if (live != ef_hud_live) {
+		ef_hud_live = live;
+		r->oamDirty = 1;
+		memset(r->scanlineDirty, 0xFFFFFFFF, sizeof(r->scanlineDirty));
+	}
+	if (!live || GBARegisterDISPCNTIsForcedBlank(r->dispcnt)) {
+		memset(ef_hud_row, 0, sizeof(ef_hud_row));
+	}
+}
+
+// Moving sprites leave the list the original picture is drawn from.
+static void ef_hud_filter(struct GBAVideoSoftwareRenderer* r) {
+	if (!ef_hud_live) {
+		return;
+	}
+	int kept = 0;
+	for (int i = 0; i < r->oamMax; ++i) {
+		if (!ef_hud_direction(&r->sprites[i].obj)) {
+			r->sprites[kept++] = r->sprites[i];
+		}
+	}
+	r->oamMax = kept;
+}
+
+static void ef_hud_line(const struct GBAVideoSoftwareRenderer* r, int y, int width) {
+	ef_hud_row[y] = false;
+	if (!ef_hud_live) {
+		return;
+	}
+	uint8_t* mask = ef_hud_mask + y * EF_WIDE_WIDTH;
+	mColor* out = ef_hud_pixel + y * EF_WIDE_WIDTH;
+	const mColor* palette = r->blendEffect == BLEND_BRIGHTEN || r->blendEffect == BLEND_DARKEN ? r->variantPalette : r->normalPalette;
+	memset(mask, 0, width);
+	bool used = false;
+	static int16_t whole_color[EF_WIDE_WIDTH];
+	static int8_t whole_priority[EF_WIDE_WIDTH];
+	bool have_whole = false;
+	for (int i = 0; i < ef_hud_count; ++i) {
+		const struct EfHudRule* rule = &ef_hud_rules[i];
+		if (rule->layer == EF_HUD_OBJ || y < rule->y0 || y > rule->y1 || !r->bg[rule->layer].enabled) {
+			continue;
+		}
+		const struct GBAVideoSoftwareBackground* bg = &r->bg[rule->layer];
+		for (int x = rule->x0; x <= rule->x1; ++x) {
+			int localX = x + bg->x, localY = y + bg->y;
+			uint16_t entry = ef_ring_entry(r, bg, localX, localY);
+			int tile = entry & 0x3FF;
+			if (tile < rule->t0 || tile > rule->t1) {
+				continue;
+			}
+			int pixel = ef_entry_pixel(r, bg, entry, localX, localY);
+			if (!pixel) {
+				continue;
+			}
+			if (!have_whole) {
+				memset(whole_color, 0, width * sizeof(int16_t));
+				if (GBARegisterDISPCNTIsObjEnable(r->dispcnt)) {
+					ef_sprites(r, y, whole_color, whole_priority, width, EF_SPRITES_WHOLE);
+				}
+				have_whole = true;
+			}
+			int sx = x + ef_ext;
+			if (!mask[sx]) {
+				out[sx] = ef_compose_pixel(r, x, y, whole_color, whole_priority, ef_skip_layers | 1U << rule->layer);
+				mask[sx] = 1;
+			}
+			used = true;
+		}
+	}
+	// A second pass, so a moved meter is not covered by the place another one left.
+	for (int i = 0; i < ef_hud_count; ++i) {
+		const struct EfHudRule* rule = &ef_hud_rules[i];
+		if (rule->layer == EF_HUD_OBJ || y < rule->y0 || y > rule->y1 || !r->bg[rule->layer].enabled) {
+			continue;
+		}
+		const struct GBAVideoSoftwareBackground* bg = &r->bg[rule->layer];
+		for (int x = rule->x0; x <= rule->x1; ++x) {
+			int localX = x + bg->x, localY = y + bg->y;
+			uint16_t entry = ef_ring_entry(r, bg, localX, localY);
+			int tile = entry & 0x3FF;
+			if (tile < rule->t0 || tile > rule->t1) {
+				continue;
+			}
+			int pixel = ef_entry_pixel(r, bg, entry, localX, localY);
+			int sx = x + ef_ext + rule->dir * ef_ext;
+			if (pixel && sx >= 0 && sx < width) {
+				out[sx] = palette[pixel];
+				mask[sx] = 1;
+			}
+		}
+	}
+	if (GBARegisterDISPCNTIsObjEnable(r->dispcnt)) {
+		static int16_t hud_color[EF_WIDE_WIDTH];
+		static int8_t hud_priority[EF_WIDE_WIDTH];
+		memset(hud_color, 0, width * sizeof(int16_t));
+		ef_sprites(r, y, hud_color, hud_priority, width, EF_SPRITES_HUD);
+		for (int sx = 0; sx < width; ++sx) {
+			if (hud_color[sx]) {
+				out[sx] = palette[256 + hud_color[sx]];
+				mask[sx] = 1;
+				used = true;
+			}
+		}
+	}
+	ef_hud_row[y] = used;
+}
+
+static void ef_wide_line(struct GBAVideoSoftwareRenderer* r, int y) {
+	if (!ef_ext) {
+		return;
+	}
+	if (y == 0 && ef_grid.on) {
+		ef_grid_frame(r);
+	}
+	if (y == 0 && ef_scroll_gate) {
+		ef_gate_frame(r);
+	}
+	int width = GBA_VIDEO_HORIZONTAL_PIXELS + 2 * ef_ext;
+	mColor* out = ef_fb + y * width;
+	if (ef_hud_count) {
+		ef_hud_line(r, y, width);
+	}
+	if (!ef_line_wide(r)) {
+		for (int i = 0; i < ef_ext; ++i) {
+			out[i] = out[ef_ext + GBA_VIDEO_HORIZONTAL_PIXELS + i] = 0;
+		}
+		return;
+	}
+	static int16_t sprite_color[EF_WIDE_WIDTH];
+	static int8_t sprite_priority[EF_WIDE_WIDTH];
+	memset(sprite_color, 0, width * sizeof(int16_t));
+	if (GBARegisterDISPCNTIsObjEnable(r->dispcnt)) {
+		ef_sprites(r, y, sprite_color, sprite_priority, width, EF_SPRITES_SIDES);
+	}
+	for (int side = 0; side < 2; ++side) {
+		for (int i = 0; i < ef_ext; ++i) {
+			int x = side ? GBA_VIDEO_HORIZONTAL_PIXELS + i : i - ef_ext;
+			out[x + ef_ext] = ef_compose_pixel(r, x, y, sprite_color, sprite_priority, ef_skip_layers);
+		}
+	}
+}
