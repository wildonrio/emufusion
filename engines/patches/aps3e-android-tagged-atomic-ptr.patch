 using llong  = long long;
 
 using uptr = std::uintptr_t;
+
+#if defined(__ANDROID__) && UINTPTR_MAX == UINT64_MAX
+namespace utils::android_tagged_ptr
+{
+	// Android arm64 malloc pointers use the top byte as an allocator tag. The
+	// RPCS3 lock-free layouts retain their original low 16 metadata bits, so
+	// the packed form is: [8-bit tag][40-bit heap VA][16-bit metadata].
+	constexpr uptr tag_mask = 0xff00000000000000ull;
+	constexpr uptr middle_address_mask = 0x00ffff0000000000ull;
+	constexpr uptr low_address_mask = 0x000000ffffffffffull;
+	constexpr uint metadata_bits = 16;
+
+	constexpr bool can_pack(uptr raw) noexcept
+	{
+		return !(raw & middle_address_mask);
+	}
 
+	constexpr uptr pack(uptr raw) noexcept
+	{
+		return (raw & tag_mask) | ((raw & low_address_mask) << metadata_bits);
+	}
+
+	constexpr uptr unpack(uptr packed) noexcept
+	{
+		return (packed & tag_mask) | ((packed >> metadata_bits) & low_address_mask);
+	}
+}
+#endif
