+float g_emufusion_keep_2d_scale = 1.0f;
+float g_emufusion_picture_width = 1.0f;
+
+void GSRendererHW::EmufusionPlaceDraw()
+{
+	const float scale = g_emufusion_keep_2d_scale;
+	if (scale >= 1.0f)
+		return;
+
+	const GSVector2i resolution = PCRTCDisplays.GetResolution();
+	// A narrower target is a texture or a reduced copy being drawn, not the picture.
+	if (m_cached_ctx.FRAME.FBW * 64 < static_cast<u32>(resolution.x))
+		return;
+
+	const bool looks_3d = m_vt.m_primclass == GS_TRIANGLE_CLASS &&
+		(!m_vt.m_eq.z || (PRIM->TME && !PRIM->FST && !m_vt.m_eq.q));
+	if (looks_3d)
+	{
+		if (++m_emufusion_3d_draws >= EMUFUSION_3D_DRAWS)
+			m_emufusion_scene_3d = true;
+		return;
+	}
+
+	m_emufusion_other_draws++;
+	if (!m_emufusion_scene_3d)
+		return;
+
+	// A pass over most of the screen is a fade or a screen effect, often in many strips: it covers the
+	// picture as it is. A status display in one draw may span the screen but leaves most of it alone.
+	const GSVertex* const vertices = m_vertex->buff;
+	const u16* const indices = m_index->buff;
+	s64 area = 0;
+	if (m_vt.m_primclass == GS_SPRITE_CLASS)
+	{
+		for (u32 i = 0; i + 1 < m_index->tail; i += 2)
+		{
+			const GSVertex& a = vertices[indices[i]];
+			const GSVertex& b = vertices[indices[i + 1]];
+			area += static_cast<s64>(std::abs(a.XYZ.X - b.XYZ.X)) * std::abs(a.XYZ.Y - b.XYZ.Y);
+		}
+	}
+	else if (m_vt.m_primclass == GS_TRIANGLE_CLASS)
+	{
+		for (u32 i = 0; i + 2 < m_index->tail; i += 3)
+		{
+			const GSVertex& a = vertices[indices[i]];
+			const GSVertex& b = vertices[indices[i + 1]];
+			const GSVertex& c = vertices[indices[i + 2]];
+			area += std::abs(static_cast<s64>(b.XYZ.X - a.XYZ.X) * (c.XYZ.Y - a.XYZ.Y) -
+							 static_cast<s64>(c.XYZ.X - a.XYZ.X) * (b.XYZ.Y - a.XYZ.Y)) / 2;
+		}
+	}
+	const s64 screen = static_cast<s64>(resolution.x) * resolution.y * 256;
+	if (area * 10 >= screen * 6)
+		return;
+
+	const int centre = m_context->XYOFFSET.OFX + resolution.x * 8;
+	for (u32 i = 0; i < m_vertex->tail; i++)
+	{
+		const int x = m_vertex->buff[i].XYZ.X;
+		m_vertex->buff[i].XYZ.X = static_cast<u16>(centre + static_cast<int>(static_cast<float>(x - centre) * scale));
+	}
+	const float middle = static_cast<float>(resolution.x) * 0.5f;
+	m_vt.m_min.p.x = middle + (m_vt.m_min.p.x - middle) * scale;
+	m_vt.m_max.p.x = middle + (m_vt.m_max.p.x - middle) * scale;
+}
+
+void GSRendererHW::EmufusionEndFrame()
+{
+	if (g_emufusion_keep_2d_scale >= 1.0f)
+	{
+		g_emufusion_picture_width = 1.0f;
+		return;
+	}
+	if (m_emufusion_3d_draws >= EMUFUSION_3D_DRAWS)
+	{
+		m_emufusion_frames_without_3d = 0;
+	}
+	else if (m_emufusion_other_draws > 0 && ++m_emufusion_frames_without_3d >= EMUFUSION_FRAMES_TO_2D)
+	{
+		// Only what was drawn counts: a picture left up while the game loads is still the same scene.
+		m_emufusion_scene_3d = false;
+	}
+	m_emufusion_3d_draws = 0;
+	m_emufusion_other_draws = 0;
+	g_emufusion_picture_width = m_emufusion_scene_3d ? 1.0f : g_emufusion_keep_2d_scale;
+}
