diff --git a/app/src/main/cpp/rpcs3/rpcs3/Emu/Cell/ppu_interpreter_mmio.h b/app/src/main/cpp/rpcs3/rpcs3/Emu/Cell/ppu_interpreter_mmio.h
new file mode 100644
--- /dev/null
+++ b/app/src/main/cpp/rpcs3/rpcs3/Emu/Cell/ppu_interpreter_mmio.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <bit>
+#include <type_traits>
+
+// Existing LLVM helpers accept/return memory-order bytes, not guest-order u32.
+u32 ppu_read_mmio_aware_u32(u8* vm_base, u32 eal);
+void ppu_write_mmio_aware_u32(u8* vm_base, u32 eal, u32 value);
+
+template <typename T>
+auto ppu_interpreter_read_value(u64 address)
+{
+    const u32 addr = vm::cast(address);
+    using value_type = std::remove_cvref_t<decltype(vm::_ref<T>(addr))>;
+#if defined(ARCH_ARM64)
+    if constexpr (sizeof(T) == sizeof(u32))
+    {
+        if (addr >= RAW_SPU_BASE_ADDR)
+        {
+            // ARM has no x86 fault-instruction MMIO emulation. Reuse LLVM's
+            // register validation and RawSPU local-store fallback explicitly.
+            return std::bit_cast<value_type>(ppu_read_mmio_aware_u32(vm::g_base_addr, addr));
+        }
+    }
+#endif
+    return value_type{vm::_ref<T>(addr)};
+}
+
+inline void ppu_interpreter_write32(ppu_thread& ppu, u32 addr, be_t<u32> value)
+{
+#if defined(ARCH_ARM64)
+    if (addr >= RAW_SPU_BASE_ADDR)
+    {
+        ppu_write_mmio_aware_u32(vm::g_base_addr, addr, std::bit_cast<u32>(value));
+        // Preserve the existing post-write memory-breakpoint check without
+        // performing a second store through the unmapped register address.
+        vm::write<void>(addr, value, &ppu);
+        return;
+    }
+#endif
+    vm::write32(addr, value, &ppu);
+}
