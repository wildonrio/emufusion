+bool Engine::saveEmuFusionExitAutosave(int &slot) {
+	slot = -1;
+	if (_autoSaving)
+		return false;
+
+	const int autoSaveSlot = getAutosaveSlot();
+	if (autoSaveSlot < 0 || !canSaveAutosaveCurrently())
+		return false;
 
+	// Exit must never display a modal overwrite prompt. If the engine's
+	// autosave slot contains a manual save, fail closed and keep playing.
+	const SaveStateDescriptor desc = getMetaEngine()->querySaveMetaInfos(
+		_targetName.c_str(), autoSaveSlot);
+	if (desc.isValid() && !desc.isAutosave())
+		return false;
+
+	_autoSaving = true;
+	const Common::Error result = saveGameState(
+		autoSaveSlot, Common::String("EmuFusion Quick Resume"), true);
+	_autoSaving = false;
+	_lastAutosaveTime = _system->getMillis();
+
+	if (result.getCode() != Common::kNoError)
+		return false;
+
+	slot = autoSaveSlot;
+	return true;
+}
