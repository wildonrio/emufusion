+enum EmuFusionExitAutosaveStatus {
+	EMUFUSION_EXIT_AUTOSAVE_IDLE = 0,
+	EMUFUSION_EXIT_AUTOSAVE_PENDING,
+	EMUFUSION_EXIT_AUTOSAVE_SUCCEEDED,
