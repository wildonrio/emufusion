+static volatile EmuFusionExitAutosaveStatus emufusion_exit_autosave_status = EMUFUSION_EXIT_AUTOSAVE_IDLE;
+static char emufusion_resume_marker_path[1024] = {0};
+
+static uint64 emufusion_fnv1a(const char *value) {
+	uint64 hash = UINT64_C(14695981039346656037);
+	for (const unsigned char *cursor = (const unsigned char *)value; cursor && *cursor; ++cursor) {
+		hash ^= *cursor;
+		hash *= UINT64_C(1099511628211);
+	}
+	return hash;
+}
+
+static void emufusion_set_resume_marker_path(const char *content_path) {
+	emufusion_resume_marker_path[0] = '\0';
+	const char *save_dir = retro_get_save_dir();
+	if (!save_dir || !*save_dir || !content_path || !*content_path)
+		return;
+	snprintf(emufusion_resume_marker_path, sizeof(emufusion_resume_marker_path),
+		"%s/.emufusion-scummvm-%016llx.resume", save_dir,
+		(unsigned long long)emufusion_fnv1a(content_path));
+}
+
+static int emufusion_read_resume_slot(void) {
+	if (!emufusion_resume_marker_path[0])
+		return -1;
+	RFILE *marker = filestream_open(emufusion_resume_marker_path,
+		RETRO_VFS_FILE_ACCESS_READ, RETRO_VFS_FILE_ACCESS_HINT_NONE);
+	if (!marker)
+		return -1;
+	char value[16] = {0};
+	const int64_t count = filestream_read(marker, value, sizeof(value) - 1);
+	filestream_close(marker);
+	if (count <= 0)
+		return -1;
+	char *end = nullptr;
+	const long slot = strtol(value, &end, 10);
+	return end != value && slot >= 0 && slot <= 999 ? (int)slot : -1;
+}
+
+static bool emufusion_write_resume_slot(int slot) {
+	if (!emufusion_resume_marker_path[0] || slot < 0 || slot > 999)
+		return false;
+	RFILE *marker = filestream_open(emufusion_resume_marker_path,
+		RETRO_VFS_FILE_ACCESS_WRITE, RETRO_VFS_FILE_ACCESS_HINT_NONE);
+	if (!marker)
+		return false;
+	char value[16] = {0};
+	const int length = snprintf(value, sizeof(value), "%d\n", slot);
+	const int64_t count = filestream_write(marker, value, length);
+	filestream_flush(marker);
+	filestream_close(marker);
+	return count == length;
+}
+
+bool emufusion_scummvm_exit_autosave_requested(void) {
+	return emufusion_exit_autosave_status == EMUFUSION_EXIT_AUTOSAVE_PENDING;
+}
+
+bool emufusion_scummvm_exit_autosave_canceled(void) {
+	return emufusion_exit_autosave_status == EMUFUSION_EXIT_AUTOSAVE_CANCELED;
+}
+
+void emufusion_scummvm_exit_autosave_completed(bool success, int slot) {
+	if (success && !emufusion_write_resume_slot(slot))
+		success = false;
+	emufusion_exit_autosave_status = success ? EMUFUSION_EXIT_AUTOSAVE_SUCCEEDED : EMUFUSION_EXIT_AUTOSAVE_FAILED;
+}
+
+bool retro_emufusion_prepare_exit_autosave(void) {
+	if (!retro_emu_thread_started() || retro_emu_thread_exited())
+		return false;
+	emufusion_exit_autosave_status = EMUFUSION_EXIT_AUTOSAVE_PENDING;
+	LIBRETRO_G_SYSTEM->requestQuit();
+	for (int frames = 0; frames < 120 &&
+			emufusion_exit_autosave_status == EMUFUSION_EXIT_AUTOSAVE_PENDING &&
+			!retro_emu_thread_exited(); ++frames)
+		retro_switch_to_emu_thread();
+	if (emufusion_exit_autosave_status == EMUFUSION_EXIT_AUTOSAVE_PENDING)
+		emufusion_exit_autosave_status = EMUFUSION_EXIT_AUTOSAVE_CANCELED;
+	return emufusion_exit_autosave_status == EMUFUSION_EXIT_AUTOSAVE_SUCCEEDED;
+}
