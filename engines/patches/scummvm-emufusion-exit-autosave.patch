+extern "C" {
+#endif
+
+/**
+ * Request a synchronous engine-native autosave on the emulation thread.
+ * Returns false without unloading the game when saving is unsupported or
+ * unsafe at the current point.
+ */
+bool retro_emufusion_prepare_exit_autosave(void);
+
+/** Internal event-manager bridge; not called by the EmuFusion host. */
+bool emufusion_scummvm_exit_autosave_requested(void);
+bool emufusion_scummvm_exit_autosave_canceled(void);
+void emufusion_scummvm_exit_autosave_completed(bool success, int slot);
