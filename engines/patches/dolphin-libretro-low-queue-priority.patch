EmuFusion local patch (2026-10-23), never submitted upstream: host GPU
scheduling only, no change to emulated console behaviour. Dolphin asks for
low Vulkan queue global priority so the in-process frame generator presents
first on the shared GPU; default priority on refusal or with
setprop debug.emufusion.engine_queue_priority default.

--- a/Source/Core/VideoBackends/Vulkan/VulkanContext.cpp	2026-10-23 05:57:54
+++ b/Source/Core/VideoBackends/Vulkan/VulkanContext.cpp	2026-10-23 05:58:32
@@ -15,8 +15,38 @@
 #include "VideoCommon/DriverDetails.h"
 #include "VideoCommon/VideoCommon.h"
 
+#ifdef __ANDROID__
+#include <android/log.h>
+#include <sys/system_properties.h>
+#endif
+
 namespace Vulkan
 {
+// EmuFusion (2026-10-23, local patch, host GPU scheduling only): the
+// in-process frame generator presents from a high-priority GLES context on
+// the same GPU. Ask for low queue global priority (no privilege needed) so its
+// short per-output work runs ahead of the emulator's rendering; with nothing
+// else on the GPU the priority changes nothing. A driver refusal falls back to
+// the default. QA: setprop debug.emufusion.engine_queue_priority default.
+static bool EmuFusionLowQueuePriorityRequested()
+{
+#ifdef __ANDROID__
+  char value[PROP_VALUE_MAX] = {};
+  if (__system_property_get("debug.emufusion.engine_queue_priority", value) > 0 &&
+      std::strcmp(value, "default") == 0)
+    return false;
+#endif
+  return true;
+}
+
+static void EmuFusionLogQueuePriority(const char* text)
+{
+#ifdef __ANDROID__
+  __android_log_print(ANDROID_LOG_INFO, "EmuFusionDolphin", "Vulkan queue global priority %s",
+                      text);
+#endif
+}
