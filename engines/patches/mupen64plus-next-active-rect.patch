+// Optional EmuFusion final-video geometry. Render-thread only, queried after
+// retro_run. Keep black source pixels (including cutscene bands) inside the
+// copied VI rectangle; do not infer geometry from framebuffer colors.
+static u32 emufusionActiveRect[7] = {};
+extern "C" __attribute__((visibility("default")))
+bool retro_emufusion_get_hw_active_rect(u32 *out, unsigned count)
+{
+	if (out == nullptr || count != 7 || emufusionActiveRect[0] != 1)
+		return false;
+	std::memcpy(out, emufusionActiveRect, sizeof(emufusionActiveRect));
+	return true;
+}
+
+static void emufusionSetActiveRect(s32 x0, s32 y0, s32 x1, s32 y1,
+								u32 width, u32 height, bool invertY)
+{
+	emufusionActiveRect[0] = 0;
+	if (invertY) {
+		const s32 bottom = static_cast<s32>(height) - y1;
+		y1 = static_cast<s32>(height) - y0;
+		y0 = bottom;
+	}
+	if (x0 < 0 || y0 < 0 || x1 <= x0 || y1 <= y0 ||
+		static_cast<u32>(x1) > width || static_cast<u32>(y1) > height)
+		return;
+	emufusionActiveRect[1] = static_cast<u32>(x0);
+	emufusionActiveRect[2] = static_cast<u32>(y0);
+	emufusionActiveRect[3] = static_cast<u32>(x1 - x0);
+	emufusionActiveRect[4] = static_cast<u32>(y1 - y0);
+	emufusionActiveRect[5] = width;
+	emufusionActiveRect[6] = height;
+	emufusionActiveRect[0] = 1;
+}
