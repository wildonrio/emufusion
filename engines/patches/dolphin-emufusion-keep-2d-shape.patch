+// EmuFusion: the 3D is wider, the picture is shown wider, and 2D must keep its shape, so 2D is drawn
+// through a narrower viewport, which also clips what a game keeps just off its old screen. Two kinds
+// of 2D are the picture itself rather than something on it, and keep their width: a draw from a copy
+// of the frame (a blur, a glow, the frame going through an effect), and in a 3D frame an untextured
+// draw across the whole screen (a fade or letterbox bars), which has no picture to stretch. Anything
+// textured from the game's own art, panels and text included, is narrowed. A frame with no 3D is a 2D
+// screen and keeps its shape, with bars.
+bool VertexManagerBase::EmufusionBatchCoversScreen() const
+{
+  const NativeVertexFormat* format = VertexLoaderManager::GetCurrentVertexFormat();
+  const PortableVertexDeclaration& declaration = format->GetVertexDeclaration();
+  const u32 stride = declaration.stride;
+  const u32 vertices = m_index_generator.GetNumVerts();
+  if (!declaration.position.enable || vertices > 4096 || stride == 0)
+    return false;
+  const auto& projection = xfmem.projection.rawProjection;
+  float low = 1e9f, high = -1e9f;
+  for (u32 i = 0; i < vertices; i++)
+  {
+    const u8* vertex = m_base_buffer_pointer + i * stride;
+    float position[3] = {};
+    std::memcpy(position, vertex + declaration.position.offset,
+                sizeof(float) * std::min<u32>(declaration.position.components, 3));
+    const u32 index = declaration.posmtx.enable ? vertex[declaration.posmtx.offset] :
+                                                  g_main_cp_state.matrix_index_a.PosNormalMtxIdx;
+    const float* matrix = &xfmem.posMatrices[(index & 0x3F) * 4];
+    const float x = matrix[0] * position[0] + matrix[1] * position[1] + matrix[2] * position[2] + matrix[3];
+    const float clip = projection[0] * x + projection[1];
+    low = std::min(low, clip);
+    high = std::max(high, clip);
+  }
+  return high - low >= 1.8f;
+}
+
+void VertexManagerBase::EmufusionPlace2D(bool textured, bool frame_copy)
+{
+  const float narrower = g_ActiveConfig.fEmufusion2DScale;
+  if (narrower >= 1.0f)
+    return;
+  float wanted = 1.0f;
+  if (xfmem.projection.type == ProjectionType::Perspective)
+    m_emufusion_saw_3d = true;
+  else if (!frame_copy && (textured || !m_emufusion_scene_3d || !EmufusionBatchCoversScreen()))
+    wanted = narrower;
+  auto& system = Core::System::GetInstance();
+  auto& shader_manager = system.GetVertexShaderManager();
+  if (shader_manager.emufusion_2d_scale != wanted)
+  {
+    shader_manager.emufusion_2d_scale = wanted;
+    system.GetXFStateManager().SetViewportChanged();
+  }
+}
+
 auto VertexManagerBase::ResetFlushAspectRatioCount() -> FlushStatistics
 {
   const auto result = m_flush_statistics;
   m_flush_statistics = {};
+  m_emufusion_scene_3d = m_emufusion_saw_3d;
+  m_emufusion_saw_3d = false;
   return result;
 }
 
