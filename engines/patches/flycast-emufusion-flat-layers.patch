+// EmuFusion: with the widescreen hack the picture shows past the old screen's edges, and a fade, a
+// pause screen's dimming or a letterbox bar drawn across exactly the old width stopped there in a hard
+// edge. A flat layer, at one depth and one colour along each row, that spans the whole old width is
+// carried out to the new edges. It has no picture of its own, so nothing is stretched; textures, 3D
+// and colour that changes across the screen are left as the game drew them. Returns how many of the
+// polygons are 3D, their depth changing across them.
+static int emufusionWidenFlatLayers(std::vector<PolyParam>& polys, size_t from, rend_context& rc)
+{
+	const float width = (float)rc.globClip.x;
+	int threeD = 0;
+	for (size_t p = from; p < polys.size(); p++)
+	{
+		const PolyParam& pp = polys[p];
+		if (pp.count < 3 || pp.first + pp.count > rc.verts.size())
+			continue;
+		Vertex *begin = &rc.verts[pp.first];
+		Vertex *end = begin + pp.count;
+		bool flatDepth = true;
+		for (Vertex *v = begin; v != end && flatDepth; v++)
+			flatDepth = v->z == begin->z;
+		if (!flatDepth)
+		{
+			threeD++;
+			continue;
+		}
+		if (pp.pcw.Texture || pp.count > 64)
+			continue;
+		float left = begin->x;
+		float right = begin->x;
+		bool flat = true;
+		for (Vertex *v = begin; v != end && flat; v++)
+		{
+			flat = std::isfinite(v->x) && std::isfinite(v->y);
+			left = std::min(left, v->x);
+			right = std::max(right, v->x);
+			for (Vertex *w = begin; w != v && flat; w++)
+				if (std::fabs(w->y - v->y) < 0.5f)
+					flat = std::memcmp(w->col, v->col, sizeof(v->col)) == 0
+							&& std::memcmp(w->spc, v->spc, sizeof(v->spc)) == 0;
+		}
+		if (!flat || left > 1.f || right < width - 1.f)
+			continue;
+		// The scissor keeps the layer to the wide picture.
+		for (Vertex *v = begin; v != end; v++)
+		{
+			if (v->x <= left + 0.5f)
+				v->x = -width;
+			else if (v->x >= right - 0.5f)
+				v->x = 2.f * width;
+		}
+	}
+	return threeD;
+}
