diff --git a/Core/ef_wide.h b/Core/ef_wide.h
new file mode 100644
index 0000000..f345e5f
--- /dev/null
+++ b/Core/ef_wide.h
@@ -0,0 +1,19 @@
+#ifndef EF_WIDE_H_
+#define EF_WIDE_H_
+// EmuFusion Widescreen Hack. The background map is 256 pixels wide and the handheld shows 160
+// of them. SameBoy's renderer draws those 160 as before; ef_wide_line then draws the new columns
+// beside them from the same state, once the line has finished, so timing does not change.
+// The picture stops at 248: a ring of exactly 256 shows one column at both ends past that, and one
+// is wrong. Pixels stay square, so widening adds columns and never stretches.
+#include <stdint.h>
+#define EF_WIDE_MAX_EXT 44
+#define EF_WIDE_WIDTH (160 + 2 * EF_WIDE_MAX_EXT)
+void ef_wide_set_aspect(const char *value);
+void ef_wide_set_scene(const char *value);
+void ef_wide_set_map(const char *value);
+void ef_wide_set_gate(const char *value);
+void ef_wide_set_band(const char *value);
+int ef_wide_ext(void);
+int ef_wide_milli(void);
+const uint32_t *ef_wide_compose(const uint32_t *picture);
+#endif
diff --git a/Core/ef_wide.inc b/Core/ef_wide.inc
new file mode 100644
index 0000000..e941551
--- /dev/null
+++ b/Core/ef_wide.inc
@@ -0,0 +1,338 @@
+#include <stdio.h>
+// Included at the end of display.c.
+#include "ef_wide.h"
+static uint32_t ef_fb[EF_WIDE_WIDTH * LINES];
+static int ef_ext, ef_milli;
+static uint8_t ef_scene_wide = 1;
+
+#define EF_MAX_TERMS 32
+typedef struct { int group; uint16_t addr; uint8_t mask, value, negate; } ef_term;
+static ef_term ef_terms[EF_MAX_TERMS];
+static int ef_term_count;
+
+void ef_wide_set_aspect(const char *value)
+{
+    ef_milli = value ? atoi(value) : 0;
+    int ext = ef_milli > 1000 ? (ef_milli * LINES / 1000 - 160) / 2 : 0;
+    ef_ext = ext < 0 ? 0 : ext > EF_WIDE_MAX_EXT ? EF_WIDE_MAX_EXT : ext;
+}
+
+int ef_wide_ext(void) { return ef_ext; }
+int ef_wide_milli(void) { return ef_milli; }
+
+// When to widen: OR of AND terms of memory tests, "C0A0=01,C0A1!=02|D000/F0=10".
+void ef_wide_set_scene(const char *value)
+{
+    ef_term_count = 0;
+    ef_scene_wide = 1;
+    if (!value) return;
+    int group = 0;
+    const char *cursor = value;
+    while (*cursor && ef_term_count < EF_MAX_TERMS) {
+        char text[32] = {0};
+        size_t length = strcspn(cursor, ",|");
+        if (length && length < sizeof(text)) {
+            memcpy(text, cursor, length);
+            const char *equals = strchr(text, '=');
+            if (equals && equals != text) {
+                ef_term *term = ef_terms + ef_term_count++;
+                char *end;
+                term->group = group;
+                term->negate = equals[-1] == '!';
+                term->addr = strtoul(text, &end, 16);
+                term->mask = *end == '/' ? strtoul(end + 1, NULL, 16) : 0xFF;
+                term->value = strtoul(equals + 1, NULL, 16);
+            }
+        }
+        if (cursor[length] == '|') group++;
+        cursor += length + (cursor[length] ? 1 : 0);
+    }
+}
+
+static void ef_evaluate_scene(GB_gameboy_t *gb)
+{
+    if (!ef_term_count) {
+        ef_scene_wide = 1;
+        return;
+    }
+    uint8_t any = 0;
+    for (int index = 0; index < ef_term_count && !any;) {
+        int group = ef_terms[index].group;
+        uint8_t all = 1;
+        for (; index < ef_term_count && ef_terms[index].group == group; index++) {
+            ef_term *term = ef_terms + index;
+            all = all && (((GB_safe_read_memory(gb, term->addr) & term->mask) == term->value) != term->negate);
+        }
+        any = all;
+    }
+    ef_scene_wide = any;
+}
+
+// A map reader fetches each new column from the game's own map, so a room's far side is right even
+// though the game has not loaded it into video memory.
+typedef struct {
+    uint16_t map, x, y, width, height, bank, list, palettes;
+} ef_map_layout;
+static const ef_map_layout ef_pokemon1 = {0xC6E8, 0xD362, 0xD361, 0xD369, 0xD368, 0xD52B, 0xD52C, 0};
+// Pokemon Yellow keeps the same variables one byte lower than Red and Blue.
+static const ef_map_layout ef_pokemon1y = {0xC6E8, 0xD361, 0xD360, 0xD368, 0xD367, 0xD52A, 0xD52B, 0};
+// Gold and Silver: also a colour for each tile, four bits in a list in ROM bank 2.
+static const ef_map_layout ef_pokemon2 = {0xC700, 0xDA03, 0xDA02, 0xD088, 0xD087, 0xD0C5, 0xD0C6, 0xD0CF};
+static const ef_map_layout *ef_map;
+// Wario Land II and 3: the level is in a battery RAM bank, a byte for each 16-pixel block, 256 to a row.
+// A block's four tiles are in a list in work RAM, and their colours in a list in another work RAM bank.
+typedef struct { uint8_t battery_bank; uint16_t rows, tiles; uint32_t colors; } ef_block_layout;
+static const ef_block_layout ef_wl2 = {1, 32, 0xC400, 0x4400};
+static const ef_block_layout ef_wl3 = {2, 32, 0xC600, 0x3300};
+static const ef_block_layout *ef_blocks;
+static int ef_turn_x, ef_turn_y;
+// For a game nobody has played through: a scene that has not scrolled is likely a menu, and its
+// map holds anything. The sides open once it has scrolled past the new columns, since until then the
+// ones behind it are the last scene's, and close when the screen goes off.
+static uint8_t ef_scroll_gate, ef_frames_without_lines, ef_last_scx;
+static int ef_scene_travel;
+static uint8_t ef_map_matches, ef_map_misses;
+static int ef_map_x, ef_map_y;
+
+void ef_wide_set_gate(const char *value)
+{
+    ef_scroll_gate = value && !strcmp(value, "scroll");
+    ef_scene_travel = 0;
+}
+
+void ef_wide_set_map(const char *value)
+{
+    ef_map = !value ? NULL : !strcmp(value, "pokemon1") ? &ef_pokemon1 :
+        !strcmp(value, "pokemon1y") ? &ef_pokemon1y : !strcmp(value, "pokemon2") ? &ef_pokemon2 : NULL;
+    ef_blocks = !value ? NULL : !strcmp(value, "wl2") ? &ef_wl2 : !strcmp(value, "wl3") ? &ef_wl3 : NULL;
+    ef_map_matches = ef_map_misses = 0;
+}
+
+// These variables stay in work RAM bank 1 whatever bank the game has switched to for the moment.
+static uint8_t ef_ram(GB_gameboy_t *gb, uint16_t address)
+{
+    return gb->ram[address >= 0xD000 ? 0x1000 + address - 0xD000 : address - 0xC000];
+}
+
+// Pokemon: the map sits in work RAM as 32-pixel blocks with a 3-block border holding the
+// neighbouring maps' edges; each block is 16 tiles from a list in the tileset's bank.
+static uint8_t ef_pokemon_tile(GB_gameboy_t *gb, int world_x, int world_y)
+{
+    int width = ef_ram(gb, ef_map->width), height = ef_ram(gb, ef_map->height);
+    int block_x = world_x >> 5, block_y = world_y >> 5;
+    block_x = block_x < -3 ? -3 : block_x > width + 2 ? width + 2 : block_x;
+    block_y = block_y < -3 ? -3 : block_y > height + 2 ? height + 2 : block_y;
+    uint8_t block = ef_ram(gb, ef_map->map + (block_y + 3) * (width + 6) + block_x + 3);
+    uint32_t list = ef_ram(gb, ef_map->list) | ef_ram(gb, ef_map->list + 1) << 8;
+    uint32_t address = ef_ram(gb, ef_map->bank) * 0x4000 + ((list - 0x4000) & 0x3FFF) + block * 16 + ((world_y >> 3) & 3) * 4 + ((world_x >> 3) & 3);
+    return address < gb->rom_size ? gb->rom[address] : 0;
+}
+
+static int ef_block_corner(GB_gameboy_t *gb, int world_x, int world_y)
+{
+    int column = world_x >> 4, row = world_y >> 4;
+    if (world_x < 0 || world_y < 0 || column > 255 || row >= ef_blocks->rows) return -1;
+    size_t at = ef_blocks->battery_bank * 0x2000 + row * 0x100 + column;
+    if (at >= gb->mbc_ram_size) return -1;
+    // The game's own sum loses a block number's top bit, which marks things like hidden coins.
+    return (gb->mbc_ram[at] & 0x7F) * 4 + ((world_y >> 3) & 1) * 2 + ((world_x >> 3) & 1);
+}
+
+static uint8_t ef_map_tile(GB_gameboy_t *gb, int world_x, int world_y)
+{
+    if (!ef_blocks) return ef_pokemon_tile(gb, world_x, world_y);
+    int corner = ef_block_corner(gb, world_x, world_y);
+    return corner < 0 ? 0 : gb->ram[ef_blocks->tiles - 0xC000 + corner];
+}
+
+// How well a camera position explains the middle of the real picture, out of 40.
+static int ef_map_score(GB_gameboy_t *gb, int camera_x, int camera_y)
+{
+    uint8_t scx = gb->io_registers[GB_IO_SCX], scy = gb->io_registers[GB_IO_SCY];
+    uint16_t base = gb->io_registers[GB_IO_LCDC] & GB_LCDC_BG_MAP ? 0x1C00 : 0x1800;
+    int score = 0;
+    for (int y = 16; y < 96; y += 16) {
+        for (int x = 24; x < 136; x += 16) {
+            uint8_t ring_x = x + scx, ring_y = y + scy;
+            if (gb->vram[base + (ring_y >> 3) * 32 + (ring_x >> 3)] == ef_map_tile(gb, camera_x + x, camera_y + y)) score++;
+        }
+    }
+    return score;
+}
+
+// The player stands at a fixed place on screen, and the map scrolls 16 pixels a step. The game's
+// position changes when a step begins, so mid-step the picture is up to a step behind it. Rather
+// than track the walking direction, take the position that explains the picture.
+static void ef_map_frame(GB_gameboy_t *gb)
+{
+    int home_x = ef_ram(gb, ef_map->x) * 16 - 64;
+    int home_y = ef_ram(gb, ef_map->y) * 16 - 64;
+    int phase_x = gb->io_registers[GB_IO_SCX] & 15, phase_y = gb->io_registers[GB_IO_SCY] & 15;
+    int xs[3] = { home_x + phase_x, home_x + phase_x - 16, home_x + 16 };
+    int ys[3] = { home_y + phase_y, home_y + phase_y - 16, home_y + 16 };
+    int best = -1;
+    for (int j = 0; j < 3; j++) {
+        for (int i = 0; i < 3; i++) {
+            int score = ef_map_score(gb, xs[i], ys[j]);
+            if (score > best) { best = score; ef_map_x = xs[i]; ef_map_y = ys[j]; }
+        }
+    }
+    // A text box covers part of the picture; a full-screen menu covers it all. One odd frame is neither.
+    ef_map_misses = best * 10 >= 42 * 6 ? 0 : ef_map_misses + 1;
+    if (!ef_map_misses) ef_map_matches = 1;
+    else if (ef_map_misses >= 3) ef_map_matches = 0;
+}
+
+// The level and the video scroll differ only by whole turns of the 256-pixel ring.
+static void ef_blocks_frame(GB_gameboy_t *gb)
+{
+    uint8_t scx = gb->io_registers[GB_IO_SCX], scy = gb->io_registers[GB_IO_SCY];
+    int best = ef_map_score(gb, ef_turn_x * 256 + scx, ef_turn_y * 256 + scy);
+    if (best * 10 < 35 * 8) {
+        for (int y = 0; y * 256 < ef_blocks->rows * 16; y++) {
+            for (int x = 0; x < 16; x++) {
+                int score = ef_map_score(gb, x * 256 + scx, y * 256 + scy);
+                if (score > best) { best = score; ef_turn_x = x; ef_turn_y = y; }
+            }
+        }
+    }
+    ef_map_x = ef_turn_x * 256 + scx;
+    ef_map_y = ef_turn_y * 256 + scy;
+    ef_map_misses = best * 10 >= 35 * 6 ? 0 : ef_map_misses + 1;
+    if (!ef_map_misses) ef_map_matches = 1;
+    else if (ef_map_misses >= 3) ef_map_matches = 0;
+}
+
+static uint8_t ef_blocks_pixel(GB_gameboy_t *gb, int x, int line, uint8_t *attributes)
+{
+    int world_x = ef_map_x + x, world_y = ef_map_y + line;
+    int corner = ef_block_corner(gb, world_x, world_y);
+    if (corner < 0) return 0;
+    uint8_t tile = gb->ram[ef_blocks->tiles - 0xC000 + corner];
+    *attributes = gb->ram[ef_blocks->colors + corner];
+    uint16_t address = gb->io_registers[GB_IO_LCDC] & GB_LCDC_TILE_SEL ? tile * 16 : 0x1000 + (int8_t)tile * 16;
+    if (*attributes & 8) address += 0x2000;
+    uint8_t fine_y = *attributes & 0x40 ? 7 - (world_y & 7) : world_y & 7;
+    uint8_t bit = *attributes & 0x20 ? world_x & 7 : 7 - (world_x & 7);
+    return (gb->vram[address + fine_y * 2] >> bit & 1) | (gb->vram[address + fine_y * 2 + 1] >> bit & 1) << 1;
+}
+
+static uint8_t ef_map_pixel(GB_gameboy_t *gb, int x, int line, uint8_t *attributes)
+{
+    int world_x = ef_map_x + x, world_y = ef_map_y + line;
+    uint8_t tile = ef_pokemon_tile(gb, world_x, world_y);
+    uint16_t address = gb->io_registers[GB_IO_LCDC] & GB_LCDC_TILE_SEL ? tile * 16 : 0x1000 + (int8_t)tile * 16;
+    if (ef_map->palettes) {
+        // Tiles from 0x80 are the second video bank's; the text tiles between take no list entries.
+        uint32_t list = ef_ram(gb, ef_map->palettes) | ef_ram(gb, ef_map->palettes + 1) << 8;
+        uint8_t entry = tile >= 0x60 ? tile - 0x20 : tile;
+        uint8_t packed = gb->rom[0x8000 + ((list - 0x4000) & 0x3FFF) + entry / 2];
+        *attributes = (entry & 1 ? packed >> 4 : packed) & 15;
+        if (*attributes & 8) address += 0x2000;
+    }
+    int bit = 7 - (world_x & 7);
+    return (gb->vram[address + (world_y & 7) * 2] >> bit & 1) | (gb->vram[address + (world_y & 7) * 2 + 1] >> bit & 1) << 1;
+}
+
+// The background's colour number at screen column x of this line, with its attributes.
+static uint8_t ef_bg_pixel(GB_gameboy_t *gb, int x, uint8_t *attributes)
+{
+    uint8_t lcdc = gb->io_registers[GB_IO_LCDC];
+    *attributes = 0;
+    if (!gb->cgb_mode && !(lcdc & GB_LCDC_BG_EN)) return 0;
+    uint8_t scrolled_x = (uint8_t)(x + gb->io_registers[GB_IO_SCX]);
+    uint8_t y = gb->current_line + gb->io_registers[GB_IO_SCY];
+    uint16_t cell = (lcdc & GB_LCDC_BG_MAP ? 0x1C00 : 0x1800) + (y >> 3) * 32 + (scrolled_x >> 3);
+    uint8_t tile = gb->vram[cell];
+    if (gb->cgb_mode) *attributes = gb->vram[cell + 0x2000];
+    uint16_t address = lcdc & GB_LCDC_TILE_SEL ? tile * 16 : 0x1000 + (int8_t)tile * 16;
+    if (*attributes & 8) address += 0x2000;
+    uint8_t fine_y = *attributes & 0x40 ? 7 - (y & 7) : y & 7;
+    uint8_t fine_x = *attributes & 0x20 ? scrolled_x & 7 : 7 - (scrolled_x & 7);
+    return (gb->vram[address + fine_y * 2] >> fine_x & 1) | (gb->vram[address + fine_y * 2 + 1] >> fine_x & 1) << 1;
+}
+
+// The line just finished in the original columns: draw the new ones beside it.
+static int ef_band_first = 1000, ef_band_last = -1;
+
+void ef_wide_set_band(const char *value)
+{
+    if (!value || sscanf(value, "%d-%d", &ef_band_first, &ef_band_last) != 2) {
+        ef_band_first = 1000;
+        ef_band_last = -1;
+    }
+}
+
+static void ef_wide_line(GB_gameboy_t *gb)
+{
+    if (!ef_ext || gb->current_line >= LINES || gb->sgb) return;
+    if (gb->current_line == 0) {
+        ef_frames_without_lines = 0;
+        int step = (int8_t)(gb->io_registers[GB_IO_SCX] - ef_last_scx);
+        // A camera that jumps has cut to another scene; one that scrolls moves a few pixels.
+        ef_scene_travel = step < -24 || step > 24 ? 0 : ef_scene_travel + (step < 0 ? -step : step);
+        ef_last_scx = gb->io_registers[GB_IO_SCX];
+        ef_evaluate_scene(gb);
+        if (ef_blocks) ef_blocks_frame(gb);
+        else if (ef_map) ef_map_frame(gb);
+    }
+    uint8_t line = gb->current_line;
+    uint32_t *out = ef_fb + line * (160 + 2 * ef_ext);
+    uint8_t lcdc = gb->io_registers[GB_IO_LCDC];
+    uint32_t blank = gb->rgb_encode_callback ? gb->rgb_encode_callback(gb, 0, 0, 0) : 0;
+    if (!ef_scene_wide || !(lcdc & GB_LCDC_ENABLE) || ((ef_map || ef_blocks) && !ef_map_matches) ||
+        (ef_scroll_gate && ef_scene_travel < ef_ext + 16)) {
+        for (int i = 0; i < ef_ext; i++) out[i] = out[ef_ext + 160 + i] = blank;
+        return;
+    }
+    uint8_t bgp = gb->io_registers[GB_IO_BGP];
+    if (line >= ef_band_first && line <= ef_band_last) {
+        uint32_t plain = gb->cgb_mode ? gb->background_palettes_rgb[0] : gb->background_palettes_rgb[bgp & 3];
+        for (int i = 0; i < ef_ext; i++) out[i] = out[ef_ext + 160 + i] = plain;
+        return;
+    }
+    uint8_t window_line = (lcdc & GB_LCDC_WIN_ENABLE) && line >= gb->io_registers[GB_IO_WY] &&
+                          gb->io_registers[GB_IO_WX] < 167;
+    uint8_t height = lcdc & GB_LCDC_OBJ_SIZE ? 16 : 8;
+    for (int side = 0; side < 2; side++) {
+        // The window runs to the right edge, and from the left edge when it starts there. Its
+        // own map holds no more columns, so the bar carries on in the colour of its edge.
+        uint8_t covered = !ef_map && !ef_blocks && window_line && (side || gb->io_registers[GB_IO_WX] <= 7);
+        uint32_t edge = gb->screen ? gb->screen[line * 160 + (side ? 159 : 0)] : blank;
+        for (int i = 0; i < ef_ext; i++) {
+            int x = side ? 160 + i : i - ef_ext;
+            uint8_t attributes = 0, bg = covered ? 0 : ef_blocks ? ef_blocks_pixel(gb, x, line, &attributes) :
+                ef_map ? ef_map_pixel(gb, x, line, &attributes) : ef_bg_pixel(gb, x, &attributes);
+            uint32_t color = covered ? edge
+                : gb->cgb_mode ? gb->background_palettes_rgb[(attributes & 7) * 4 + bg]
+                : gb->background_palettes_rgb[bgp >> (bg * 2) & 3];
+            if ((lcdc & GB_LCDC_OBJ_EN) && !covered) {
+                for (int index = 0; index < 40; index++) {
+                    const uint8_t *object = gb->oam + index * 4;
+                    int top = object[0] - 16, left = object[1] - 8;
+                    if (line < top || line >= top + height || x < left || x >= left + 8) continue;
+                    uint8_t flags = object[3], row = line - top;
+                    if (flags & 0x40) row = height - 1 - row;
+                    uint8_t tile = height == 16 ? object[2] & 0xFE : object[2];
+                    uint16_t address = tile * 16 + row * 2 + (gb->cgb_mode && flags & 8 ? 0x2000 : 0);
+                    uint8_t bit = flags & 0x20 ? x - left : 7 - (x - left);
+                    uint8_t pixel = (gb->vram[address] >> bit & 1) | (gb->vram[address + 1] >> bit & 1) << 1;
+                    if (!pixel) continue;
+                    if ((flags & 0x80 || attributes & 0x80) && bg && (!gb->cgb_mode || (lcdc & GB_LCDC_BG_EN))) break;
+                    color = gb->cgb_mode ? gb->object_palettes_rgb[(flags & 7) * 4 + pixel]
+                        : gb->object_palettes_rgb[((flags & 0x10 ? 4 : 0)) + (gb->io_registers[flags & 0x10 ? GB_IO_OBP1 : GB_IO_OBP0] >> (pixel * 2) & 3)];
+                    break;
+                }
+            }
+            out[side ? ef_ext + 160 + i : i] = color;
+        }
+    }
+}
+
+const uint32_t *ef_wide_compose(const uint32_t *picture)
+{
+    if (++ef_frames_without_lines > 2) ef_scene_travel = 0;
+    int width = 160 + 2 * ef_ext;
+    for (int y = 0; y < LINES; y++) memcpy(ef_fb + y * width + ef_ext, picture + y * 160, 160 * sizeof(uint32_t));
+    return ef_fb;
+}
