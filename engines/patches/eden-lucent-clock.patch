+bool RendererVulkan::SetPresentationSuspended(bool suspended) {
+    std::scoped_lock lifecycle_lock{presentation_lifecycle_mutex};
+    if (!suspended) {
+        if (present_manager.HasPresentationFailure()) {
+            return false; // A failed renderer requires a fresh session.
+        }
+        // SurfaceChanged has published the replacement window before resume.
+        present_manager.RequestSurfaceRecreation();
+        presentation_suspended = false;
+        return true;
+    }
+    presentation_suspended = true;
+    // This runs on the GPU owner, not an arbitrary lifecycle thread: touching
+    // Scheduler's current chunk concurrently with GPU rendering is unsafe.
+    // WaitWorker must precede WaitPresent so deferred enqueue records land.
+    // Neither wait runs under submit_mutex (the workers need that lock).
+    scheduler.WaitWorker();
+    present_manager.WaitPresent();
+    std::scoped_lock submit_lock{scheduler.submit_mutex};
+    const VkResult result = device.GetLogical().WaitIdle();
+    if (result != VK_SUCCESS) {
+        present_manager.RecordPresentationFailure(result);
+    }
+    LOG_INFO(Render_Vulkan, "Lucent presentation suspended: owner/worker/present/GPU drained; failed={}",
+             present_manager.HasPresentationFailure());
+    return !present_manager.HasPresentationFailure();
+}
