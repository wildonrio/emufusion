{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildonrio.github.io/emufusion/engines/phase2-registry.schema.json",
  "title": "Lucent Phase 2 engine qualification registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "selectedFirstRunnable", "expectedSystems", "engines"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date" },
    "selectedFirstRunnable": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "expectedSystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/engine" }
    }
  },
  "$defs": {
    "nullableCommit": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "nullableUrl": {
      "oneOf": [
        { "type": "string", "pattern": "^https://" },
        { "type": "null" }
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "displayName", "systems", "route", "status", "statusReason",
        "selectedFirstRunnable", "source", "license", "android", "firmware",
        "state", "renderer", "legalTestContent", "build", "gates", "shipped"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "systems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "route": { "enum": ["libretro-core", "native-adapter", "benchmark-only"] },
        "status": { "enum": ["experimental", "source-blocked", "license-blocked"] },
        "statusReason": { "type": "string", "minLength": 1 },
        "selectedFirstRunnable": { "type": "boolean" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "repository", "commit", "archive", "archiveSha256", "verifiedAt", "submodules", "notes"],
          "properties": {
            "status": { "enum": ["pinned", "unavailable"] },
            "repository": { "type": "string", "pattern": "^https://" },
            "tag": { "type": "string", "minLength": 1 },
            "tagObject": { "$ref": "#/$defs/nullableCommit" },
            "commit": { "$ref": "#/$defs/nullableCommit" },
            "archive": { "$ref": "#/$defs/nullableUrl" },
            "archiveSha256": { "$ref": "#/$defs/nullableSha256" },
            "dependencyLock": { "type": "string", "minLength": 1 },
            "verifiedAt": { "type": "string", "format": "date" },
            "submodules": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "repository", "commit", "archiveSha256"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "repository": { "type": "string", "pattern": "^https://" },
                  "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "distributionGate", "dependencyAuditComplete", "evidence", "notes"],
          "properties": {
            "spdx": { "type": "string", "minLength": 1 },
            "distributionGate": { "enum": ["compatible-candidate", "audit-required", "blocked"] },
            "dependencyAuditComplete": { "type": "boolean" },
            "evidence": { "type": "string", "minLength": 1 },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": ["abis", "minApi", "integrationEvidence", "jit", "multiScreen", "notes"],
          "properties": {
            "abis": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"] }
            },
            "minApi": { "oneOf": [{ "type": "integer", "minimum": 21 }, { "type": "null" }] },
            "integrationEvidence": { "enum": ["source-present", "build-published", "build-reproduced", "unverified", "unsupported"] },
            "jit": { "type": "boolean" },
            "multiScreen": { "type": "boolean" },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "requiredForSystems", "acceptedHashes", "notes"],
          "properties": {
            "required": { "type": "boolean" },
            "requiredForSystems": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
            },
            "acceptedHashes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "qualified", "migrationQualified", "notes"],
          "properties": {
            "capability": { "enum": ["libretro-serialize", "native-save-state", "engine-saves-only", "unverified"] },
            "compatibilityVersion": { "type": "integer", "minimum": 1 },
            "qualified": { "const": false },
            "migrationQualified": { "const": false },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "qualified", "notes"],
          "properties": {
            "requested": { "enum": ["software", "opengl", "vulkan", "multi"] },
            "qualified": { "const": false },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "legalTestContent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sourceRepository", "sourceCommit", "sourcePath", "license", "artifactSha256", "notes"],
          "properties": {
            "status": { "enum": ["candidate", "blocked"] },
            "sourceRepository": { "$ref": "#/$defs/nullableUrl" },
            "sourceCommit": { "$ref": "#/$defs/nullableCommit" },
            "sourcePath": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "null" }
              ]
            },
            "license": { "type": "string", "minLength": 1 },
            "artifactSha256": { "$ref": "#/$defs/nullableSha256" },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recipe", "reproducible", "notes"],
          "properties": {
            "recipe": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "proofArtifactPath": { "type": "string", "minLength": 1 },
            "proofArtifactSha256": { "$ref": "#/$defs/nullableSha256" },
            "reproducible": { "const": false },
            "notes": { "type": "string", "minLength": 1 }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "license", "dependencies", "androidArm64", "firmware", "legalContent", "renderer", "state", "performance", "device"],
          "properties": {
            "source": { "type": "boolean" },
            "license": { "type": "boolean" },
            "dependencies": { "type": "boolean" },
            "androidArm64": { "type": "boolean" },
            "firmware": { "type": "boolean" },
            "legalContent": { "type": "boolean" },
            "renderer": { "type": "boolean" },
            "state": { "type": "boolean" },
            "performance": { "type": "boolean" },
            "device": { "type": "boolean" }
          }
        },
        "shipped": { "const": false }
      }
    }
  }
}
