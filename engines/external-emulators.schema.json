{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","generatedAt","packageIdsVerified","note","emulators","systems","unsupportedSystems"],
  "properties":{
    "$schema":{"type":"string"},"schemaVersion":{"const":1},"generatedAt":{"type":"string"},
    "packageIdsVerified":{"type":"boolean"},
    "note":{"type":"string","minLength":40},
    "emulators":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/emulator"}},
    "systems":{"type":"object","minProperties":1,
      "propertyNames":{"pattern":"^[a-z0-9]+$"},
      "additionalProperties":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/choice"}}},
    "unsupportedSystems":{"type":"array","items":{"type":"object","additionalProperties":false,
      "required":["system","reason"],
      "properties":{"system":{"type":"string","pattern":"^[a-z0-9]+$"},
        "reason":{"type":"string","minLength":10}}}}
  },
  "$defs":{
    "emulator":{"type":"object","additionalProperties":false,
      "required":["id","name","packages","install","verified"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "name":{"type":"string","minLength":1},
        "packages":{"type":"array","minItems":1,"uniqueItems":true,
          "items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"}},
        "install":{"type":"object","additionalProperties":false,"required":["kind","url"],
          "properties":{
            "kind":{"enum":["play","web"]},
            "url":{"type":"string","pattern":"^https://"}}},
        "verified":{"type":"boolean"}
      }},
    "choice":{"type":"object","additionalProperties":false,"required":["option"],
      "properties":{
        "option":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "app":{"type":"string","pattern":"^[a-z0-9-]+$"}}}
  }
}
