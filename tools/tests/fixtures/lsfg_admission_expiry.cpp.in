    CHECK(slot.sourceLeft == before.sourceLeft && slot.sourceRight == before.sourceRight);
    CHECK(slot.readySyncFd == before.readySyncFd && slot.proofTimestampSyncFd == before.proofTimestampSyncFd);
    CHECK(fdOpen(slot.readySyncFd) && fdOpen(slot.proofTimestampSyncFd));
