}
void jni_unknown_pair_status() {
    Fixture fixture; Host host(fixture); auto prepared = privateReady(fixture);
    auto request = valid(true); cachePair(host, prepared, request);
    fixture.live_[1].privatePairStatus = 0;
    const auto before = fixture.live_[1];
    CHECK(enqueue(host, request) == 0 && host.preparedGenerated);
    sameSlot(before, fixture.live_[1]); noAdmission(fixture);
}
void jni_queue_backpressure() {
    Fixture fixture; Host host(fixture); auto prepared = privateReady(fixture);
    auto request = valid(true); cachePair(host, prepared, request);
    host.droppedCompletions.resize(kSlotCount);
    const auto before = fixture.live_[1];
    CHECK(enqueue(host, request) == 0 && host.preparedGenerated);
    sameSlot(before, fixture.live_[1]); noAdmission(fixture);
}
void jni_endpoint_expiry() {
    Fixture fixture; Host host(fixture); auto request = valid();
    const auto prepared = privateReady(fixture); cacheRealPair(host, prepared, request);
    const auto before = fixture.live_[prepared.slotIndex];
    fakeNow = request.completionDeadlineNs;
    CHECK(enqueue(host, request) == 0); noAdmission(fixture);
    CHECK(host.preparedRealPair && !host.preparedGenerated);
    sameSlot(before, fixture.live_[prepared.slotIndex]);
}
void jni_endpoint_accept_once() {
    Fixture fixture; Host host(fixture); auto request = valid();
    fakeNow = request.completionDeadlineNs - 1;
    // A runtime real endpoint cannot start new GPU work inside the visible
    // deadline. It must activate the exact, already-private canonical pair.
    CHECK(enqueue(host, request) == 0); noAdmission(fixture);
    CHECK(host.readyDispatchCalls == 0);
    const auto prepared = privateReady(fixture); cacheRealPair(host, prepared, request);
    CHECK(enqueue(host, request) == 1);
    CHECK(host.readyDispatchCalls == 1);
    CHECK(fixture.pendingPresentations_ == 1 && fixture.deviceFunctions_.submitCalls == 0);
    sameRequest(fixture.live_[prepared.slotIndex].request, request);
    CHECK(!host.preparedRealPair && enqueue(host, request) == 0);
    CHECK(host.readyDispatchCalls == 1);
    CHECK(fixture.pendingPresentations_ == 1);
}
void post_submit_expiry() {
    Fixture fixture; auto request = valid(); fakeNow = request.completionDeadlineNs - 1;
    fixture.deviceFunctions_.advanceOnSubmit = 2;
    auto prepared = fixture.tryPrepare(request);
    CHECK(fakeNow > request.completionDeadlineNs && prepared);
    CHECK(fixture.live_[0].state == State::CopyQueued && fdOpen(prepared->inputReadySyncFd));
    CHECK(fixture.live_[0].sourceLeft != nullptr && fixture.live_[0].sourceRight != nullptr);
    fixture.presentPrepared(*prepared, prepared->inputReadySyncFd);
    CHECK(fixture.pendingPresentations_ == 1 && fixture.oldestPendingSurfacePresentId() == request.presentId);
}
void accepted_drop_retirement() {
    Fixture fixture; auto request = valid(); fakeNow = request.completionDeadlineNs - 1;
    fixture.deviceFunctions_.advanceOnSubmit = 2;
    auto prepared = fixture.tryPrepare(request); CHECK(prepared);
    fixture.presentPrepared(*prepared, prepared->inputReadySyncFd);
    auto& slot = fixture.live_[0]; const int fd = slot.readySyncFd;
    auto* sourceLeft = slot.sourceLeft; auto* sourceRight = slot.sourceRight;
    readyObservations[fd] = {false, 0, true};
    CHECK(!fixture.pollSurfaceSubmission());
    CHECK(slot.state == State::SurfaceDroppedAwaitingReady && !fixture.fatal_);
    CHECK(slot.sourceLeft == sourceLeft && slot.sourceRight == sourceRight && fdOpen(fd));
    CHECK(fixture.pendingPresentations_ == 1 && fixture.oldestPendingSurfacePresentId() == request.presentId);
    CHECK(!fixture.pollDroppedSurfacePresentation());
    CHECK(slot.state == State::SurfaceDroppedAwaitingReady && fdOpen(fd));
    fixture.deviceFunctions_.fenceStatuses[slot.copyFence] = VK_SUCCESS;
    CHECK(!fixture.pollDroppedSurfacePresentation());
    readyObservations[fd] = {true, fakeNow, true};
    auto drop = fixture.pollDroppedSurfacePresentation();
    CHECK(drop && drop->dropped && drop->presentId == request.presentId);
    CHECK(drop->actualPresentTimeNs == 0 && drop->pairStatus == 0);
    CHECK(drop->desiredPresentTimeNs == request.desiredPresentTimeNs);
    CHECK(slot.state == State::Idle && slot.sourceLeft == nullptr && slot.sourceRight == nullptr);
    CHECK(!fdOpen(fd) && fixture.pendingPresentations_ == 0 && fixture.surfaceCutoffRetired_ == 1);
    CHECK(!fixture.pollDroppedSurfacePresentation());
    CHECK(fixture.surfaceCutoffDrops_ == 1 && !fixture.fatal_);
}
void private_drop_waits_for_proof() {
    Fixture fixture; auto prepared = privateReady(fixture); auto request = valid(true);
    auto& slot = fixture.live_[1]; const int readyFd = slot.readySyncFd, proofFd = slot.proofTimestampSyncFd;
    CHECK(fixture.activatePrivatePrepared(prepared, request));
    fakeNow = request.completionDeadlineNs;
    fixture.deviceFunctions_.fenceStatuses[slot.copyFence] = VK_SUCCESS;
    readyObservations[readyFd] = {true, fakeNow - 1, true};
    CHECK(!fixture.pollSurfaceSubmission());
    CHECK(!fixture.pollDroppedSurfacePresentation());
    CHECK(slot.state == State::SurfaceDroppedAwaitingReady && fdOpen(readyFd) && fdOpen(proofFd));
    CHECK(fixture.pendingPresentations_ == 1);
    fixture.deviceFunctions_.fenceStatuses[slot.presentFence] = VK_SUCCESS;
    auto drop = fixture.pollDroppedSurfacePresentation();
    CHECK(drop && drop->dropped && drop->actualPresentTimeNs == 0);
    CHECK(!fdOpen(readyFd) && !fdOpen(proofFd) && slot.state == State::Idle);
    CHECK(fixture.pendingPresentations_ == 0);
}
void accepted_drop_timeout() {
    Fixture fixture; auto prepared = privateReady(fixture); auto request = valid(true);
    CHECK(fixture.activatePrivatePrepared(prepared, request));
    fakeNow = request.completionDeadlineNs;
    CHECK(!fixture.pollSurfaceSubmission());
    auto& slot = fixture.live_[1]; const auto before = slot;
    fakeNow += kDroppedDrainTimeoutNs;
    throws<std::runtime_error>([&] { fixture.pollDroppedSurfacePresentation(); });
    CHECK(fixture.fatal_ && fixture.pendingPresentations_ == 1 && fixture.surfaceCutoffRetired_ == 0);
    sameSlot(before, slot);
    CHECK(fdOpen(slot.readySyncFd) && fdOpen(slot.proofTimestampSyncFd));
}
void accepted_drop_fence_error() {
    Fixture fixture; auto prepared = privateReady(fixture); auto request = valid(true);
    CHECK(fixture.activatePrivatePrepared(prepared, request));
    fakeNow = request.completionDeadlineNs;
    CHECK(!fixture.pollSurfaceSubmission());
    auto& slot = fixture.live_[1]; fixture.deviceFunctions_.fenceStatuses[slot.copyFence] = -4;
    const auto before = slot;
    throws<std::runtime_error>([&] { fixture.pollDroppedSurfacePresentation(); });
    CHECK(fixture.fatal_ && fixture.pendingPresentations_ == 1 && fixture.surfaceCutoffRetired_ == 0);
    sameSlot(before, slot); CHECK(fdOpen(slot.readySyncFd));
}
void export_failure_owned() {
    Fixture fixture; auto request = valid(); fakeNow = request.completionDeadlineNs - 1;
    fixture.deviceFunctions_.failExport = true;
    throws<std::runtime_error>([&] { fixture.tryPrepare(request); });
    CHECK(fixture.fatal_ && fixture.live_[0].state == State::CopyQueued);
    CHECK(fixture.live_[0].sourceLeft != nullptr && fixture.live_[0].sourceRight != nullptr);
    CHECK(fixture.deviceFunctions_.submitCalls == 1 && fixture.deviceFunctions_.exportCalls == 1);
}

int main(int argc, char** argv) {
    const std::map<std::string, void(*)()> cases = {
        {"malformed_expired", malformed_expired}, {"entry_expired", entry_expired},
        {"retirement_expiry", retirement_expiry}, {"retirement_then_fresh", retirement_then_fresh},
        {"no_idle_slot", no_idle_slot}, {"pre_deadline_accept", pre_deadline_accept},
        {"private_expiry_preserves", private_expiry_preserves}, {"private_malformed_expired", private_malformed_expired},
        {"private_accept_once", private_accept_once}, {"jni_expiry_preserves", jni_expiry_preserves},
        {"jni_malformed_expired", jni_malformed_expired}, {"jni_pair_mismatch", jni_pair_mismatch},
        {"jni_sequence_boundary", jni_sequence_boundary},
        {"jni_unknown_pair_status", jni_unknown_pair_status}, {"jni_queue_backpressure", jni_queue_backpressure},
        {"jni_endpoint_expiry", jni_endpoint_expiry}, {"jni_endpoint_accept_once", jni_endpoint_accept_once},
        {"post_submit_expiry", post_submit_expiry}, {"accepted_drop_retirement", accepted_drop_retirement},
        {"private_drop_waits_for_proof", private_drop_waits_for_proof},
        {"accepted_drop_timeout", accepted_drop_timeout}, {"accepted_drop_fence_error", accepted_drop_fence_error},
        {"export_failure_owned", export_failure_owned},
    };
    try {
        CHECK(argc == 2);
        const auto found = cases.find(argv[1]); CHECK(found != cases.end());
        found->second();
        std::cout << "PASS " << argv[1] << '\n';
        return 0;
    } catch (const std::exception& error) {
        std::cerr << "FAIL: " << error.what() << '\n';
        return 1;
    }
}
