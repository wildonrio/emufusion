}
auto requestIdentity(const Request& request) {
    return std::tie(request.left, request.right, request.presentId,
        request.physicalPresentTimeNs, request.desiredPresentTimeNs,
        request.completionDeadlineNs, request.refreshDurationNs,
        request.compositorFrameTimelineVsyncId, request.compositorFrameTimelineExpectedNs,
        request.compositorFrameTimelineDeadlineNs, request.generated, request.presentRight,
        request.sessionEpoch, request.presentationEpoch, request.leftSequence, request.rightSequence,
        request.leftTimestampNs, request.rightTimestampNs, request.contentTimestampNs);
}
void sameRequest(const Request& a, const Request& b) { CHECK(requestIdentity(a) == requestIdentity(b)); }
void sameSlot(const Fixture::LiveSlot& a, const Fixture::LiveSlot& b) {
    sameRequest(a.request, b.request);
    CHECK(a.copyCommand == b.copyCommand && a.presentCommand == b.presentCommand);
    CHECK(a.copyFence == b.copyFence && a.presentFence == b.presentFence);
    CHECK(a.inputReady == b.inputReady && a.acquire == b.acquire && a.render == b.render);
    CHECK(a.sourceLeft == b.sourceLeft && a.sourceRight == b.sourceRight && a.state == b.state);
    CHECK(a.readySyncFd == b.readySyncFd && a.proofTimestampSyncFd == b.proofTimestampSyncFd);
    CHECK(a.gpuStartNs == b.gpuStartNs && a.gpuCompletionObservedNs == b.gpuCompletionObservedNs);
    CHECK(a.privatePairStatus == b.privatePairStatus && a.privateProofPrepared == b.privateProofPrepared);
    CHECK(a.cutoffObservedNs == b.cutoffObservedNs && a.cutoffDropOrdinal == b.cutoffDropOrdinal);
    CHECK(a.cutoffBranch == b.cutoffBranch && a.fullCaptureId == b.fullCaptureId);
}
void noAdmission(const Fixture& fixture) {
    CHECK(!fixture.fatal_ && fixture.nextLiveSlot_ == 0 && fixture.pendingPresentations_ == 0);
    CHECK(fixture.imports == 0 && fixture.recordCalls == 0);
    CHECK(fixture.deviceFunctions_.resetFenceCalls == 0 && fixture.deviceFunctions_.resetCommandCalls == 0);
    CHECK(fixture.deviceFunctions_.submitCalls == 0 && fixture.deviceFunctions_.exportCalls == 0);
}
template<class Exception = std::exception, class Function> void throws(Function function) {
    bool caught = false;
    try { function(); } catch (const Exception&) { caught = true; }
    CHECK(caught);
}
Prepared privateReady(Fixture& fixture, uint32_t index = 1) {
    auto& slot = fixture.live_.at(index);
    slot.state = State::PrivateReady;
    slot.request.left = &left;
    slot.request.right = &right;
    slot.request.generated = true;
    slot.sourceLeft = &fixture.images[0];
    slot.sourceRight = &fixture.images[1];
    fixture.images[0].buffer = &left;
    fixture.images[1].buffer = &right;
    slot.readySyncFd = ownedFd();
    slot.proofTimestampSyncFd = ownedFd();
    slot.privatePairStatus = 1;
    slot.privateProofPrepared = true;
    slot.gpuStartNs = 123;
    slot.gpuCompletionObservedNs = 456;
    return Prepared{index, -1};
}
void cachePair(Host& host, const Prepared& prepared, const Request& request) {
    host.preparedGenerated = PreparedGenerated{
        .left = request.left, .right = request.right,
        .sessionEpoch = request.sessionEpoch, .presentationEpoch = request.presentationEpoch,
        .leftSequence = request.leftSequence, .leftTimestampNs = request.leftTimestampNs,
        .rightSequence = request.rightSequence, .rightTimestampNs = request.rightTimestampNs,
        .presentationTimestampNs = request.contentTimestampNs, .prepared = prepared,
    };
}
void cacheRealPair(Host& host, const Prepared& prepared, const Request& request) {
    host.ownedVulkan->live_[prepared.slotIndex].request.generated = false;
    cachePair(host, prepared, request);
    host.preparedGenerated->presentationTimestampNs = request.leftTimestampNs;
    host.preparedRealPair = PreparedRealPair{*host.preparedGenerated};
    host.preparedGenerated.reset();
}
int enqueue(Host& host, const Request& request, int width = 320, int format = 1) {
    return Java_com_thorium_preview_game_NativeLsfgBridge_enqueue(nullptr, nullptr,
        reinterpret_cast<jlong>(&host), request.left, request.right,
        static_cast<jlong>(request.sessionEpoch), static_cast<jlong>(request.presentationEpoch),
        static_cast<jlong>(request.leftSequence), static_cast<jlong>(request.leftTimestampNs),
        static_cast<jlong>(request.rightSequence), static_cast<jlong>(request.rightTimestampNs),
        static_cast<jlong>(request.contentTimestampNs), static_cast<jlong>(request.physicalPresentTimeNs),
        static_cast<jlong>(request.desiredPresentTimeNs), static_cast<jlong>(request.completionDeadlineNs),
        static_cast<jlong>(request.compositorFrameTimelineVsyncId),
        static_cast<jlong>(request.compositorFrameTimelineExpectedNs),
        static_cast<jlong>(request.compositorFrameTimelineDeadlineNs), width, 240, format,
        static_cast<jlong>(request.presentId));
}
Request nextProposal(Request request) {
    // A new explicit proposal, not production mutation of the expired request.
    request.physicalPresentTimeNs += 100'000'000;
    request.desiredPresentTimeNs += 100'000'000;
    request.completionDeadlineNs += 100'000'000;
    request.compositorFrameTimelineExpectedNs += 100'000'000;
    request.compositorFrameTimelineDeadlineNs += 100'000'000;
    ++request.compositorFrameTimelineVsyncId;
    return request;
}

void malformed_expired() {
    std::vector<std::function<void(Request&)>> changes = {
        [](auto& r) { r.left = nullptr; }, [](auto& r) { r.right = nullptr; },
        [](auto& r) { r.presentId = 0; }, [](auto& r) { r.presentId = uint64_t{UINT32_MAX} + 1; },
        [](auto& r) { r.physicalPresentTimeNs = 0; }, [](auto& r) { r.desiredPresentTimeNs = 0; },
        [](auto& r) { r.completionDeadlineNs = 0; }, [](auto& r) { r.refreshDurationNs = 0; },
        [](auto& r) { r.completionDeadlineNs = r.desiredPresentTimeNs + 1; },
        [](auto& r) { r.desiredPresentTimeNs = r.physicalPresentTimeNs + 1; },
        [](auto& r) { r.compositorFrameTimelineVsyncId = 0; },
        [](auto& r) { r.compositorFrameTimelineExpectedNs = 0; },
        [](auto& r) { r.compositorFrameTimelineDeadlineNs = 0; },
    };
    for (const auto& change : changes) {
        Fixture fixture;
        auto request = valid(); change(request); fakeNow = UINT64_MAX;
        const auto before = fixture.live_;
        throws<std::invalid_argument>([&] { fixture.tryPrepare(request); });
        noAdmission(fixture);
        CHECK(clockReads == 0);
        for (size_t i = 0; i < before.size(); ++i) sameSlot(before[i], fixture.live_[i]);
    }
    for (int kind = 0; kind < 3; ++kind) {
        Fixture fixture;
        fakeNow = UINT64_MAX;
        if (kind == 0) fixture.fatal_ = true;
        if (kind == 1) fixture.capabilities_.liveResourcesReady = false;
        if (kind == 2) fixture.presentationEpoch_ = 0;
        throws([&] { fixture.tryPrepare(valid()); });
        CHECK(clockReads == 0 && fixture.deviceFunctions_.resetFenceCalls == 0);
    }
}
