void requireSuccess(VkResult result, const char* operation) {
    if (result != VK_SUCCESS) throw std::runtime_error(operation);
}
int ownedFd() {
    const int fd = ::open("/dev/null", O_RDONLY);
    CHECK(fd >= 0);
    return fd;
}
bool fdOpen(int fd) { return ::fcntl(fd, F_GETFD) >= 0; }
@READY_OBSERVATION@
std::map<int, ReadyFenceObservation> readyObservations;
ReadyFenceObservation observeReadyFence(int fd) {
    if (fd == -1) return {true, 0, true};
    if (fd < -1) throw std::runtime_error("invalid ready FD");
    CHECK(fdOpen(fd));
    auto found = readyObservations.find(fd);
    return found == readyObservations.end() ? ReadyFenceObservation{} : found->second;
}
@DRAIN_TIMEOUT@

struct FakeDeviceFunctions {
    uint64_t resetFenceCalls = 0;
    uint64_t resetCommandCalls = 0;
    uint64_t submitCalls = 0;
    uint64_t exportCalls = 0;
    uint64_t fenceQueries = 0;
    uint64_t advanceOnFenceQuery = 0;
    uint64_t advanceOnSubmit = 0;
    int exportedFd = -1;
    bool failExport = false;
    std::map<VkFence, VkResult> fenceStatuses;
    VkResult vkResetFences(int, uint32_t, const VkFence*) { ++resetFenceCalls; return VK_SUCCESS; }
    VkResult vkResetCommandBuffer(VkCommandBuffer, int) { ++resetCommandCalls; return VK_SUCCESS; }
    VkResult vkQueueSubmit(int, uint32_t count, const VkSubmitInfo* submit, VkFence) {
        CHECK(count == 1 && submit != nullptr);
        ++submitCalls;
        fakeNow += advanceOnSubmit;
        return VK_SUCCESS;
    }
    VkResult vkGetSemaphoreFdKHR(int, const VkSemaphoreGetFdInfoKHR*, int* fd) {
        ++exportCalls;
        if (failExport) return -4;
        exportedFd = ownedFd();
        *fd = exportedFd;
        return VK_SUCCESS;
    }
    VkResult vkGetFenceStatus(int, VkFence fence) {
        ++fenceQueries;
        fakeNow += advanceOnFenceQuery;
        auto found = fenceStatuses.find(fence);
        return found == fenceStatuses.end() ? VK_NOT_READY : found->second;
    }
};
struct FakeTripletWriter { void discard(uint64_t, const char*) {} };

class Fixture final {
public:
    @SLOT_COUNT@
    @DECLARATIONS@
