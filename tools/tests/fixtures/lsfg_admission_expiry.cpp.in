    uint64_t presentationEpoch_ = 1;
    uint32_t nextLiveSlot_ = 0;
    uint32_t inferenceSlot_ = UINT32_MAX;
    std::array<LiveSlot, kFixedSlotCount> live_{};
    FakeDeviceFunctions deviceFunctions_;
    int queue_ = 1;
    int device_ = 1;
    uint32_t pendingPresentations_ = 0;
    uint64_t surfaceCutoffDrops_ = 0;
    uint64_t surfaceCutoffRetired_ = 0;
    uint64_t imports = 0;
    uint64_t recordCalls = 0;
    uint64_t advanceOnRecord = 0;
    std::array<ImportedImage, 8> images{};
    std::vector<std::string> dropLogs;
    std::unique_ptr<FakeTripletWriter> tripletWriter_;

    Fixture() {
        fakeNow = 0;
        clockReads = 0;
        readyObservations.clear();
        for (uint32_t i = 0; i < live_.size(); ++i) {
            live_[i].copyFence = 100 + i * 2;
            live_[i].presentFence = 101 + i * 2;
            live_[i].copyCommand = 200 + i * 2;
            live_[i].presentCommand = 201 + i * 2;
            live_[i].inputReady = 300 + i;
        }
    }
    ~Fixture() {
        // Fixture-only cleanup happens after assertions; real tested retirement
        // uses the extracted resetLiveSlotStorage() and real POSIX close().
        for (auto& slot : live_) {
            if (slot.readySyncFd >= 0 && fdOpen(slot.readySyncFd)) ::close(slot.readySyncFd);
            if (slot.proofTimestampSyncFd >= 0 && fdOpen(slot.proofTimestampSyncFd)) ::close(slot.proofTimestampSyncFd);
        }
        const int fd = deviceFunctions_.exportedFd;
        if (fd >= 0 && fdOpen(fd)) ::close(fd);
    }
    ImportedImage& cachedSourceImage(AHardwareBuffer* buffer) {
        CHECK(buffer != nullptr);
        for (auto& image : images) if (image.buffer == buffer) return image;
        for (auto& image : images) if (image.buffer == nullptr) {
            ++imports;
            image.buffer = buffer;
            return image;
        }
        throw std::runtime_error("fixture import cache full");
    }
    void recordEndpointCopy(uint32_t index, LiveSlot& slot) {
        CHECK(index < kFixedSlotCount && slot.sourceLeft != nullptr && slot.sourceRight != nullptr);
        ++recordCalls;
        fakeNow += advanceOnRecord;
    }
    bool readyFdSignaled(LiveSlot& slot) { return observeReadyFence(slot.readySyncFd).ready; }
    void logSurfaceCutoffDrop(const LiveSlot&, const char* stage, uint64_t,
                              const DropDrainObservation&) { dropLogs.emplace_back(stage); }

    @METHODS@
};

