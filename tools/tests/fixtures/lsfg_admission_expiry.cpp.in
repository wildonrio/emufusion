using State = Fixture::LiveSlotState;
using Request = Fixture::LiveRequest;
using Prepared = Fixture::PreparedPresentation;
AHardwareBuffer left{1}, right{2}, other{3};
Request valid(bool generated = false) {
    return Request{
        .left = &left, .right = &right, .presentId = 7,
        .physicalPresentTimeNs = 60'000'000, .desiredPresentTimeNs = 55'000'000,
        .completionDeadlineNs = 50'000'000, .refreshDurationNs = 8'333'333,
        .compositorFrameTimelineVsyncId = 9,
        .compositorFrameTimelineExpectedNs = 60'000'000,
        .compositorFrameTimelineDeadlineNs = 49'666'667,
        .generated = generated, .presentRight = !generated,
        .sessionEpoch = 1, .presentationEpoch = 2,
        .leftSequence = 10, .rightSequence = 11,
        .leftTimestampNs = 100, .rightTimestampNs = 200,
        .contentTimestampNs = generated ? 150U : 200U,
