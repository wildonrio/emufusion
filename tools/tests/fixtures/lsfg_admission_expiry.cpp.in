void private_accept_once() {
    Fixture fixture; auto prepared = privateReady(fixture);
    auto request = valid(true); fakeNow = request.completionDeadlineNs;
    const auto before = fixture.live_[1];
    CHECK(!fixture.activatePrivatePrepared(prepared, request));
