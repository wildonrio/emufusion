 void Backend::onProcessLaunched()
 {
+#ifdef Q_OS_ANDROID
+    // Same lifecycle as EmuFusion's pinned ARM64 launch-subscriber patch:
+    // complete provider/launcher bookkeeping without destroying the QML scene
+    // or stopping gamepad input for the in-window engine.
+    m_api_public->onGameProcessFinished();
+    m_launcher->completeInWindowLaunch();
+#else
     m_frontend->teardown();
     m_api_private->gamepad().stop();
+#endif
 }
 
